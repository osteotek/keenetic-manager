# Maintainer: osteotek
pkgname=keenetic-policy
pkgver=1.1.2
pkgrel=1
pkgdesc='CLI for Keenetic client policies, Internet blocks, and Wake-on-LAN'
arch=('any')
url='https://github.com/osteotek/keenetic-policy'
license=('MIT')
depends=('bash' 'curl' 'jq' 'coreutils')
optdepends=('fzf: searchable interactive menus')
source=("$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('05c886cd0700676e4ce1b9aad7b6f07eae2c9ec3b8a4eba3567e55dfda1e4f90')

package() {
    cd "$srcdir/$pkgname-$pkgver"
    install -Dm755 keenetic-policy.sh "$pkgdir/usr/bin/keenetic-policy"
    install -Dm644 completions/keenetic-policy.bash \
        "$pkgdir/usr/share/bash-completion/completions/keenetic-policy"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 config.example "$pkgdir/usr/share/doc/$pkgname/config.example"
}
