# Maintainer: osteotek
pkgname=keenetic-manager
pkgver=1.2.0
pkgrel=1
pkgdesc='CLI for Keenetic router status, diagnostics, and client policies'
arch=('any')
url='https://github.com/osteotek/keenetic-manager'
license=('MIT')
depends=('bash' 'curl' 'jq' 'coreutils')
optdepends=('fzf: searchable interactive menus')
source=("$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('731d3daa1e89cd9caa4face156d6dcd429d7b7ceb9ef864520d0d112aa2d2915')

package() {
    cd "$srcdir/$pkgname-$pkgver"
    install -Dm755 keenetic "$pkgdir/usr/bin/keenetic"
    install -Dm644 completions/keenetic.bash \
        "$pkgdir/usr/share/bash-completion/completions/keenetic"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 config.example "$pkgdir/usr/share/doc/$pkgname/config.example"
}
