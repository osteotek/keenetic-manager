#compdef keenetic

# zsh completion for keenetic. Mirrors completions/keenetic.bash.

_keenetic_global_options=(
  '--router[Select a named router profile]:profile'
  '--ca-file[Trust this CA certificate for HTTPS]:file:_files'
  '--insecure[Disable HTTPS certificate verification]'
  '(-q --quiet)'{-q,--quiet}'[Suppress successful action output]'
  '(-v --verbose)'{-v,--verbose}'[Print connection diagnostics]'
  '--color=[Colors]:when:(auto always never)'
  '--no-color[Disable colors]'
  '(-h --help)'{-h,--help}'[Show command-specific help]'
  '(-V --version)'{-V,--version}'[Show version]'
)

_keenetic_watch_json=(
  '--json[Emit JSON]'
  '--watch[Refresh the view every N seconds]:seconds'
)

_keenetic_commands() {
  local -a commands=(
    'status:Router summary'
    'client:Devices: list, show, rename, wake, block, unblock, assign, nat'
    'policy:Connection policies: list, show, assign, block, unblock, undo'
    'interface:Interfaces: list, show, rates, up, down'
    'wifi:Wi-Fi: list, clients, scan, load'
    'vpn:WireGuard peers'
    'traffic:Top clients by recent traffic'
    'wan:Internet health, global connections, and DNS servers'
    'dhcp:DHCP leases and static reservations'
    'routes:IPv4 and IPv6 routes'
    'mesh:Mesh nodes and backhaul links'
    'nat:Active NAT connections'
    'forwards:Configured port-forwarding rules'
    'system:Health: show, changes, save, reboot'
    'logs:Recent router logs'
    'diagnose:Router-side ping/traceroute'
    'speedtest:Router-side iPerf3 test'
    'config:init or discover'
  )
  _describe -t commands 'keenetic command' commands
}

_keenetic() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    "${_keenetic_global_options[@]}" \
    '--init[Configure and test router credentials]' \
    '--discover[Probe the default gateway for Keenetic API access]' \
    '(-i --interactive)'{-i,--interactive}'[Pick a command from a menu]' \
    '--all[Include inactive interfaces]' \
    "${_keenetic_watch_json[@]}" \
    '1: :->command' \
    '*:: :->args' && return

  case $state in
    command) _keenetic_commands ;;
    args)
      case $line[1] in
        config)
          _arguments "${_keenetic_global_options[@]}" \
            '1: :((init\:"Create and test the configuration" discover\:"Probe the default gateway"))' ;;
        status)
          _arguments "${_keenetic_global_options[@]}" "${_keenetic_watch_json[@]}" '--all[Include inactive interfaces]' ;;
        policy|policies)
          _arguments "${_keenetic_global_options[@]}" "${_keenetic_watch_json[@]}" \
            '(-i --interactive)'{-i,--interactive}'[Select client and policy interactively]' \
            '*--client[Select by exact client name]:name' \
            '*--ip[Select by exact IP address]:address' \
            '*--mac[Select by exact MAC address]:mac' \
            '--policy[Apply policy ID or description]:policy' \
            '--block[Block Internet access]' \
            '--unblock[Remove Internet block]' \
            '--undo[Restore the most recent recorded change]' \
            '--dry-run[Preview without writing]' \
            '--all[Include offline clients]' \
            '--offline[Show only offline clients]' \
            '1: :((list\:"List policies" show\:"Show policy interfaces and clients" assign\:"Assign a policy to clients" block\:"Block Internet for clients" unblock\:"Unblock Internet for clients" undo\:"Restore a recorded change"))' \
            '*:: :_message "client name, IP, MAC, or policy"' ;;
        wake)
          _arguments "${_keenetic_global_options[@]}" \
            '*--client[Select by exact client name]:name' \
            '*--ip[Select by exact IP address]:address' \
            '*--mac[Select by exact MAC address]:mac' \
            '(-i --interactive)'{-i,--interactive}'[Pick one or more clients]' \
            '--dry-run[Preview without sending Wake-on-LAN]' \
            '*:client name' ;;
        interface|interfaces)
          _arguments "${_keenetic_global_options[@]}" "${_keenetic_watch_json[@]}" \
            '(-i --interactive)'{-i,--interactive}'[Pick an interface, then connect, disconnect, or inspect]' \
            '--sample[Initial rate sample interval]:seconds' \
            '--all[Include inactive interfaces]' \
            '--dry-run[Preview up/down or the selected action]' \
            '1: :((list\:"List interfaces" show\:"Show one interface in detail" rates\:"Sampled RX/TX rates" up\:"Enable an interface" down\:"Disable an interface"))' \
            '2:interface ID' ;;
        wifi)
          _arguments "${_keenetic_global_options[@]}" "${_keenetic_watch_json[@]}" \
            '--all[Include disabled networks or radios]' \
            '--radio[Survey one radio]:radio' \
            '(-i --interactive)'{-i,--interactive}'[Pick a radio to survey]' \
            '1: :((list\:"Wi-Fi networks" clients\:"Associated stations" scan\:"Survey nearby networks" load\:"Channel utilization"))' ;;
        traffic)
          _arguments "${_keenetic_global_options[@]}" "${_keenetic_watch_json[@]}" \
            '--top[Number of clients]:count' \
            '--period[History window]:period:(3m 1h 3h 1d)' ;;
        client|clients)
          _arguments "${_keenetic_global_options[@]}" "${_keenetic_watch_json[@]}" \
            '--all[Include offline clients]' '--offline[Show only offline clients]' '--dry-run[Preview the action]' \
            '(-i --interactive)'{-i,--interactive}'[Pick the client(s) instead of naming them]' \
            '1: :((list\:"List clients" show\:"Show one client in detail" rename\:"Rename a client" wake\:"Wake-on-LAN" block\:"Block Internet" unblock\:"Unblock Internet" assign\:"Assign a policy" nat\:"Active NAT connections"))' \
            '*:client name, IP, or MAC' ;;
        system)
          _arguments "${_keenetic_global_options[@]}" "${_keenetic_watch_json[@]}" '--dry-run[Preview save or reboot]' \
            '(-y --yes)'{-y,--yes}'[Reboot without asking for confirmation]' \
            '1: :((show\:"Router health" changes\:"Pending configuration changes" save\:"Persist running configuration" reboot\:"Reboot the router"))' ;;
        vpn)
          _arguments "${_keenetic_global_options[@]}" "${_keenetic_watch_json[@]}" '1: :((peers\:"WireGuard peers"))' ;;
        logs)
          _arguments "${_keenetic_global_options[@]}" "${_keenetic_watch_json[@]}" \
            '--limit[Maximum entries]:count' '--filter[Literal text filter]:text' \
            '(-i --interactive)'{-i,--interactive}'[Pick a log source]' ;;
        diagnose)
          _arguments "${_keenetic_global_options[@]}" '--json[Emit JSON]' '--interface[Route through this interface]:interface' \
            '(-i --interactive)'{-i,--interactive}'[Pick the source interface]' '1:host' ;;
        speedtest)
          _arguments "${_keenetic_global_options[@]}" '--json[Emit JSON]' '--dry-run[Preview the request]' \
            '--server[iPerf3 server]:host' '--port[Server port]:port' '--duration[Seconds]:seconds' \
            '--reverse[Measure download]' '--interface[Router interface]:interface' \
            '(-i --interactive)'{-i,--interactive}'[Pick the server and source interface]' ;;
        nat|connections)
          _arguments "${_keenetic_global_options[@]}" "${_keenetic_watch_json[@]}" '--client[Filter by client]:client' \
            '(-i --interactive)'{-i,--interactive}'[Pick the client]' ;;
        wan|dhcp|routes|mesh|forwards|log)
          _arguments "${_keenetic_global_options[@]}" "${_keenetic_watch_json[@]}" ;;
      esac ;;
  esac
}

_keenetic "$@"
