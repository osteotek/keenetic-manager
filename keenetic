#!/usr/bin/env bash

set -Eeuo pipefail

# Bash 4.3+ is required. macOS ships Bash 3.2, so re-exec under a newer Bash
# when one is installed, and fail with a clear message otherwise. This block
# must stay free of Bash 4 syntax so that Bash 3.2 can parse it.
if (( BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 3) )); then
    if [[ -z ${KEENETIC_BASH_REEXEC:-} ]]; then
        for candidate in /opt/homebrew/bin/bash /usr/local/bin/bash /home/linuxbrew/.linuxbrew/bin/bash; do
            if [[ -x $candidate ]] && "$candidate" -c '(( BASH_VERSINFO[0] > 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] >= 3) ))' 2>/dev/null; then
                KEENETIC_BASH_REEXEC=1 exec "$candidate" "$0" "$@"
            fi
        done
    fi
    printf '%s: Bash 4.3 or newer is required, but this is Bash %s.\n' "${0##*/}" "$BASH_VERSION" >&2
    printf 'On macOS, install a newer Bash with: brew install bash\n' >&2
    exit 1
fi
unset KEENETIC_BASH_REEXEC

