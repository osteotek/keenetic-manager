    fi
    # shellcheck disable=SC2016 # Variables in the filter belong to jq.
    normalize_data "$TMP_DIR/scan-interfaces.json" "$TMP_DIR/scan-radios.json" '
        if type != "object" or any(.[]; type != "object") then error("invalid radios") else . end
