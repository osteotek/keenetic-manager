#!/usr/bin/env bash

set -Eeuo pipefail

PROGRAM=${0##*/}
VERSION=1.2.0
EXIT_GENERAL=1
EXIT_USAGE=2
EXIT_CLIENT=3
EXIT_POLICY=4
EXIT_VERIFY=5
CONFIG_ENV_SET=false
[[ -v KEENETIC_CONFIG ]] && CONFIG_ENV_SET=true
CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}/keenetic-policy
CONFIG_FILE=${KEENETIC_CONFIG:-$CONFIG_HOME/config}
STATE_HOME=${XDG_STATE_HOME:-$HOME/.local/state}/keenetic-policy
HISTORY_FILE=${KEENETIC_STATE_FILE:-$STATE_HOME/history.json}
ROUTER_URL=
ROUTER_USERNAME=
ROUTER_PASSWORD=
ROUTER_PASSWORD_COMMAND=
ROUTER_PASSWORD_FILE=
ROUTER_CA_FILE=
ROUTER_INSECURE=false
CLI_CA_FILE=
CLI_INSECURE=false
ROUTER_PROFILE=
HTTP_STATUS=
ROUTER_LOCAL_IP=
CURRENT_CLIENT_MAC=
TMP_DIR=
POLICY_QUERY=
FZF_COMMAND=${KEENETIC_FZF:-fzf}
ACTION=
COMMAND=root
VIEW_MODE=connected
TRAFFIC_TOP=5
TRAFFIC_PERIOD=3m
SUBCOMMAND=
INSPECT_QUERY=
WATCH_INTERVAL=
WATCH_SCREEN=false
WATCH_SLEEP_PID=
SESSION_READY=false
DIAG_HOST=
DIAG_INTERFACE=
DIAG_ACTIVE_ENDPOINT=
LOG_LIMIT=20
LOG_FILTER=
INTERACTIVE=false
JSON_OUTPUT=false
INIT_CONFIG=false
DISCOVER=false
DRY_RUN=false
UNDO=false
QUIET=false
VERBOSE=false
COLOR_MODE=auto
SELECTED_CLIENT=
SELECTED_INTERFACE=
SELECTED_INTERFACE_ACTION=
SELECTED_POLICY_ID=
SELECTED_POLICY_LABEL=
SELECTED_INDEX=0
MENU_CURRENT_INDEX=-1
MENU_RESIZED=false
CURSOR_HIDDEN=false
OPERATION_CONTEXT=
RED=
GREEN=
YELLOW=
DIM=
HIGHLIGHT=
RESET=
CLIENT_NAME_WIDTH=28
CLIENT_IP_WIDTH=15
CLIENT_POLICY_WIDTH=18
declare -a CLIENT_SELECTORS=()
declare -a CLIENT_VALUES=()
declare -a SELECTED_CLIENTS=()
declare -a MENU_OPTIONS=()
MENU_KIND=
declare -a POLICY_IDS=()
declare -a POLICY_LABELS=()

usage() {
    cat <<EOF
Usage:
  $PROGRAM [GLOBAL OPTIONS] [--all] [--json]
  $PROGRAM [GLOBAL OPTIONS] policy [OPTIONS]
  $PROGRAM [GLOBAL OPTIONS] interfaces [OPTIONS]
  $PROGRAM [GLOBAL OPTIONS] traffic [OPTIONS]
  $PROGRAM [GLOBAL OPTIONS] wifi [--all] [--json]
  $PROGRAM [GLOBAL OPTIONS] clients [inspect NAME|IP|MAC] [OPTIONS]
  $PROGRAM [GLOBAL OPTIONS] system [--json]
  $PROGRAM [GLOBAL OPTIONS] vpn peers [--json]
  $PROGRAM [GLOBAL OPTIONS] diagnose HOST [--interface ID] [--json]
  $PROGRAM [GLOBAL OPTIONS] logs [--limit N] [--filter TEXT] [--json]
  $PROGRAM [GLOBAL OPTIONS] wake SELECTOR... [--dry-run]
  $PROGRAM --init [--router NAME] [--ca-file FILE|--insecure]
  $PROGRAM --discover
  $PROGRAM --help
  $PROGRAM --version

Commands:
  (none)      Show KeenDNS, connected clients, interfaces, IP addresses, and traffic totals
  interfaces  List interfaces and interactively connect or disconnect them
  traffic     Rank clients by recent traffic (default: top five, last three minutes)
  wifi        Show the router's Wi-Fi networks, radios, security, and client counts
  clients     List clients or inspect connection, policy, and recent traffic details
  system      Show model, firmware, uptime, CPU, and memory
  vpn         Show WireGuard peer endpoints, handshakes, and counters
  diagnose    Run router-side ping/traceroute and show relevant recent logs
  logs        Show recent router logs, with optional text filtering
  policy      List clients and manage connection policies and Internet blocks
  wake        Send Wake-on-LAN to known clients, including offline clients

Setup and discovery:
      --init                     Configure and test router credentials
      --discover                 Probe the default gateway for Keenetic API access

Status output (without a subcommand):
      --all                      Include disabled, disconnected, and unknown interfaces
      --json                     Emit router and interface status as JSON
      --watch SECONDS             Refresh a read-only view (1–3600 seconds)

Global options (before or after a subcommand):
      --router NAME              Select a named router profile
      --ca-file FILE             Trust this CA certificate for HTTPS
      --insecure                 Disable HTTPS certificate verification
  -q, --quiet                    Suppress successful action output
  -v, --verbose                  Print connection diagnostics
      --color[=WHEN]             Colors: auto, always, or never
      --no-color                 Disable colors
  -h, --help                     Show command-specific help
  -V, --version                  Show version

Configuration: $CONFIG_FILE
Override it with KEENETIC_CONFIG.
Run '$PROGRAM COMMAND --help' for command options.
EOF
}

wifi_usage() {
    cat <<EOF
Usage:
  $PROGRAM wifi [--all] [--json]
  $PROGRAM wifi monitor [--json] [--watch SECONDS]

List the router's Wi-Fi access-point networks with SSID, band, channel,
channel width, security, connected-client count, and status.
      --all                      Include disabled and inactive networks
      --json                     Emit full network details as JSON
      --watch SECONDS             Refresh the network or channel-load view

Each access point is listed separately, including networks sharing an SSID
across radio bands. Missing information is shown as - or unknown. This command
reads the router's own networks; it does not scan for neighbouring networks.
Global options work before or after wifi. Run '$PROGRAM --help' for details.
EOF
}

traffic_usage() {
    cat <<EOF
Usage:
  $PROGRAM traffic [--top N] [--period 3m|1h|3h|1d] [--json]

Rank clients by received + sent traffic in the router's stored history.
Results are immediate; no sampling wait is needed.
      --top N                    Number of clients to show (default: 5)
      --period PERIOD            History window: 3m, 1h, 3h, or 1d (default: 3m)
      --watch SECONDS             Refresh the traffic table
      --json                     Emit full names, addresses, and byte totals

Uses the router's Traffic Monitor history for registered clients. Aggregate
categories such as Other devices are excluded. RX/TX are client received/sent
bytes, not current speeds or lifetime totals.
Global options work before or after traffic. Run '$PROGRAM --help' for details.
EOF
}

interfaces_usage() {
    cat <<EOF
Usage:
  $PROGRAM interfaces [--all] [--json]
  $PROGRAM interfaces --interactive [--dry-run]

      --all                      Include inactive interfaces in the listing
      --json                     Emit router address and interface data as JSON
      --watch SECONDS             Refresh the interface listing
  -i, --interactive              Select an interface and Connect/Disconnect action
      --dry-run                  Preview the selected action without changing it

Interactive mode includes all interfaces and uses fzf when available, otherwise
arrow keys. Esc or q cancels the arrow selector. Connect enables an interface;
Disconnect disables it. Enabling does not guarantee a working link or VPN peer.
Disabling the interface carrying your router connection can end this session.

Global options work before or after interfaces. Run '$PROGRAM --help' for details.
EOF
}

policy_usage() {
    cat <<EOF
Usage:
  $PROGRAM policy [--all|--offline] [--json]
  $PROGRAM policy --interactive
  $PROGRAM policy CLIENT_NAME
  $PROGRAM policy SELECTOR... (--policy POLICY|--block|--unblock) [--dry-run]
  $PROGRAM policy --undo [--dry-run]
  $PROGRAM policy inspect POLICY [--json] [--watch SECONDS]

Selectors (repeatable for batch changes):
      --client NAME              Select by exact client name
      --ip ADDRESS               Select by exact IP address
      --mac ADDRESS              Select by exact MAC address

Actions:
      --policy POLICY            Apply policy ID, description, or "Default"
      --block                    Block Internet access
      --unblock                  Remove Internet block
      --undo                     Restore the most recent recorded change
      --dry-run                  Resolve and print changes without POSTing

Listing:
  -i, --interactive              Select with fzf when available, else arrow keys
      --all                      Include connected and offline clients
      --offline                  Show only offline clients
      --json                     Emit client list as JSON
      --watch SECONDS             Refresh a read-only list or inspection

Global options such as --router, --ca-file, --quiet, and --verbose work before
or after policy. Run '$PROGRAM --help' for the full list.

Interactive controls without fzf: Up/Down arrows move, Enter selects, Esc or q cancels.

Configuration: $CONFIG_FILE
Override it with KEENETIC_CONFIG.
EOF
}
read_command_usage() {
    case $COMMAND in
        clients)
            printf 'Usage:\n  %s clients [--all|--offline] [--json] [--watch SECONDS]\n  %s clients inspect NAME|IP|MAC [--json] [--watch SECONDS]\n\nInspection includes offline clients. Use an IP or MAC to distinguish duplicate names.\n' "$PROGRAM" "$PROGRAM" ;;
        system) printf 'Usage:\n  %s system [--json] [--watch SECONDS]\n\nShow model, firmware, uptime, CPU, RAM, swap, and connection counts.\n' "$PROGRAM" ;;
        vpn) printf 'Usage:\n  %s vpn peers [--json] [--watch SECONDS]\n\nShow WireGuard peer endpoints, handshake age, online state, and cumulative RX/TX.\n' "$PROGRAM" ;;
        diagnose) printf 'Usage:\n  %s diagnose HOST [--interface ID] [--json]\n\nRun four router-side pings and a bounded traceroute (12 hops), then show relevant\nrecent logs. Each test is limited to 60 seconds. Ctrl-C cancels the active test.\nCompletion means the tests ran; inspect their output for packet loss or failure.\n' "$PROGRAM" ;;
        logs) printf 'Usage:\n  %s logs [--limit N] [--filter TEXT] [--json] [--watch SECONDS]\n\nRead the latest 20 log entries by default (maximum 1000). Filtering is literal\nand case-insensitive within those entries. Watch refreshes this view.\n' "$PROGRAM" ;;
    esac
    printf '\nGlobal options work before or after the command. Watch JSON emits one object per line.\n'
}

wake_usage() {
    cat <<EOF
Usage:
  $PROGRAM [GLOBAL OPTIONS] wake SELECTOR... [--dry-run]
  $PROGRAM wake CLIENT_NAME [--dry-run]

Selectors (repeatable; targets are deduplicated by MAC):
      --client NAME              Select by exact client name
      --ip ADDRESS               Select by exact IP address
      --mac ADDRESS              Select by exact MAC address
      --dry-run                  Preview without sending a Wake-on-LAN request

All known clients are searched, including offline clients.
Global options work before or after wake. Run '$PROGRAM --help' for the full list.
EOF
}

fail() {
    local status=$EXIT_GENERAL
    if [[ ${1-} =~ ^[1-9][0-9]*$ ]]; then
        status=$1
        shift
    fi
    if [[ -n $OPERATION_CONTEXT ]]; then
        set -- "$OPERATION_CONTEXT: $*"
    fi
    if $WATCH_SCREEN; then
        printf '\033[?1049l\033[?25h'
        WATCH_SCREEN=false
        CURSOR_HIDDEN=false
    fi
    printf '%sError:%s %s\n' "$RED" "$RESET" "$*" >&2
    exit "$status"
}

warn() {
    printf '%sWarning:%s %s\n' "$YELLOW" "$RESET" "$*" >&2
}

success() {
    $QUIET || printf '%s%s%s\n' "$GREEN" "$*" "$RESET"
}

unchanged() {
    $QUIET || printf '%s%s%s\n' "$YELLOW" "$*" "$RESET"
}

info() {
    $QUIET || printf '%s\n' "$*"
}

debug() {
    if $VERBOSE; then
        printf 'Debug: %s\n' "$*" >&2
    fi
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || fail "required command not found: $1"
}

add_client_selector() {
    local selector=$1 value=$2
    [[ -n $value ]] || fail "$EXIT_USAGE" "--$selector requires a non-empty value"
    if [[ $selector == mac ]]; then
        value=${value,,}
        [[ $value =~ ^([0-9a-f]{2}:){5}[0-9a-f]{2}$ ]] \
            || fail "$EXIT_USAGE" 'MAC address must use aa:bb:cc:dd:ee:ff format'
    fi
    CLIENT_SELECTORS+=("$selector")
    CLIENT_VALUES+=("$value")
}

set_action() {
    local action=$1
    [[ -z $ACTION || $ACTION == "$action" ]] \
        || fail "$EXIT_USAGE" 'use only one of --policy, --block, or --unblock'
    ACTION=$action
}

parse_args() {
    local scope=root selector help=false version=false
    local -a positional=()
    while (($#)); do
        if [[ $scope == root ]]; then
            case $1 in
                policy|wake|interfaces|traffic|wifi|clients|system|vpn|diagnose|logs|--watch|--watch=*|--all|--json|--init|--discover|--router|--router=*|--ca-file|--ca-file=*|--insecure|-q|--quiet|-v|--verbose|--color|--color=*|--no-color|-h|--help|-V|--version) ;;
                *) fail "$EXIT_USAGE" "unknown command or option: $1. Run '$PROGRAM --help'." ;;
            esac
        elif [[ $scope == clients || $scope == system || $scope == vpn || $scope == diagnose || $scope == logs ]]; then
            case $1 in
                --json|--watch|--watch=*|--router|--router=*|--ca-file|--ca-file=*|--insecure|-q|--quiet|-v|--verbose|--color|--color=*|--no-color|-h|--help|-V|--version|--) ;;
                --all|--offline) [[ $scope == clients ]] || fail "$EXIT_USAGE" "$1 is only valid for client listings" ;;
                --interface|--interface=*) [[ $scope == diagnose ]] || fail "$EXIT_USAGE" "$1 is only valid for diagnose" ;;
                --limit|--limit=*|--filter|--filter=*) [[ $scope == logs ]] || fail "$EXIT_USAGE" "$1 is only valid for logs" ;;
                -*) fail "$EXIT_USAGE" "unknown option for $scope: $1" ;;
            esac
        elif [[ $scope == wifi ]]; then
            case $1 in
                monitor|--watch|--watch=*|--all|--json|--router|--router=*|--ca-file|--ca-file=*|--insecure|-q|--quiet|-v|--verbose|--color|--color=*|--no-color|-h|--help|-V|--version) ;;
                *) fail "$EXIT_USAGE" "unknown option for wifi: $1. Run '$PROGRAM wifi --help'." ;;
            esac
        elif [[ $scope == traffic ]]; then
            case $1 in
                --watch|--watch=*|--top|--top=*|--period|--period=*|--json|--router|--router=*|--ca-file|--ca-file=*|--insecure|-q|--quiet|-v|--verbose|--color|--color=*|--no-color|-h|--help|-V|--version) ;;
                *) fail "$EXIT_USAGE" "unknown option for traffic: $1. Run '$PROGRAM traffic --help'." ;;
            esac
        elif [[ $scope == interfaces ]]; then
            case $1 in
                --watch|--watch=*|--all|--json|-i|--interactive|--dry-run|--router|--router=*|--ca-file|--ca-file=*|--insecure|-q|--quiet|-v|--verbose|--color|--color=*|--no-color|-h|--help|-V|--version) ;;
                *) fail "$EXIT_USAGE" "unknown option for interfaces: $1. Run '$PROGRAM interfaces --help'." ;;
            esac
        elif [[ $scope == wake ]]; then
            case $1 in
                --client|--client=*|--ip|--ip=*|--mac|--mac=*|--dry-run|--router|--router=*|--ca-file|--ca-file=*|--insecure|-q|--quiet|-v|--verbose|--color|--color=*|--no-color|-h|--help|-V|--version|--) ;;
                -*) fail "$EXIT_USAGE" "unknown option for wake: $1. Run '$PROGRAM wake --help'." ;;
            esac
        fi
        case $1 in
            policy|wake|interfaces|traffic|wifi|clients|system|vpn|diagnose|logs)
                if [[ $scope == root ]]; then
                    $INIT_CONFIG || $DISCOVER \
                        && fail "$EXIT_USAGE" '--init and --discover cannot be combined with a subcommand'
                    scope=$1
                    COMMAND=$scope
                    [[ $scope != wake ]] || ACTION=wake
                else
                    positional+=("$1")
                fi
                ;;
            -h|--help)
                help=true
                ;;
            -V|--version)
                version=true
                ;;
            -i|--interactive)
                INTERACTIVE=true
                ;;
            --watch|--interface|--limit|--filter)
                (($# >= 2)) || fail "$EXIT_USAGE" "$1 requires a value"
                case $1 in
                    --watch) WATCH_INTERVAL=$2 ;;
                    --interface) [[ $scope == diagnose ]] || fail "$EXIT_USAGE" '--interface is only valid for diagnose'; DIAG_INTERFACE=$2 ;;
                    --limit) [[ $scope == logs ]] || fail "$EXIT_USAGE" '--limit is only valid for logs'; LOG_LIMIT=$2 ;;
                    --filter) [[ $scope == logs ]] || fail "$EXIT_USAGE" '--filter is only valid for logs'; LOG_FILTER=$2 ;;
                esac
                [[ -n $2 ]] || fail "$EXIT_USAGE" "$1 requires a non-empty value"
                shift
                ;;
            --watch=*|--interface=*|--limit=*|--filter=*)
                [[ -n ${1#*=} ]] || fail "$EXIT_USAGE" "${1%%=*} requires a non-empty value"
                case $1 in
                    --watch=*) WATCH_INTERVAL=${1#*=} ;;
                    --interface=*) [[ $scope == diagnose ]] || fail "$EXIT_USAGE" '--interface is only valid for diagnose'; DIAG_INTERFACE=${1#*=} ;;
                    --limit=*) [[ $scope == logs ]] || fail "$EXIT_USAGE" '--limit is only valid for logs'; LOG_LIMIT=${1#*=} ;;
                    --filter=*) [[ $scope == logs ]] || fail "$EXIT_USAGE" '--filter is only valid for logs'; LOG_FILTER=${1#*=} ;;
                esac
                ;;
            --top|--period)
                [[ $scope == traffic ]] || fail "$EXIT_USAGE" "$1 is only valid for traffic"
                (($# >= 2)) || fail "$EXIT_USAGE" "$1 requires a value"
                if [[ $1 == --top ]]; then TRAFFIC_TOP=$2; else TRAFFIC_PERIOD=$2; fi
                shift
                ;;
            --top=*|--period=*)
                [[ $scope == traffic ]] || fail "$EXIT_USAGE" "${1%%=*} is only valid for traffic"
                if [[ $1 == --top=* ]]; then TRAFFIC_TOP=${1#*=}; else TRAFFIC_PERIOD=${1#*=}; fi
                ;;
            --client|--ip|--mac)
                (($# >= 2)) || fail "$EXIT_USAGE" "$1 requires a value"
                add_client_selector "${1#--}" "$2"
                shift
                ;;
            --client=*|--ip=*|--mac=*)
                selector=${1%%=*}
                add_client_selector "${selector#--}" "${1#*=}"
                ;;
            --policy)
                (($# >= 2)) || fail "$EXIT_USAGE" '--policy requires an ID or description'
                [[ -n $2 ]] || fail "$EXIT_USAGE" '--policy requires a non-empty ID or description'
                set_action policy
                POLICY_QUERY=$2
                shift
                ;;
            --policy=*)
                set_action policy
                POLICY_QUERY=${1#*=}
                [[ -n $POLICY_QUERY ]] || fail "$EXIT_USAGE" '--policy requires a non-empty ID or description'
                ;;
            --block)
                set_action block
                ;;
            --unblock)
                set_action unblock
                ;;
            --wake)
                fail "$EXIT_USAGE" "use the '$PROGRAM wake' subcommand instead of --wake"
                ;;
            --undo)
                UNDO=true
                ;;
            --dry-run)
                DRY_RUN=true
                ;;
            --all)
                [[ $VIEW_MODE == connected || $VIEW_MODE == all ]] \
                    || fail "$EXIT_USAGE" '--all and --offline cannot be combined'
                VIEW_MODE=all
                ;;
            --offline)
                [[ $VIEW_MODE == connected || $VIEW_MODE == offline ]] \
                    || fail "$EXIT_USAGE" '--all and --offline cannot be combined'
                VIEW_MODE=offline
                ;;
            --router)
                (($# >= 2)) || fail "$EXIT_USAGE" '--router requires a profile name'
                ROUTER_PROFILE=$2
                shift
                ;;
            --router=*)
                ROUTER_PROFILE=${1#*=}
                ;;
            --discover)
                [[ $scope == root ]] || fail "$EXIT_USAGE" "use '$PROGRAM --discover' outside the policy subcommand"
                DISCOVER=true
                ;;
            --json)
                JSON_OUTPUT=true
                ;;
            -q|--quiet)
                QUIET=true
                ;;
            -v|--verbose)
                VERBOSE=true
                ;;
            --init)
                [[ $scope == root ]] || fail "$EXIT_USAGE" "use '$PROGRAM --init' outside the policy subcommand"
                INIT_CONFIG=true
                ;;
            --ca-file)
                (($# >= 2)) || fail "$EXIT_USAGE" '--ca-file requires a path'
                CLI_CA_FILE=$2
                shift
                ;;
            --ca-file=*)
                CLI_CA_FILE=${1#*=}
                ;;
            --insecure)
                CLI_INSECURE=true
                ;;
            --color)
                COLOR_MODE=always
                ;;
            --color=auto|--color=always|--color=never)
                COLOR_MODE=${1#*=}
                ;;
            --color=*)
                fail "$EXIT_USAGE" '--color must be auto, always, or never'
                ;;
            --no-color)
                COLOR_MODE=never
                ;;
            --)
                shift
                while (($#)); do
                    positional+=("$1")
                    shift
                done
                break
                ;;
            -*)
                fail "$EXIT_USAGE" "unknown option: $1"
                ;;
            *)
                positional+=("$1")
                ;;
        esac
        shift
    done

    if $help; then
        case $scope in
            root) usage ;;
            policy) policy_usage ;;
            interfaces) interfaces_usage ;;
            traffic) traffic_usage ;;
            wifi) wifi_usage ;;
            clients|system|vpn|diagnose|logs) read_command_usage ;;
            wake) wake_usage ;;
        esac
        exit 0
    fi
    if $version; then
        printf '%s %s\n' "$PROGRAM" "$VERSION"
        exit 0
    fi
    if [[ $COMMAND == traffic ]]; then
        if ! { [[ $TRAFFIC_TOP =~ ^[1-9][0-9]{0,9}$ ]] && ((TRAFFIC_TOP <= 2147483647)); }; then
            fail "$EXIT_USAGE" '--top requires a positive integer (maximum 2147483647)'
        fi
        case $TRAFFIC_PERIOD in
            3m|1h|3h|1d) ;;
            *) fail "$EXIT_USAGE" '--period must be 3m, 1h, 3h, or 1d' ;;
        esac
    fi
    if [[ $VIEW_MODE != connected ]] && { $INIT_CONFIG || $DISCOVER || [[ $COMMAND == wake || $COMMAND == traffic || $COMMAND == system || $COMMAND == vpn || $COMMAND == logs || $COMMAND == diagnose ]]; }; then
        fail "$EXIT_USAGE" '--all is only valid for interface or policy listings'
    fi
    case $COMMAND in
        clients)
            if ((${#positional[@]})); then
                [[ ${#positional[@]} == 2 && ${positional[0]} == inspect ]] || fail "$EXIT_USAGE" 'use clients inspect NAME|IP|MAC'
                SUBCOMMAND=inspect; INSPECT_QUERY=${positional[1]}; positional=()
            fi ;;
        policy)
            if [[ ${positional[0]-} == inspect ]]; then
                [[ ${#positional[@]} == 2 ]] || fail "$EXIT_USAGE" 'policy inspect requires a policy ID or description'
                SUBCOMMAND=inspect; INSPECT_QUERY=${positional[1]}; positional=()
            fi ;;
        wifi)
            if ((${#positional[@]})); then
                [[ ${#positional[@]} == 1 && ${positional[0]} == monitor ]] || fail "$EXIT_USAGE" 'use wifi monitor'
                SUBCOMMAND=monitor; positional=()
            fi ;;
        vpn)
            [[ ${#positional[@]} == 0 || ( ${#positional[@]} == 1 && ${positional[0]} == peers ) ]] || fail "$EXIT_USAGE" 'use vpn peers'
            SUBCOMMAND=peers; positional=() ;;
        system|logs) ((${#positional[@]} == 0)) || fail "$EXIT_USAGE" "$COMMAND does not accept positional arguments" ;;
        diagnose)
            [[ ${#positional[@]} == 1 ]] || fail "$EXIT_USAGE" 'diagnose requires a hostname or IP address'
            DIAG_HOST=${positional[0]}; positional=()
            [[ $DIAG_HOST =~ ^[a-zA-Z0-9:][a-zA-Z0-9.:%_-]*$ && ${#DIAG_HOST} -le 253 ]] || fail "$EXIT_USAGE" 'invalid diagnostic hostname or IP address' ;;
    esac
    [[ $SUBCOMMAND != inspect || -n $INSPECT_QUERY ]] || fail "$EXIT_USAGE" 'inspect requires a non-empty name or ID'
    if [[ $SUBCOMMAND == inspect ]] && { $INTERACTIVE || $DRY_RUN || $UNDO || [[ -n $ACTION ]] || ((${#CLIENT_SELECTORS[@]})); }; then
        fail "$EXIT_USAGE" 'inspect cannot be combined with client selectors or actions'
    fi
    if [[ $COMMAND == logs ]]; then
        if ! { [[ $LOG_LIMIT =~ ^[1-9][0-9]{0,3}$ ]] && ((LOG_LIMIT <= 1000)); }; then
            fail "$EXIT_USAGE" '--limit must be between 1 and 1000'
        fi
    fi
    for value in "${positional[@]}"; do
        add_client_selector client "$value"
    done
    if [[ -n $ROUTER_PROFILE ]]; then
        [[ $ROUTER_PROFILE =~ ^[A-Za-z0-9._-]+$ ]] \
            || fail "$EXIT_USAGE" 'router profile may contain only letters, digits, dots, underscores, and hyphens'
        $CONFIG_ENV_SET && fail "$EXIT_USAGE" '--router cannot be combined with KEENETIC_CONFIG'
        CONFIG_FILE=$CONFIG_HOME/routers/$ROUTER_PROFILE
    fi
    $CLI_INSECURE && [[ -n $CLI_CA_FILE ]] \
        && fail "$EXIT_USAGE" '--insecure and --ca-file cannot be combined'
    if $DISCOVER; then
        $INIT_CONFIG || $INTERACTIVE || $JSON_OUTPUT || $UNDO || [[ -n $ACTION ]] || ((${#CLIENT_SELECTORS[@]} > 0)) \
            && fail "$EXIT_USAGE" '--discover must be used alone'
    fi
    if $UNDO; then
        $INTERACTIVE || $JSON_OUTPUT || $INIT_CONFIG || [[ -n $ACTION ]] || ((${#CLIENT_SELECTORS[@]} > 0)) \
            && fail "$EXIT_USAGE" '--undo cannot be combined with another action or client selector'
    fi
    if $INIT_CONFIG; then
        $INTERACTIVE || $JSON_OUTPUT || [[ -n $ACTION ]] || ((${#CLIENT_SELECTORS[@]} > 0)) \
            && fail "$EXIT_USAGE" '--init cannot be combined with a client, action, --interactive, or --json'
    fi
    if $JSON_OUTPUT && { $INTERACTIVE || [[ -n $ACTION ]] || ((${#CLIENT_SELECTORS[@]} > 0)); }; then
        fail "$EXIT_USAGE" '--json is only valid for non-interactive listings'
    fi
    if [[ -n $ACTION ]] && ((${#CLIENT_SELECTORS[@]} == 0)); then
        fail "$EXIT_USAGE" 'an action requires at least one --client, --ip, or --mac selector'
    fi
    if $INTERACTIVE && { [[ -n $ACTION ]] || ((${#CLIENT_SELECTORS[@]} > 0)); }; then
        fail "$EXIT_USAGE" '--interactive selects the client and action itself'
    fi
    if ((${#CLIENT_SELECTORS[@]} > 1)) && [[ -z $ACTION ]]; then
        fail "$EXIT_USAGE" 'multiple client selectors require an explicit action'
    fi
    if $DRY_RUN && [[ -z $ACTION ]] && ! $INTERACTIVE && ! $UNDO; then
        fail "$EXIT_USAGE" '--dry-run requires an action, --interactive, or --undo'
    fi
    if [[ -n $WATCH_INTERVAL ]]; then
        if ! { [[ $WATCH_INTERVAL =~ ^[1-9][0-9]{0,3}$ ]] && ((WATCH_INTERVAL <= 3600)); }; then
            fail "$EXIT_USAGE" '--watch must be between 1 and 3600 seconds'
        fi
        $INIT_CONFIG || $DISCOVER || $INTERACTIVE || $DRY_RUN || $UNDO || [[ -n $ACTION || $COMMAND == diagnose ]] || ((${#CLIENT_SELECTORS[@]})) \
            && fail "$EXIT_USAGE" '--watch is only available for read-only views'
        [[ -t 1 ]] || $JSON_OUTPUT || fail "$EXIT_USAGE" '--watch requires a terminal or --json'
    fi
}

init_colors() {
    local enabled=false
    if [[ $COLOR_MODE == always ]]; then
        enabled=true
    elif [[ $COLOR_MODE == auto ]] && [[ -t 1 && -t 2 ]] && [[ ! -v NO_COLOR ]] && ! $JSON_OUTPUT; then
        enabled=true
    fi

    if $enabled; then
        RED=$'\033[31m'
        GREEN=$'\033[32m'
        YELLOW=$'\033[33m'
        DIM=$'\033[2m'
        HIGHLIGHT=$'\033[7m'
        RESET=$'\033[0m'
    fi
}

trim_key() {
    local value=$1
    value=${value#"${value%%[![:space:]]*}"}
    value=${value%"${value##*[![:space:]]}"}
    printf '%s' "$value"
}

resolve_password() {
    local password source_count=0
    local -a password_command password_lines
    [[ -n $ROUTER_PASSWORD ]] && ((source_count += 1))
    [[ -n $ROUTER_PASSWORD_COMMAND ]] && ((source_count += 1))
    [[ -n $ROUTER_PASSWORD_FILE ]] && ((source_count += 1))
    ((source_count <= 1)) \
        || fail "set exactly one of ROUTER_PASSWORD, ROUTER_PASSWORD_COMMAND, or ROUTER_PASSWORD_FILE in $CONFIG_FILE"

    if [[ -n $ROUTER_PASSWORD_COMMAND ]]; then
        read -r -a password_command <<< "$ROUTER_PASSWORD_COMMAND"
        ((${#password_command[@]} > 0)) || fail 'ROUTER_PASSWORD_COMMAND is empty'
        command -v "${password_command[0]}" >/dev/null 2>&1 \
            || fail "password command not found: ${password_command[0]}"
        if ! password=$("${password_command[@]}"); then
            fail 'ROUTER_PASSWORD_COMMAND failed'
        fi
        [[ -n $password ]] || fail 'ROUTER_PASSWORD_COMMAND returned an empty password'
        [[ $password != *$'\n'* ]] || fail 'ROUTER_PASSWORD_COMMAND returned more than one line'
        ROUTER_PASSWORD=$password
    elif [[ -n $ROUTER_PASSWORD_FILE ]]; then
        [[ -r $ROUTER_PASSWORD_FILE ]] || fail "cannot read password file: $ROUTER_PASSWORD_FILE"
        mapfile -t password_lines < "$ROUTER_PASSWORD_FILE"
        ((${#password_lines[@]} == 1)) \
            || fail 'ROUTER_PASSWORD_FILE must contain exactly one line'
        [[ -n ${password_lines[0]} ]] || fail 'ROUTER_PASSWORD_FILE contains an empty password'
        ROUTER_PASSWORD=${password_lines[0]}
    fi
    [[ -n $ROUTER_PASSWORD ]] \
        || fail "set ROUTER_PASSWORD, ROUTER_PASSWORD_COMMAND, or ROUTER_PASSWORD_FILE in $CONFIG_FILE"
}

validate_router_settings() {
    [[ -n $ROUTER_URL ]] || fail 'router URL cannot be empty'
    [[ -n $ROUTER_USERNAME ]] || fail 'router username cannot be empty'
    [[ $ROUTER_URL == http://* || $ROUTER_URL == https://* ]] \
        || fail 'router URL must start with http:// or https://'
    ROUTER_URL=${ROUTER_URL%/}
    [[ $ROUTER_INSECURE == true || $ROUTER_INSECURE == false ]] \
        || fail 'ROUTER_INSECURE must be true or false'
    if [[ -n $ROUTER_CA_FILE && $ROUTER_INSECURE == true ]]; then
        fail 'ROUTER_CA_FILE and ROUTER_INSECURE=true cannot be combined'
    fi
    if [[ -n $ROUTER_CA_FILE && ! -r $ROUTER_CA_FILE ]]; then
        fail "cannot read router CA file: $ROUTER_CA_FILE"
    fi
    resolve_password
}

load_config() {
    [[ -r $CONFIG_FILE ]] || fail "cannot read $CONFIG_FILE
Run '$PROGRAM --init' to create and test it."

    local line key value line_number=0 permissions
    while IFS= read -r line || [[ -n $line ]]; do
        ((line_number += 1))
        line=${line%$'\r'}
        [[ -z $line || $line =~ ^[[:space:]]*# ]] && continue
        [[ $line == *=* ]] || fail "$CONFIG_FILE:$line_number: expected KEY=VALUE"

        key=$(trim_key "${line%%=*}")
        value=${line#*=}
        case $key in
            ROUTER_URL) ROUTER_URL=$value ;;
            ROUTER_USERNAME) ROUTER_USERNAME=$value ;;
            ROUTER_PASSWORD) ROUTER_PASSWORD=$value ;;
            ROUTER_PASSWORD_COMMAND) ROUTER_PASSWORD_COMMAND=$value ;;
            ROUTER_PASSWORD_FILE) ROUTER_PASSWORD_FILE=$value ;;
            ROUTER_CA_FILE) ROUTER_CA_FILE=$value ;;
            ROUTER_INSECURE) ROUTER_INSECURE=${value,,} ;;
            *) fail "$CONFIG_FILE:$line_number: unknown setting: $key" ;;
        esac
    done < "$CONFIG_FILE"

    [[ -n $ROUTER_URL ]] || fail "ROUTER_URL is missing from $CONFIG_FILE"
    [[ -n $ROUTER_USERNAME ]] || fail "ROUTER_USERNAME is missing from $CONFIG_FILE"
    if [[ -n $CLI_CA_FILE ]]; then
        ROUTER_CA_FILE=$CLI_CA_FILE
        ROUTER_INSECURE=false
    fi
    if $CLI_INSECURE; then
        ROUTER_CA_FILE=
        ROUTER_INSECURE=true
    fi
    validate_router_settings

    if command -v stat >/dev/null 2>&1 && permissions=$(stat -c '%a' "$CONFIG_FILE" 2>/dev/null); then
        if [[ $permissions =~ ^[0-7]+$ ]] && (((8#$permissions & 077) != 0)); then
            warn "$CONFIG_FILE is readable by other users; run: chmod 600 '$CONFIG_FILE'"
        fi
    fi
    if [[ $ROUTER_URL == http://* ]]; then
        warn 'HTTP does not protect the authenticated router session; prefer HTTPS or KeenDNS.'
    elif [[ $ROUTER_INSECURE == true ]]; then
        warn 'HTTPS certificate verification is disabled for this connection.'
    fi
}

show_cursor() {
    if $CURSOR_HIDDEN; then
        printf '\033[?25h' >&2
        CURSOR_HIDDEN=false
    fi
}

cleanup() {
    [[ -z $WATCH_SLEEP_PID ]] || kill "$WATCH_SLEEP_PID" 2>/dev/null || true
    if [[ -n $DIAG_ACTIVE_ENDPOINT && -n $TMP_DIR ]]; then
        (HTTP_TIMEOUT=3 http_request DELETE "$DIAG_ACTIVE_ENDPOINT" "$TMP_DIR/cancel.json") >/dev/null 2>&1 || true
    fi
    if $WATCH_SCREEN; then printf '\033[?1049l' || true; fi
    show_cursor
    [[ -z ${TMP_DIR:-} ]] || rm -rf -- "$TMP_DIR"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

create_temp_dir() {
    TMP_DIR=$(mktemp -d)
    chmod 700 "$TMP_DIR"
}

http_request() {
    local method=$1 endpoint=$2 output=$3 data=${4-} curl_status response_meta
    local -a arguments=(
        --silent
        --show-error
        --connect-timeout 5
        --max-time "${HTTP_TIMEOUT:-20}"
        --cookie "$TMP_DIR/cookies"
        --cookie-jar "$TMP_DIR/cookies"
        --dump-header "$TMP_DIR/headers"
        --output "$output"
        --write-out $'%{http_code}\t%{local_ip}'
        --request "$method"
    )
    if [[ $ROUTER_INSECURE == true ]]; then
        arguments+=(--insecure)
    elif [[ -n $ROUTER_CA_FILE ]]; then
        arguments+=(--cacert "$ROUTER_CA_FILE")
    fi

    if [[ $method == POST ]]; then
        arguments+=(--header 'Content-Type: application/json' --data "$data")
    fi

    debug "$method $endpoint"
    if response_meta=$(curl "${arguments[@]}" "$ROUTER_URL$endpoint"); then
        HTTP_STATUS=${response_meta%%$'\t'*}
        ROUTER_LOCAL_IP=${response_meta#*$'\t'}
        return 0
    else
        curl_status=$?
    fi

    case $curl_status in
        6)
            fail "cannot resolve the router address in $ROUTER_URL
Check ROUTER_URL and the current network connection."
            ;;
        7)
            fail "cannot connect to the router at $ROUTER_URL
Check that this device is on the router network and its web interface is available."
            ;;
        28)
            fail "the router at $ROUTER_URL did not respond within ${HTTP_TIMEOUT:-20} seconds
Check the network connection and router address."
            ;;
        60)
            fail "TLS certificate verification failed for $ROUTER_URL
Use the router's valid KeenDNS address or a trusted local HTTP address."
            ;;
        *)
            fail "request failed: $method $ROUTER_URL$endpoint (curl exit $curl_status)"
            ;;
    esac
}

response_error() {
    local context=$1 file=$2 detail
    detail=$(jq -r 'if type == "object" then (.message // .error // empty) else empty end' "$file" 2>/dev/null || true)
    if [[ $HTTP_STATUS == 401 || $HTTP_STATUS == 403 ]]; then
        fail "$context (HTTP $HTTP_STATUS)
Check ROUTER_USERNAME and ROUTER_PASSWORD in $CONFIG_FILE."
    elif [[ -n $detail ]]; then
        fail "$context (HTTP $HTTP_STATUS): $detail"
    fi
    fail "$context (HTTP $HTTP_STATUS)"
}

header_value() {
    local wanted=${1,,} name value
    while IFS=: read -r name value; do
        if [[ ${name,,} == "$wanted" ]]; then
            value=${value%$'\r'}
            value=${value#"${value%%[![:space:]]*}"}
            printf '%s' "$value"
            return 0
        fi

    done < "$TMP_DIR/headers"
    return 1
}
hash_md5() {
    if command -v md5sum >/dev/null 2>&1; then
        md5sum
    elif command -v md5 >/dev/null 2>&1; then
        md5 -q
    else
        fail 'required MD5 tool not found: install md5sum or md5'
    fi
}

hash_sha256() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256
    else
        fail 'required SHA-256 tool not found: install sha256sum or shasum'
    fi
}

authenticate() {
    http_request GET /auth "$TMP_DIR/auth.json"
    case $HTTP_STATUS in
        200)
            debug 'Authentication: existing session accepted'
            return 0
            ;;
        401)
            debug 'Authentication: challenge response'
            ;;
        *) response_error 'authentication probe failed' "$TMP_DIR/auth.json" ;;
    esac

    local realm challenge md5 password_hash payload
    realm=$(header_value x-ndm-realm) || fail 'router did not return the X-NDM-Realm authentication header'
    challenge=$(header_value x-ndm-challenge) || fail 'router did not return the X-NDM-Challenge authentication header'
    md5=$(printf '%s' "$ROUTER_USERNAME:$realm:$ROUTER_PASSWORD" | hash_md5)
    md5=${md5%% *}
    password_hash=$(printf '%s' "$challenge$md5" | hash_sha256)
    password_hash=${password_hash%% *}
    payload=$(jq -nc --arg login "$ROUTER_USERNAME" --arg password "$password_hash" \
        '{login: $login, password: $password}')

    http_request POST /auth "$TMP_DIR/auth-result.json" "$payload"
    [[ $HTTP_STATUS == 200 ]] || response_error 'authentication failed' "$TMP_DIR/auth-result.json"
}

prompt_value() {
    local prompt=$1 default=$2 value
    printf '%s [%s]: ' "$prompt" "$default" >&2
    IFS= read -r value || fail 'configuration input ended unexpectedly'
    printf '%s' "${value:-$default}"
}

discover_router() {
    local gateway url status
    require_command ip
    require_command jq
    require_command curl
    gateway=$(ip -json route show default \
        | jq -r '[.[] | select(.gateway != null)] | sort_by(.metric // 0) | .[0].gateway // empty') \
        || fail 'cannot inspect the default route'
    [[ -n $gateway ]] || fail 'no default gateway was found'
    if [[ $gateway == *:* ]]; then
        url=http://[$gateway]
    else
        url=http://$gateway
    fi
    debug "Probing GET $url/auth"
    if ! status=$(curl --silent --show-error --connect-timeout 3 --max-time 5 \
        --output /dev/null --write-out '%{http_code}' "$url/auth"); then
        fail "default gateway $gateway did not respond to an HTTP authentication probe"
    fi
    case $status in
        200|401)
            printf '%s\n' "$url"
            ;;
        *)
            fail "default gateway $gateway did not expose a Keenetic-compatible /auth endpoint (HTTP $status)"
            ;;
    esac
}

init_config() {
    local answer password_confirmation config_dir config_temp password_command_input password_file_input ca_input
    if [[ -e $CONFIG_FILE ]]; then
        printf 'Configuration already exists at %s. Overwrite it? [y/N]: ' "$CONFIG_FILE" >&2
        IFS= read -r answer || fail 'configuration input ended unexpectedly'
        [[ ${answer,,} == y || ${answer,,} == yes ]] || {
            unchanged 'No changes made.'
            return 0
        }
    fi

    info 'Configure Keenetic router access. Credentials are tested before being saved.'
    ROUTER_URL=$(prompt_value 'Router URL' 'http://192.168.1.1')
    ROUTER_USERNAME=$(prompt_value 'Username' 'admin')
    printf 'Password command (leave blank to use a password file or stored password): ' >&2
    IFS= read -r password_command_input || fail 'configuration input ended unexpectedly'
    if [[ -n $password_command_input ]]; then
        ROUTER_PASSWORD_COMMAND=$password_command_input
    else
        printf 'Password file (leave blank to store the password): ' >&2
        IFS= read -r password_file_input || fail 'configuration input ended unexpectedly'
        if [[ -n $password_file_input ]]; then
            ROUTER_PASSWORD_FILE=$password_file_input
        else
            printf 'Password: ' >&2
            IFS= read -rs ROUTER_PASSWORD || fail 'configuration input ended unexpectedly'
            printf '\nConfirm password: ' >&2
            IFS= read -rs password_confirmation || fail 'configuration input ended unexpectedly'
            printf '\n' >&2
            [[ $ROUTER_PASSWORD == "$password_confirmation" ]] || fail 'passwords do not match'
        fi
    fi

    if [[ -n $CLI_CA_FILE ]]; then
        ROUTER_CA_FILE=$CLI_CA_FILE
    elif $CLI_INSECURE; then
        ROUTER_INSECURE=true
    elif [[ $ROUTER_URL == https://* ]]; then
        printf 'Trusted CA file (leave blank for system trust): ' >&2
        IFS= read -r ca_input || fail 'configuration input ended unexpectedly'
        ROUTER_CA_FILE=$ca_input
        if [[ -z $ROUTER_CA_FILE ]]; then
            printf 'Disable certificate verification? [y/N]: ' >&2
            IFS= read -r answer || fail 'configuration input ended unexpectedly'
            if [[ ${answer,,} == y || ${answer,,} == yes ]]; then
                ROUTER_INSECURE=true
            fi
        fi
    fi
    validate_router_settings

    if [[ $ROUTER_URL == http://* ]]; then
        warn 'HTTP does not protect the authenticated router session; prefer HTTPS or KeenDNS.'
    elif [[ $ROUTER_INSECURE == true ]]; then
        warn 'HTTPS certificate verification is disabled for this connection.'
    fi
    info "Testing connection to $ROUTER_URL..."
    authenticate

    if [[ $CONFIG_FILE == */* ]]; then
        config_dir=${CONFIG_FILE%/*}
    else
        config_dir=.
    fi
    if [[ ! -d $config_dir ]]; then
        mkdir -p -- "$config_dir"
        chmod 700 "$config_dir"
    fi
    config_temp=$(mktemp "$config_dir/.keenetic.XXXXXX")
    chmod 600 "$config_temp"
    {
        printf '%s\n' \
            '# Generated by keenetic --init. Values are literal.' \
            "ROUTER_URL=$ROUTER_URL" \
            "ROUTER_USERNAME=$ROUTER_USERNAME"
        if [[ -n $ROUTER_PASSWORD_COMMAND ]]; then
            printf 'ROUTER_PASSWORD_COMMAND=%s\n' "$ROUTER_PASSWORD_COMMAND"
        elif [[ -n $ROUTER_PASSWORD_FILE ]]; then
            printf 'ROUTER_PASSWORD_FILE=%s\n' "$ROUTER_PASSWORD_FILE"
        else
            printf 'ROUTER_PASSWORD=%s\n' "$ROUTER_PASSWORD"
        fi
        [[ -z $ROUTER_CA_FILE ]] || printf 'ROUTER_CA_FILE=%s\n' "$ROUTER_CA_FILE"
        printf 'ROUTER_INSECURE=%s\n' "$ROUTER_INSECURE"
    } > "$config_temp"
    mv -f -- "$config_temp" "$CONFIG_FILE"
    success "Connected successfully. Configuration saved to $CONFIG_FILE."
}

api_get() {
    local endpoint=$1 output=$2 description=$3 expected_type=$4
    http_request GET "$endpoint" "$output"
    [[ $HTTP_STATUS == 200 ]] || response_error "failed to retrieve $description" "$output"
    jq -e --arg type "$expected_type" 'type == $type' "$output" >/dev/null \
        || fail "the router returned invalid $description data from $endpoint
The installed Keenetic firmware may not support this API."
}

fetch_interface_status() {
    api_get /rci/show/interface "$TMP_DIR/interfaces.json" 'interfaces' object
    # Whitelist status fields: the raw response can also contain VPN peer data.
    if ! jq --arg router "$ROUTER_URL" --arg view "$VIEW_MODE" '
        def text: if type == "string" then . else "" end;
        def connection:
            if . == "yes" or . == true then true
            elif . == "no" or . == false then false else null end;
        if any(.[]; type != "object") then error("invalid interface entry") else . end
        | {router: $router, interfaces: [to_entries[]
            | .key as $key | .value
            | {
                id: ((.id | text | select(length > 0)) // $key),
                description: (.description | text),
                type: (.type | text),
                state: (.state | text),
                link: (.link | text),
                connected: (.connected | connection),
                ipv4: ((.address | text | select(length > 0)) // null),
                mask: ((.mask | text | select(length > 0)) // null),
                ipv6: [(.ipv6.addresses // [])[]
                    | select((.address | type) == "string" and (.address | length) > 0)
                    | {address: .address, prefix_length: (."prefix-length" // null)}]
            }
            | .vpn = (.type | test("wireguard|openvpn|l2tp|pptp|sstp|ipsec|ike|openconnect|zerotier|proxy"; "i"))
            | .status = (if .state == "down" then "disabled"
                         elif .connected == true then "connected"
                         elif .connected == false then "disconnected"
                         elif .link == "up" then "link up"
                         elif .link == "down" then "link down"
                         else "unknown" end)
            | select($view == "all" or
                (.state != "down" and .link != "down" and
                 (.connected == true or (.connected == null and .link == "up"))))
        ] | sort_by([(.vpn | not), .id])}
    ' "$TMP_DIR/interfaces.json" > "$TMP_DIR/status.json"; then
        fail 'the router returned invalid interface status data'
    fi
    debug "Router: $ROUTER_URL"
    debug "Interfaces: $(jq '.interfaces | length' "$TMP_DIR/status.json")"
}

fetch_status_details() {
    fetch_keendns_status
    fetch_interface_traffic
    jq --slurpfile dns "$TMP_DIR/keendns.json" '.keendns = $dns[0]' \
        "$TMP_DIR/status.json" > "$TMP_DIR/status-details.json"
    mv "$TMP_DIR/status-details.json" "$TMP_DIR/status.json"
}

fetch_keendns_status() {
    printf 'null\n' > "$TMP_DIR/keendns.json"
    http_request GET /rci/show/ndns "$TMP_DIR/ndns.json"
    if [[ $HTTP_STATUS == 401 || $HTTP_STATUS == 403 ]]; then
        response_error 'failed to retrieve KeenDNS status' "$TMP_DIR/ndns.json"
    fi
    if [[ $HTTP_STATUS == 200 ]] && jq -e '
        type == "object" and ([.. | objects | select(.status? == "error")] | length == 0)
    ' "$TMP_DIR/ndns.json" >/dev/null 2>&1; then
        jq '
            def text: if type == "string" and length > 0 then . else null end;
            (.name | text) as $name | (.domain | text) as $domain
            | {hostname: (if $name == null or $domain == null then null
                          elif $name | endswith("." + $domain) then $name
                          else $name + "." + $domain end), access: (.access | text)}
        ' "$TMP_DIR/ndns.json" > "$TMP_DIR/keendns.json"
    else
        warn "KeenDNS status unavailable (HTTP $HTTP_STATUS)."
    fi
}

fetch_interface_traffic() {
    local payload count unavailable
    count=$(jq '.interfaces | length' "$TMP_DIR/status.json")
    printf '[]\n' > "$TMP_DIR/traffic.json"
    if ((count > 0)); then
        # RCI requires the interface name as an argument, not a URL path segment.
        # Every command in this POST is a read-only show operation.
        payload=$(jq -c '[.interfaces[] | {show:{interface:{name:.id, stat:{}}}}]' "$TMP_DIR/status.json")
        http_request POST /rci/ "$TMP_DIR/traffic-response.json" "$payload"
        if [[ $HTTP_STATUS == 401 || $HTTP_STATUS == 403 ]]; then
            response_error 'failed to retrieve traffic statistics' "$TMP_DIR/traffic-response.json"
        fi
        # Positional results can only be matched safely when all entries are present.
        if [[ $HTTP_STATUS == 200 ]] && jq -e --argjson count "$count" '
            type == "array" and length == $count
        ' "$TMP_DIR/traffic-response.json" >/dev/null 2>&1; then
            jq '
                def counter:
                    (try tonumber catch null)
                    | if type == "number" and . >= 0 and floor == . then . else null end;
                map(
                    if type != "object" then null
                    elif any(.. | objects; .status? == "error") then null
                    else (.show.interface.stat // null)
                        | if type != "object" then null else {
                            rx_bytes: (.rxbytes | counter), tx_bytes: (.txbytes | counter),
                            rx_packets: (.rxpackets | counter), tx_packets: (.txpackets | counter),
                            rx_errors: (.rxerrors | counter), tx_errors: (.txerrors | counter),
                            rx_dropped: (.rxdropped | counter), tx_dropped: (.txdropped | counter)
                        } | if all(.[]; . == null) then null else . end end
                    end
                )
            ' "$TMP_DIR/traffic-response.json" > "$TMP_DIR/traffic.json" || {
                printf '[]\n' > "$TMP_DIR/traffic.json"
            }
        fi
    fi
    jq --slurpfile traffic "$TMP_DIR/traffic.json" '
        .interfaces |= (to_entries | map(.value + {traffic: $traffic[0][.key]}))
    ' "$TMP_DIR/status.json" > "$TMP_DIR/status-details.json"
    mv "$TMP_DIR/status-details.json" "$TMP_DIR/status.json"
    unavailable=$(jq '[.interfaces[] | select(.traffic == null)] | length' "$TMP_DIR/status.json")
    if ((unavailable > 0)); then
        warn "Traffic statistics unavailable for $unavailable of $count interfaces."
    fi
}

fetch_wifi_networks() {
    api_get /rci/show/interface "$TMP_DIR/wifi-interfaces.json" 'Wi-Fi interfaces' object
    if ! jq --arg router "$ROUTER_URL" --arg view "$VIEW_MODE" '
        def text: if type == "string" then . else null end;
        def positive:
            if type == "number" or type == "string" then
                (try tonumber catch null) | if . != null and . > 0 then . else null end
            else null end;
        def band:
            if type == "number" or type == "string" then tostring | ascii_downcase | gsub("[ -]|ghz"; "")
                | if . == "2.4" then "2.4 GHz" elif . == "5" then "5 GHz" elif . == "6" then "6 GHz" else null end
            else null end;
        if any(.[]; type != "object") or any(.. | objects; .status? == "error")
            then error("invalid interfaces") else . end
        | [to_entries[] | .key as $key | .value
            | .id = ((.id | text | select(length > 0)) // $key)] as $interfaces
        | ($interfaces | map({key:.id, value:.}) | from_entries) as $by_id
        | {router:$router, networks: [$interfaces[]
            | select(.type == "AccessPoint" or (.id | test("^WifiMaster[0-9]+/AccessPoint[0-9]+$")))
            | (.id | split("/")[0]) as $radio_id
            | ($by_id[$radio_id] // {}) as $radio
            | ((.band | band) // ($radio.band | band)) as $reported_band
            | ((.frequency | positive) // ($radio.frequency | positive)) as $frequency
            | (if $frequency >= 2400 and $frequency < 2500 then "2.4 GHz"
               elif $frequency >= 4900 and $frequency < 5925 then "5 GHz"
               elif $frequency >= 5925 and $frequency <= 7125 then "6 GHz" else null end) as $frequency_band
            | {
                id, radio_id:$radio_id, ssid:(.ssid | text), description:(.description | text),
                bssid:(.mac | text), state:(.state | text), link:(.link | text),
                band: ($reported_band // $frequency_band //
                    (if $radio_id == "WifiMaster0" then "2.4 GHz"
                     elif $radio_id == "WifiMaster1" then "5 GHz" else null end)),
                band_source: (if $reported_band != null then "reported"
                    elif $frequency_band != null then "frequency"
                    elif $radio_id == "WifiMaster0" or $radio_id == "WifiMaster1" then "radio_id" else null end),
                channel: ((.channel | positive) // ($radio.channel | positive)),
                channel_width_mhz: ((.bandwidth | positive) // ($radio.bandwidth | positive)),
                authentication:(."auth-type" | text), encryption:(.encryption | text), clients:null,
                status:(if .state == "down" or $radio.state == "down" then "disabled"
                    elif .link == "down" or $radio.link == "down" then "link down"
                    elif .link == "up" or .connected == "yes" or .connected == true then "active"
                    else "unknown" end)
              }
            | select($view == "all" or .status == "active")
          ] | sort_by([.radio_id, .id])}
    ' "$TMP_DIR/wifi-interfaces.json" > "$TMP_DIR/wifi.json"; then
        fail 'the router returned invalid Wi-Fi interface data'
    fi
    http_request GET /rci/show/ip/hotspot/host "$TMP_DIR/wifi-hosts.json"
    if [[ $HTTP_STATUS == 401 || $HTTP_STATUS == 403 ]]; then
        response_error 'failed to retrieve Wi-Fi clients' "$TMP_DIR/wifi-hosts.json"
    fi
    if [[ $HTTP_STATUS == 200 ]] && jq -e 'type == "array" and all(.[]; type == "object")' \
        "$TMP_DIR/wifi-hosts.json" >/dev/null 2>&1; then
        jq --slurpfile hosts "$TMP_DIR/wifi-hosts.json" '
            [$hosts[0][] | select((.mac | type) == "string" and .mac != "")
                | select(.link == "up" or .mws.link? == "up")
                | {mac:(.mac | ascii_downcase), aps:([.ap, .mws.ap?] | map(select(type == "string")))}] as $clients
            | .networks |= map(.id as $id
                | .clients = ([$clients[] | select(.aps | index($id)) | .mac] | unique | length))
        ' "$TMP_DIR/wifi.json" > "$TMP_DIR/wifi-clients.json"
        mv "$TMP_DIR/wifi-clients.json" "$TMP_DIR/wifi.json"
    else
        warn "Wi-Fi client counts unavailable (HTTP $HTTP_STATUS)."
    fi
}

list_wifi_networks() {
    jq -r --arg columns "$(terminal_columns)" --arg dim "$DIM" --arg reset "$RESET" \
        --arg view "$VIEW_MODE" \
        "$(table_format_filter)"'
        def value: if . == null or . == "" then "-" else tostring | clean end;
        def security:
            if .encryption != null and .encryption != "" and .encryption != "none" then .encryption | ascii_upcase
            elif .authentication != null and .authentication != "" and .authentication != "none" then .authentication | ascii_upcase
            elif .encryption == "none" and .authentication == "none" then "Open" else "unknown" end;
        ($columns | tonumber | if . < 20 then 20 else . end) as $screen
        | [.networks[] | {ssid:(.ssid | value), band:(.band | value), channel:(.channel | value),
            width:(.channel_width_mhz | value), security:(security | clean),
            clients:(.clients | value), status}] as $rows
        | "Wi-Fi networks",
          (if $rows | length == 0 then
                (if $view == "all" then "No Wi-Fi networks found." else "No active Wi-Fi networks." end) | wordwrap($screen)[]
           else ($screen >= 72) as $wide
            | ([$rows[].status | width] + [6] | max) as $status_width
            | ([$rows[].band | width] + [4] | max) as $band_width
            | ([$rows[].channel | width] + [2] | max) as $channel_width
            | ([$rows[].width | width] + [5] | max) as $width_width
            | ([$rows[].clients | width] + [7] | max) as $clients_width
            | ([$rows[].security | width] + [8] | max | . as $natural
                | [$natural, ($screen * 0.2 | floor)] | min) as $security_width
            | ([$rows[].ssid | width] + [4] | max | . as $natural
                | [$natural, ($screen - $status_width - 2
                    - (if $wide then $band_width + $channel_width + $width_width
                        + $clients_width + $security_width + 10 else 0 end))] | min) as $ssid_width
            | def line($ssid; $band; $channel; $width; $security; $clients; $status):
                ($ssid | fit($ssid_width; false)) + "  "
                + (if $wide then ($band | pad($band_width; false)) + "  "
                    + ($channel | pad($channel_width; true)) + "  " + ($width | pad($width_width; true)) + "  "
                    + ($security | fit($security_width; false)) + "  " + ($clients | pad($clients_width; true)) + "  " else "" end)
                + ($status | pad($status_width; false));
            $dim + line("SSID"; "BAND"; "CH"; "WIDTH"; "SECURITY"; "CLIENTS"; "STATUS") + $reset,
            ($rows[] | line(.ssid; .band; .channel; .width; .security; .clients; .status),
                (if $wide then empty else
                    (.band + " / CH " + .channel + " / " + .width + " MHz",
                     .security + " / Clients: " + .clients)
                    | wordwrap($screen - 2)[] | "  " + . end))
           end)
    ' "$TMP_DIR/wifi.json"
}

fetch_client_traffic() {
    local detail seconds
    case $TRAFFIC_PERIOD in
        3m) detail=0; seconds=180 ;;
        1h) detail=1; seconds=3600 ;;
        3h) detail=2; seconds=10800 ;;
        1d) detail=3; seconds=86400 ;;
    esac
    api_get "/rci/show/ip/hotspot/summary?count=$TRAFFIC_TOP&detail=$detail&attribute=sumbytes" \
        "$TMP_DIR/traffic-summary.json" "$TRAFFIC_PERIOD client traffic summary" object
    if ! jq --arg router "$ROUTER_URL" --arg period "$TRAFFIC_PERIOD" \
        --argjson limit "$TRAFFIC_TOP" --argjson detail "$detail" --argjson seconds "$seconds" '
        def counter:
            if . == null then null
            else (if type == "number" or type == "string" then tonumber else error("invalid counter") end)
                | if . >= 0 and floor == . then . else error("invalid counter") end
            end;
        if .t != $detail or (.host | type) != "array"
            or any(.. | objects; .status? == "error") then error("invalid traffic summary") else . end
        | [.host[]
            | if type != "object" then error("invalid host") else . end
            | select(.type != "others" and .type != "unregistered" and .type != "multicast")
            | if (.mac | type) != "string" then error("missing client MAC") else . end
            | if (.mac | test("^([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}$") | not)
                then error("invalid client MAC") else . end
            | (.rxbytes | counter) as $rx | (.txbytes | counter) as $tx
            | (.sumbytes | counter) as $sum
            | ($sum // (if $rx != null and $tx != null then $rx + $tx else null end)) as $total
            | if $total == null then error("missing traffic total") else . end
            | {name: (if (.name | type) == "string" and (.name | length) > 0 then .name else .mac end),
               mac: (.mac | ascii_downcase), ip: null, online: null,
               rx_bytes: $rx, tx_bytes: $tx, total_bytes: $total}
          ]
        | group_by(.mac) | map(max_by(.total_bytes))
        | sort_by([-.total_bytes, (.name | ascii_downcase), .mac]) | .[:$limit]
        | to_entries | map(.value + {rank: (.key + 1)})
        | {router: $router, period: $period, window_seconds: $seconds, limit: $limit, clients: .}
    ' "$TMP_DIR/traffic-summary.json" > "$TMP_DIR/client-traffic.json"; then
        fail "the router returned invalid $TRAFFIC_PERIOD traffic history; this firmware may not support the Traffic Monitor API"
    fi

    # Connection status comes from current links, not historical traffic activity.
    http_request GET /rci/show/ip/hotspot/host "$TMP_DIR/traffic-hosts.json"
    if [[ $HTTP_STATUS == 401 || $HTTP_STATUS == 403 ]]; then
        response_error 'failed to retrieve traffic client details' "$TMP_DIR/traffic-hosts.json"
    fi
    if [[ $HTTP_STATUS == 200 ]] && jq -e 'type == "array" and all(.[]; type == "object")' \
        "$TMP_DIR/traffic-hosts.json" >/dev/null 2>&1; then
        jq --slurpfile hosts "$TMP_DIR/traffic-hosts.json" '
            ($hosts[0] | map(select((.mac | type) == "string"))
                | group_by(.mac | ascii_downcase)
                | map({key: (.[0].mac | ascii_downcase), value: {
                    ip: ([.[].ip | select(type == "string" and length > 0)] | first // null),
                    online: (if any(.[]; .link == "up" or .mws.link? == "up") then true
                             elif any(.[]; .link == "down" or .mws.link? == "down") then false
                             else null end)
                }}) | from_entries) as $known
            | .clients |= map(.ip = $known[.mac].ip | .online = $known[.mac].online)
        ' "$TMP_DIR/client-traffic.json" > "$TMP_DIR/client-traffic-addresses.json"
        mv "$TMP_DIR/client-traffic-addresses.json" "$TMP_DIR/client-traffic.json"
    else
        warn "Traffic client details unavailable (HTTP $HTTP_STATUS)."
    fi
}

list_client_traffic() {
    jq -r --arg columns "$(terminal_columns)" --arg dim "$DIM" --arg reset "$RESET" \
        "$(table_format_filter)"'
        ($columns | tonumber | if . < 20 then 20 else . end) as $screen
        | (.clients | map({name: (.name | clean), ip: ((.ip // "-") | clean),
            rx: (.rx_bytes | bytes), tx: (.tx_bytes | bytes), total: (.total_bytes | bytes),
            status: (if .online == true then "online" elif .online == false then "offline" else "unknown" end)})) as $rows
        | ("Top \(.limit) clients · last " + (if .period == "3m" then "3 minutes"
            elif .period == "1h" then "1 hour" elif .period == "3h" then "3 hours" else "1 day" end)
            | wordwrap($screen)[]),
          (if $rows | length == 0 then "No client traffic recorded." | wordwrap($screen)[]
           else
            ($screen >= 72) as $wide
            | ($screen >= 32) as $inline_total
            | ([$rows[].status | width] + [6] | max) as $status_width
            | ([$rows[].rx | width] + [2] | max) as $rx_width
            | ([$rows[].tx | width] + [2] | max) as $tx_width
            | ([$rows[].total | width] + [5] | max) as $total_width
            | ([$rows[].ip | width] + [10] | max | . as $natural
                | [$natural, ($screen * 0.25 | floor)] | min) as $ip_width
            | ([$rows[].name | width] + [4] | max | . as $natural
                | [$natural, ($screen - $status_width - 2
                    - (if $inline_total then $total_width + 2 else 0 end)
                    - (if $wide then $ip_width + $rx_width + $tx_width + 6 else 0 end))]
                | min) as $name_width
            | def line($name; $ip; $rx; $tx; $total; $status):
                ($name | fit($name_width; false)) + "  "
                + (if $wide then ($ip | fit($ip_width; false)) + "  "
                    + ($rx | pad($rx_width; true)) + "  " + ($tx | pad($tx_width; true)) + "  " else "" end)
                + (if $inline_total then ($total | pad($total_width; true)) + "  " else "" end)
                + ($status | pad($status_width; false));
            $dim + line("NAME"; "IP ADDRESS"; "RX"; "TX"; "TOTAL"; "STATUS") + $reset,
            ($rows[] | line(.name; .ip; .rx; .tx; .total; .status),
                (if $wide then empty else (.ip, ("RX " + .rx + " / TX " + .tx))
                    | wordwrap($screen - 2)[] | "  " + . end),
                (if $inline_total then empty else "TOTAL " + .total | wordwrap($screen - 2)[] | "  " + . end))
           end)
    ' "$TMP_DIR/client-traffic.json"
}

fetch_client_summary() {
    printf 'null\n' > "$TMP_DIR/client-summary.json"
    http_request GET /rci/show/ip/hotspot/host "$TMP_DIR/status-clients.json"
    if [[ $HTTP_STATUS == 401 || $HTTP_STATUS == 403 ]]; then
        response_error 'failed to retrieve connected clients' "$TMP_DIR/status-clients.json"
    fi
    if [[ $HTTP_STATUS == 200 ]] && jq -e '
        type == "array" and all(.[]; type == "object" and
            (.mac | type == "string" and length > 0))
    ' "$TMP_DIR/status-clients.json" >/dev/null 2>&1; then
        if ! jq '
            def wifi:
                any([.ap, .mws.ap?][]; type == "string" and length > 0)
                or any([.ssid, .mws.ssid?][]; type == "string");
            [.[] | select(.link == "up" or .mws.link? == "up")]
            | group_by(.mac | ascii_downcase)
            | map(any(.[]; wifi))
            | {connected: length, wired: (map(select(. == false)) | length),
               wireless: (map(select(. == true)) | length)}
        ' "$TMP_DIR/status-clients.json" > "$TMP_DIR/client-summary.json"; then
            printf 'null\n' > "$TMP_DIR/client-summary.json"
        fi
    fi
    if [[ $(cat "$TMP_DIR/client-summary.json") == null ]]; then
        warn "Connected client counts unavailable (HTTP $HTTP_STATUS)."
    fi
    jq --slurpfile clients "$TMP_DIR/client-summary.json" '.clients = $clients[0]' \
        "$TMP_DIR/status.json" > "$TMP_DIR/status-with-clients.json"
    mv "$TMP_DIR/status-with-clients.json" "$TMP_DIR/status.json"
}

# Shared cell-aware formatting for non-interactive status and client tables.
table_format_filter() {
    cat <<'JQ'
        def clean: gsub("[[:cntrl:]]"; " ");
        # Terminal cell widths for common combining marks, CJK, and emoji.
        def width:
            explode | map(
                if (. >= 768 and . <= 879) or (. >= 65024 and . <= 65039) or . == 8205 then 0
                elif (. >= 4352 and . <= 4447) or (. >= 9001 and . <= 9002)
                    or (. >= 11904 and . <= 42191) or (. >= 44032 and . <= 55203)
                    or (. >= 63744 and . <= 64255) or (. >= 65040 and . <= 65049)
                    or (. >= 65072 and . <= 65135) or (. >= 65281 and . <= 65376)
                    or (. >= 65504 and . <= 65510) or (. >= 127744 and . <= 129791)
                    or (. >= 131072 and . <= 262141) then 2 else 1 end
            ) | add // 0;
        def wrap($limit):
            reduce (explode[] | [.] | implode) as $char
                ({lines: [], text: "", size: 0};
                 ($char | width) as $size
                 | if .size + $size > $limit then
                       .lines += [.text] | .text = $char | .size = $size
                   else .text += $char | .size += $size end)
            | .lines + [.text];
        def wordwrap($limit):
            reduce (split(" ")[]) as $word ({lines: [], text: ""};
                (.text + (if .text == "" then "" else " " end) + $word) as $next
                | if ($next | width) <= $limit then .text = $next
                  else (if .text == "" then . else .lines += [.text] end)
                    | ($word | wrap($limit)) as $parts
                    | .lines += $parts[0:-1] | .text = $parts[-1] end)
            | .lines + [.text];
        def pad($size; $right):
            . as $text | (" " * ([$size - width, 0] | max)) as $space
            | if $right then $space + $text else $text + $space end;
        def fit($size; $right):
            (if width > $size then (wrap($size - 1)[0] + "…") else . end)
            | pad($size; $right);
        def bytes:
            if . == null then "unavailable"
            else . as $value
                | [0, 1, 2, 3, 4, 5, 6]
                | map(select($value >= pow(1024; .))) | (last // 0) as $unit
                | (($value / pow(1024; $unit) * 10 | round) / 10 | tostring)
                  + " " + ["B", "KiB", "MiB", "GiB", "TiB", "PiB", "EiB"][$unit]
            end;
        def duration:
            if . == null then "unknown" else floor as $s
                | "\($s / 86400 | floor)d \(($s % 86400) / 3600 | floor)h \(($s % 3600) / 60 | floor)m \($s % 60)s" end;
JQ
}

list_interface_status() {
    jq -r --arg columns "$(terminal_columns)" \
        --argjson summary "${1:-true}" --argjson menu "${2:-false}" \
        --arg green "$GREEN" --arg yellow "$YELLOW" --arg dim "$DIM" --arg reset "$RESET" "$(table_format_filter)"'
        def status_color:
            if $menu then ""
            elif . == "connected" or . == "link up" then $green
            elif . == "disconnected" or . == "link down" then $yellow
            else $dim end;
        ($columns | tonumber | if . < 20 then 20 else . end | . - (if $menu then 4 else 0 end)) as $screen
        | . as $router
        | (if $summary then [
            {label: "Router", value: .router},
            {label: "KeenDNS", value: (if .keendns == null then "unavailable"
                elif .keendns.hostname == null then "not configured"
                else .keendns.hostname + (if .keendns.access == null then "" else " (" + .keendns.access + ")" end) end)},
            {label: "Connected clients", value: (if .clients == null then "unavailable"
             else "\(.clients.connected) (\(.clients.wired) wired / \(.clients.wireless) wireless)" end)}
          ] as $info
          | ([$info[].label | width] + [11] | max) as $label_width
          | if $screen >= 40 then
              $dim + ("ROUTER INFO" | pad($label_width; false)) + "  VALUE" + $reset,
              ($info[] | .label as $field_label
                | (.value | clean | wordwrap($screen - $label_width - 2))
                | to_entries[]
                | ((if .key == 0 then $field_label else "" end) | pad($label_width; false))
                  + "  " + .value)
            else
              $dim + "ROUTER INFO" + $reset,
              ($info[] | .label, (.value | clean | wordwrap($screen - 2)[] | "  " + .))
            end else empty end),
          ($router |
        [.interfaces | to_entries[] | .key as $index | .value | {
            index: $index, vpn, status,
            name: ([.id, (.description | select(length > 0)),
                    (if .type == "" then empty else "[" + .type + "]" end)] | join(" ") | clean),
            addresses: (([.ipv4 // empty] + [.ipv6[] | .address +
                (if .prefix_length == null then "" else "/" + (.prefix_length | tostring) end)])
                | if length == 0 then ["-"] else . end | map(clean)),
            rx: (.traffic.rx_bytes | bytes), tx: (.traffic.tx_bytes | bytes)
        }] as $rows
        | ($screen >= 72) as $wide
        | ([$rows[].status | width] + [6] | max) as $status_width
        | ([$rows[].rx | width] + [2] | max) as $rx_width
        | ([$rows[].tx | width] + [2] | max) as $tx_width
        | ($screen - $status_width - $rx_width - $tx_width - 8) as $remaining
        | ([$remaining * 0.5 | floor, 10] | max) as $ip_width
        | (if $wide then $remaining - $ip_width else $screen - $status_width - 2 end) as $name_width
        | def line($name; $status; $ip; $rx; $tx; $color):
            ($name | fit($name_width; false)) + "  "
            + $color + ($status | fit($status_width; false)) + (if $color == "" then "" else $reset end)
            + (if $wide then "  " + ($ip | fit($ip_width; false))
                + "  " + ($rx | fit($rx_width; true)) + "  " + ($tx | fit($tx_width; true)) else "" end);
        if $menu then
            $rows[] | (.index | tostring) + "\t"
                + line(.name; .status; (.addresses | join(", ")); .rx; .tx; "")
        else (true, false) as $vpn
        | (if $summary or ($vpn | not) then "" else empty end),
          ((if $vpn then "VPN / proxy interfaces" else "Other interfaces" end) | wordwrap($screen)[]),
          ([$rows[] | select(.vpn == $vpn)] as $section
            | if $section | length == 0 then "  None"
              else $dim + line("INTERFACE / NAME"; "STATUS"; "IP ADDRESS"; "RX"; "TX"; "") + $reset,
                ($section[] |
                    line(.name; .status; (.addresses | join(", ")); .rx; .tx; (.status | status_color)),
                    (if $wide then empty else
                        ((.addresses | join(", ")), ("RX " + .rx + " / TX " + .tx))
                        | wordwrap($screen - 2)[] | "  " + .
                     end))
              end) end
          )
    ' "$TMP_DIR/status.json"
}

fetch_router_state() {
    api_get /rci/show/ip/hotspot/host "$TMP_DIR/clients.json" 'clients' array
    api_get /rci/show/rc/ip/hotspot/host "$TMP_DIR/assignments.json" 'client policies' array
    api_get /rci/show/rc/ip/policy "$TMP_DIR/policies.json" 'policies' object

    if ! jq -n \
        --slurpfile clients "$TMP_DIR/clients.json" \
        --slurpfile assignments "$TMP_DIR/assignments.json" '
        ($assignments[0]
            | map(select(.mac != null) | {key: (.mac | ascii_downcase), value: .})
            | from_entries) as $by_mac
        | [$clients[0][]
            | . as $client
            | (($client.mac // "") | ascii_downcase) as $mac
            | ($by_mac[$mac] // {}) as $assignment
            | {
                name: ($client.name // "Unknown"),
                ip: ($client.ip // "N/A"),
                mac: $mac,
                policy: ($assignment.policy // null),
                deny: ($assignment.deny // false),
                online: (.link == "up" or .mws.link? == "up")
              }
          ]' > "$TMP_DIR/all-clients.json"; then
        fail 'could not combine the client and policy data returned by the router'
    fi
    case $VIEW_MODE in
        connected) jq '[.[] | select(.online)]' "$TMP_DIR/all-clients.json" > "$TMP_DIR/clients-view.json" ;;
        offline) jq '[.[] | select(.online | not)]' "$TMP_DIR/all-clients.json" > "$TMP_DIR/clients-view.json" ;;
        all) cp "$TMP_DIR/all-clients.json" "$TMP_DIR/clients-view.json" ;;
    esac
    cp "$TMP_DIR/clients-view.json" "$TMP_DIR/connected.json"
    debug "Router: $ROUTER_URL"
    debug "Local address: ${ROUTER_LOCAL_IP:-unknown}"
    debug "Clients: $(jq 'length' "$TMP_DIR/all-clients.json") total, $(jq '[.[] | select(.online)] | length' "$TMP_DIR/all-clients.json") online"
    debug "Policies: $(jq '[to_entries[] | select(.value.description? != null)] | length' "$TMP_DIR/policies.json")"
}

detect_current_client() {
    local address_file local_mac
    CURRENT_CLIENT_MAC=
    if [[ -n $ROUTER_LOCAL_IP ]]; then
        CURRENT_CLIENT_MAC=$(jq -r --arg ip "$ROUTER_LOCAL_IP" \
            'first(.[] | select(.ip == $ip) | .mac) // empty' "$TMP_DIR/connected.json")
    fi
    [[ -z $CURRENT_CLIENT_MAC ]] || return 0

    for address_file in /sys/class/net/*/address; do
        [[ -r $address_file ]] || continue
        IFS= read -r local_mac < "$address_file" || continue
        local_mac=${local_mac,,}
        [[ $local_mac != 00:00:00:00:00:00 ]] || continue
        if jq -e --arg mac "$local_mac" 'any(.[]; .mac == $mac)' "$TMP_DIR/connected.json" >/dev/null; then
            CURRENT_CLIENT_MAC=$local_mac
            return 0
        fi
    done
}

terminal_columns() {
    local columns=${COLUMNS:-}
    if [[ ! $columns =~ ^[0-9]+$ ]] && [[ -t 2 ]] && command -v tput >/dev/null 2>&1; then
        columns=$(tput cols 2>/dev/null || true)
    fi
    [[ $columns =~ ^[0-9]+$ ]] || columns=80
    printf '%s' "$columns"
}

shorten_text() {
    local text=$1 width=$2
    local text_width=$width
    # Bash has no wcwidth(3). A conservative half-width limit guarantees that
    # double-width CJK and emoji do not spill into the next column.
    if [[ $text == *[![:ascii:]]* ]]; then
        text_width=$((width / 2))
        ((text_width >= 2)) || text_width=2
    fi
    if ((${#text} > text_width)); then
        printf '%s~' "${text:0:text_width - 1}"
    else
        printf '%s' "$text"
    fi
}

compute_client_widths() {
    local prefix_width=$1 columns available
    columns=$(terminal_columns)
    ((columns >= 32)) || fail 'terminal is too narrow; at least 32 columns are required'
    available=$((columns - prefix_width))
    CLIENT_IP_WIDTH=$((available / 4))
    ((CLIENT_IP_WIDTH < 7)) && CLIENT_IP_WIDTH=7
    ((CLIENT_IP_WIDTH > 15)) && CLIENT_IP_WIDTH=15
    CLIENT_POLICY_WIDTH=$((available / 4))
    ((CLIENT_POLICY_WIDTH < 8)) && CLIENT_POLICY_WIDTH=8
    ((CLIENT_POLICY_WIDTH > 18)) && CLIENT_POLICY_WIDTH=18
    CLIENT_NAME_WIDTH=$((available - CLIENT_IP_WIDTH - CLIENT_POLICY_WIDTH - 2))
    ((CLIENT_NAME_WIDTH >= 8)) || fail 'terminal is too narrow to display the client selector'
    ((CLIENT_NAME_WIDTH <= 36)) || CLIENT_NAME_WIDTH=36
}

# shellcheck disable=SC2016 # The dollar expression belongs to jq.
policy_label_filter='
    if .deny then
        "Blocked"
    elif .policy == null or .policy == false then
        "Default"
    else
        ($policies[0][(.policy | tostring)].description // (.policy | tostring))
    end
'

list_clients_table() {
    local empty_message='No connected clients found.'
    [[ $VIEW_MODE == offline ]] && empty_message='No offline clients found.'
    [[ $VIEW_MODE == all ]] && empty_message='No known clients found.'
    if ! jq -e 'length > 0' "$TMP_DIR/connected.json" >/dev/null; then
        printf '%s\n' "$empty_message"
        return 0
    fi
    jq -r --slurpfile policies "$TMP_DIR/policies.json" \
        --arg columns "$(terminal_columns)" --arg current "$CURRENT_CLIENT_MAC" \
        --arg green "$GREEN" --arg dim "$DIM" --arg reset "$RESET" \
        "$(table_format_filter) def policy_label: $policy_label_filter;"'
        ($columns | tonumber | if . < 20 then 20 else . end) as $screen
        | [sort_by([if .online then 0 else 1 end, (.name | ascii_downcase)])[]
            | (.mac == $current and $current != "") as $this_device
            | {
                name: ((if $this_device then "* " + .name + " (this device)"
                        else .name end) | clean),
                ip: (.ip | clean), policy: (policy_label | clean), current: $this_device,
                status: (if .online then "online" else "offline" end)
            }] as $rows
        | ($screen >= 72) as $wide
        | ($screen >= 32) as $inline_policy
        | ([$rows[].status | width] + [6] | max) as $status_width
        | ([$rows[].ip | width] + [10] | max | . as $natural
            | [$natural, ($screen * 0.3 | floor)] | min) as $ip_width
        | ([$rows[].policy | width] + [6] | max | . as $natural
            | [$natural, ([$screen * 0.25 | floor, 6] | max)] | min) as $policy_width
        | ([$rows[].name | width] + [4] | max | . as $natural
            | [$natural, ($screen - $status_width - 2
                - (if $inline_policy then $policy_width + 2 else 0 end)
                - (if $wide then $ip_width + 2 else 0 end))]
            | min) as $name_width
        | def line($name; $ip; $policy; $status):
            ($name | fit($name_width; false)) + "  "
            + (if $wide then ($ip | fit($ip_width; false)) + "  " else "" end)
            + (if $inline_policy then ($policy | fit($policy_width; false)) + "  " else "" end)
            + ($status | pad($status_width; false));
        $dim + line("NAME"; "IP ADDRESS"; "POLICY"; "STATUS") + $reset,
        ($rows[] | (if .current then $green else "" end)
            + line(.name; .ip; .policy; .status) + (if .current then $reset else "" end),
            (if $wide then empty else .ip | wordwrap($screen - 2)[] | "  " + . end),
            (if $inline_policy then empty else "Policy: " + .policy | wordwrap($screen - 2)[] | "  " + . end))
    ' "$TMP_DIR/connected.json"
}

list_clients_json() {
    jq --slurpfile policies "$TMP_DIR/policies.json" \
        "sort_by([if .online then 0 else 1 end, (.name | ascii_downcase)])
        | map({
            name,
            ip,
            mac,
            online,
            blocked: .deny,
            policy: ($policy_label_filter),
            policy_id: (if .deny or .policy == null or .policy == false then null else (.policy | tostring) end)
          })" "$TMP_DIR/connected.json"
}

format_menu_option() {
    local index=$1 columns name ip policy status fitted_name fitted_ip fitted_policy option_width
    if [[ $MENU_KIND == interface ]]; then
        printf '%s' "${MENU_OPTIONS[index]}"
    elif [[ $MENU_KIND == client ]]; then
        IFS=$'\t' read -r name ip policy status <<< "${MENU_OPTIONS[index]}"
        [[ $status == online ]] || name="$name (offline)"
        compute_client_widths 4
        fitted_name=$(shorten_text "$name" "$CLIENT_NAME_WIDTH")
        fitted_ip=$(shorten_text "$ip" "$CLIENT_IP_WIDTH")
        fitted_policy=$(shorten_text "$policy" "$CLIENT_POLICY_WIDTH")
        printf "%-${CLIENT_NAME_WIDTH}s %-${CLIENT_IP_WIDTH}s %-${CLIENT_POLICY_WIDTH}s" \
            "$fitted_name" "$fitted_ip" "$fitted_policy"
    else
        columns=$(terminal_columns)
        ((columns >= 20)) || fail 'terminal is too narrow to display the policy selector'
        option_width=$((columns - 6))
        shorten_text "${MENU_OPTIONS[index]}" "$option_width"
    fi
}

render_arrow_menu() {
    local selected=$1 redraw=$2 count=${#MENU_OPTIONS[@]} index marker style option
    if [[ $MENU_KIND == interface ]]; then
        mapfile -t MENU_OPTIONS < <(list_interface_status false true | cut -f2-)
    fi
    if $redraw; then
        printf '\033[%dA' "$count" >&2
    fi

    for ((index = 0; index < count; index++)); do
        marker=' '
        style=
        if ((index == MENU_CURRENT_INDEX)); then
            marker='*'
            style=$DIM
        fi
        option=$(format_menu_option "$index")
        if ((index == selected)); then
            printf '\r\033[2K%s> %s %s%s\n' "$HIGHLIGHT" "$marker" "$option" "$RESET" >&2
        else
            printf '\r\033[2K%s  %s %s%s\n' "$style" "$marker" "$option" "$RESET" >&2
        fi
    done
}

finish_arrow_menu() {
    show_cursor
}

arrow_menu() {
    local subject=$1 count=${#MENU_OPTIONS[@]} selected=0 key suffix
    ((count > 0)) || fail "no $subject options are available"
    [[ -t 0 && -t 2 ]] || fail "interactive $subject selection requires a terminal"
    if ((MENU_CURRENT_INDEX >= 0)); then
        selected=$MENU_CURRENT_INDEX
    fi

    CURSOR_HIDDEN=true
    MENU_RESIZED=false
    trap 'MENU_RESIZED=true' WINCH
    printf '\033[?25l' >&2
    printf 'Use Up/Down arrows, Enter to select, or Esc/q to cancel.\n' >&2
    render_arrow_menu "$selected" false
    while true; do
        if ! IFS= read -rsn1 -t 0.2 key; then
            if $MENU_RESIZED; then
                MENU_RESIZED=false
                render_arrow_menu "$selected" true
            fi
            continue
        fi
        if [[ $key == $'\033' ]]; then
            suffix=
            IFS= read -rsn2 -t 0.1 suffix || true
            key+=$suffix
        fi

        case $key in
            $'\033[A'|k)
                selected=$(((selected + count - 1) % count))
                ;;
            $'\033[B'|j)
                selected=$(((selected + 1) % count))
                ;;
            '')
                SELECTED_INDEX=$((selected + 1))
                trap - WINCH
                finish_arrow_menu
                return 0
                ;;
            q|Q|$'\033')
                trap - WINCH
                finish_arrow_menu
                return 1
                ;;
            *)
                continue
                ;;
        esac
        render_arrow_menu "$selected" true
    done
}

fzf_client_rows() {
    local name ip mac policy online display_name fitted_name fitted_ip fitted_policy status index=0
    while IFS=$'\t' read -r name ip mac policy online; do
        display_name=$name
        [[ -z $CURRENT_CLIENT_MAC || $mac != "$CURRENT_CLIENT_MAC" ]] \
            || display_name+=" (this device)"
        fitted_name=$(shorten_text "$display_name" "$CLIENT_NAME_WIDTH")
        fitted_ip=$(shorten_text "$ip" "$CLIENT_IP_WIDTH")
        fitted_policy=$(shorten_text "$policy" "$CLIENT_POLICY_WIDTH")
        status=offline
        [[ $online == true ]] && status=online
        printf "%d\t%-${CLIENT_NAME_WIDTH}s %-${CLIENT_IP_WIDTH}s %-${CLIENT_POLICY_WIDTH}s %-7s\n" \
            "$index" "$fitted_name" "$fitted_ip" "$fitted_policy" "$status"
        index=$((index + 1))
    done < <(
        jq -r --slurpfile policies "$TMP_DIR/policies.json" \
            ".[] | [.name, .ip, .mac, ($policy_label_filter), .online] | @tsv" \
            "$TMP_DIR/menu-clients.json"
    )
}

select_client_from_candidates() {
    local candidates=$1 heading=$2 count name ip mac policy online display_name index=0 selected selected_index header
    count=$(jq 'length' <<< "$candidates")
    ((count > 0)) || fail "$EXIT_CLIENT" 'no matching clients found'
    jq --arg current "$CURRENT_CLIENT_MAC" \
        'sort_by([if .mac == $current then 0 else 1 end, if .online then 0 else 1 end, (.name | ascii_downcase), .ip])' \
        <<< "$candidates" > "$TMP_DIR/menu-clients.json"

    if [[ -t 0 && -t 2 ]] && command -v "$FZF_COMMAND" >/dev/null 2>&1; then
        compute_client_widths 12
        printf -v header "%-${CLIENT_NAME_WIDTH}s %-${CLIENT_IP_WIDTH}s %-${CLIENT_POLICY_WIDTH}s %-7s" \
            'NAME' 'IP' 'POLICY' 'STATUS'
        selected=$(
            fzf_client_rows \
            | "$FZF_COMMAND" --delimiter=$'\t' --with-nth=2.. --height=70% --layout=reverse \
                --prompt='Client> ' --header="$heading"$'\n'"$header"
        ) || {
            unchanged 'No changes made.'
            return 1
        }
        selected_index=${selected%%$'\t'*}
        SELECTED_CLIENT=$(jq -c --argjson index "$selected_index" '.[$index]' "$TMP_DIR/menu-clients.json")
        return 0
    fi

    MENU_OPTIONS=()
    MENU_CURRENT_INDEX=-1
    MENU_KIND=client
    while IFS=$'\t' read -r name ip mac policy online; do
        display_name=$name
        if [[ -n $CURRENT_CLIENT_MAC && $mac == "$CURRENT_CLIENT_MAC" ]]; then
            display_name+=" (this device)"
            MENU_CURRENT_INDEX=$index
        fi
        MENU_OPTIONS+=("$display_name"$'\t'"$ip"$'\t'"$policy"$'\t'"$([[ $online == true ]] && printf online || printf offline)")
        index=$((index + 1))
    done < <(
        jq -r --slurpfile policies "$TMP_DIR/policies.json" \
            ".[] | [.name, .ip, .mac, ($policy_label_filter), .online] | @tsv" \
            "$TMP_DIR/menu-clients.json"
    )

    printf '%s\n\n' "$heading" >&2
    if ! arrow_menu client; then
        unchanged 'No changes made.'
        return 1
    fi
    SELECTED_CLIENT=$(jq -c --argjson index "$((SELECTED_INDEX - 1))" \
        '.[$index]' "$TMP_DIR/menu-clients.json")
}

resolve_client() {
    local selector=$1 value=$2 allow_prompt=$3 matches count label
    local pool=$TMP_DIR/connected.json
    [[ $ACTION == wake ]] && pool=$TMP_DIR/all-clients.json
    case $selector in
        client)
            label="name '$value'"
            matches=$(jq --arg value "$value" \
                '[.[] | select((.name | ascii_downcase) == ($value | ascii_downcase))]' "$pool")
            ;;
        ip)
            label="IP '$value'"
            matches=$(jq --arg value "$value" '[.[] | select(.ip == $value)]' "$pool")
            ;;
        mac)
            label="MAC '$value'"
            matches=$(jq --arg value "${value,,}" '[.[] | select(.mac == $value)]' "$pool")
            ;;
        *)
            fail "unknown client selector: $selector"
            ;;
    esac
    count=$(jq 'length' <<< "$matches")

    if ((count == 0)); then
        fail "$EXIT_CLIENT" "no client in the selected view has $label
Use --all to include offline clients."
    elif ((count == 1)); then
        SELECTED_CLIENT=$(jq -c '.[0]' <<< "$matches")
    elif $allow_prompt; then
        select_client_from_candidates "$matches" "Multiple clients match $label:" || return 1
    else
        printf 'Multiple clients match %s:\n' "$label" >&2
        jq -r 'sort_by(.ip)[] | "  \(.name)  \(.ip)  \(.mac)"' <<< "$matches" >&2
        fail "$EXIT_CLIENT" "client selector is ambiguous; use --ip or --mac"
    fi
}

select_any_client() {
    local clients heading='Connected clients:'
    clients=$(cat "$TMP_DIR/connected.json")
    [[ $VIEW_MODE == all ]] && heading='Known clients:'
    [[ $VIEW_MODE == offline ]] && heading='Offline clients:'
    select_client_from_candidates "$clients" "$heading"
}

client_policy_id() {
    jq -r 'if .deny then "__block__" elif .policy == null or .policy == false then "__default__" else (.policy | tostring) end' \
        <<< "$1"
}

client_policy_label() {
    jq -r --slurpfile policies "$TMP_DIR/policies.json" "$policy_label_filter" <<< "$1"
}

load_policy_options() {
    POLICY_IDS=('__default__' '__block__')
    POLICY_LABELS=('Default' 'Block Internet')
    local id label
    while IFS=$'\t' read -r id label; do
        POLICY_IDS+=("$id")
        POLICY_LABELS+=("$label")
    done < <(
        jq -r 'to_entries
            | sort_by(.value.description // .key)
            | .[]
            | [.key, (.value.description // .key)]
            | @tsv' "$TMP_DIR/policies.json"
    )
}

choose_policy_interactively() {
    local client=$1 name ip current_id current_label index option selected selected_id
    name=$(jq -r '.name' <<< "$client")
    ip=$(jq -r '.ip' <<< "$client")
    current_id=$(client_policy_id "$client")
    current_label=$(client_policy_label "$client")
    load_policy_options

    if [[ -t 0 && -t 2 ]] && command -v "$FZF_COMMAND" >/dev/null 2>&1; then
        selected=$(
            {
                for ((index = 0; index < ${#POLICY_IDS[@]}; index++)); do
                    [[ ${POLICY_IDS[index]} == "$current_id" ]] || continue
                    printf '%s\t%s (current)\n' "${POLICY_IDS[index]}" "${POLICY_LABELS[index]}"
                done
                for ((index = 0; index < ${#POLICY_IDS[@]}; index++)); do
                    [[ ${POLICY_IDS[index]} != "$current_id" ]] || continue
                    printf '%s\t%s\n' "${POLICY_IDS[index]}" "${POLICY_LABELS[index]}"
                done
            } | "$FZF_COMMAND" --delimiter=$'\t' --with-nth=2.. --height=70% --layout=reverse \
                --prompt='Policy> ' --header="Client: $name ($ip) | Current: $current_label"
        ) || {
            unchanged 'No changes made.'
            return 1
        }
        selected_id=${selected%%$'\t'*}
        for ((index = 0; index < ${#POLICY_IDS[@]}; index++)); do
            if [[ ${POLICY_IDS[index]} == "$selected_id" ]]; then
                SELECTED_POLICY_ID=$selected_id
                SELECTED_POLICY_LABEL=${POLICY_LABELS[index]}
                return 0
            fi
        done
        fail 'fzf returned an unknown policy selection'
    fi

    MENU_OPTIONS=()
    MENU_CURRENT_INDEX=-1
    MENU_KIND=policy
    for ((index = 0; index < ${#POLICY_IDS[@]}; index++)); do
        option=${POLICY_LABELS[index]}
        if [[ ${POLICY_IDS[index]} == "$current_id" ]]; then
            option+=" (current)"
            MENU_CURRENT_INDEX=$index
        fi
        MENU_OPTIONS+=("$option")
    done

    printf 'Client: %s (%s)\n' "$name" "$ip" >&2
    printf 'Current policy: %s\n\n' "$current_label" >&2
    if ! arrow_menu policy; then
        unchanged 'No changes made.'
        return 1
    fi
    SELECTED_POLICY_ID=${POLICY_IDS[SELECTED_INDEX - 1]}
    SELECTED_POLICY_LABEL=${POLICY_LABELS[SELECTED_INDEX - 1]}
}

resolve_policy() {
    local query=$1 matches count
    if [[ ${query,,} == default ]]; then
        SELECTED_POLICY_ID=__default__
        SELECTED_POLICY_LABEL=Default
        return 0
    fi

    matches=$(jq --arg query "$query" \
        '[to_entries[] | select((.key | ascii_downcase) == ($query | ascii_downcase))]' \
        "$TMP_DIR/policies.json")
    count=$(jq 'length' <<< "$matches")
    if ((count == 0)); then
        matches=$(jq --arg query "$query" \
            '[to_entries[] | select(((.value.description // .key) | ascii_downcase) == ($query | ascii_downcase))]' \
            "$TMP_DIR/policies.json")
        count=$(jq 'length' <<< "$matches")
    fi

    if ((count == 0)); then
        printf 'Available policies:\n  Default\n' >&2
        jq -r 'to_entries | sort_by(.value.description // .key)[] | "  \(.value.description // .key) [\(.key)]"' \
            "$TMP_DIR/policies.json" >&2
        fail "$EXIT_POLICY" "unknown policy: $query"
    elif ((count > 1)); then
        fail "$EXIT_POLICY" "policy description is ambiguous: $query; use its policy ID instead"
    fi

    SELECTED_POLICY_ID=$(jq -r '.[0].key' <<< "$matches")
    SELECTED_POLICY_LABEL=$(jq -r '.[0].value.description // .[0].key' <<< "$matches")
}

verify_client_state() {
    local mac=$1 expected=$2 target_label=$3 delay attempt=0 assignment actual last_label=Unknown
    local -a delays=(0 0.25 0.25 0.5)
    for delay in "${delays[@]}"; do
        [[ $delay == 0 ]] || sleep "$delay"
        attempt=$((attempt + 1))
        api_get /rci/show/rc/ip/hotspot/host "$TMP_DIR/verify-assignments-$attempt.json" 'client policies' array
        assignment=$(jq -c --arg mac "$mac" \
            'first(.[] | select((.mac // "" | ascii_downcase) == $mac)) // empty' \
            "$TMP_DIR/verify-assignments-$attempt.json")
        if [[ -n $assignment ]]; then
            actual=$(jq -c '{policy: (.policy // false), deny: (.deny // false)}' <<< "$assignment")
        else
            actual='{"policy":false,"deny":false}'
        fi
        if jq -e --argjson expected "$expected" \
            '(.deny == $expected.deny) and (.policy == $expected.policy)' <<< "$actual" >/dev/null; then
            debug "Verification: $target_label observed on attempt $attempt"
            return 0
        fi
        last_label=$(client_policy_label "$actual")
    done
    fail "$EXIT_VERIFY" \
        "router still reported \"$last_label\" after applying \"$target_label\" (4 checks over 1 second)"
}

history_state() {
    jq -c '{policy: (.policy // false), deny: (.deny // false)}' <<< "$1"
}

record_history() {
    local client=$1 before=$2 after=$3 action=$4 directory temporary entry existing='[]'
    directory=${HISTORY_FILE%/*}
    [[ $directory == "$HISTORY_FILE" ]] && directory=.
    mkdir -p -- "$directory"
    chmod 700 "$directory"
    if [[ -e $HISTORY_FILE ]]; then
        jq -e 'type == "array"' "$HISTORY_FILE" >/dev/null \
            || fail "rollback history is not a JSON array: $HISTORY_FILE"
        existing=$(cat "$HISTORY_FILE")
    fi
    entry=$(jq -nc \
        --arg router "$ROUTER_URL" \
        --arg mac "$(jq -r '.mac' <<< "$client")" \
        --arg name "$(jq -r '.name' <<< "$client")" \
        --arg action "$action" \
        --arg timestamp "$(date -u +'%Y-%m-%dT%H:%M:%SZ')" \
        --argjson before "$before" \
        --argjson after "$after" \
        '{router:$router, mac:$mac, name:$name, action:$action, timestamp:$timestamp, before:$before, after:$after}')
    temporary=$(mktemp "$directory/.history.XXXXXX")
    jq --argjson entry "$entry" '. + [$entry] | if length > 20 then .[-20:] else . end' \
        <<< "$existing" > "$temporary"
    chmod 600 "$temporary"
    mv -f -- "$temporary" "$HISTORY_FILE"
    debug "Rollback history: recorded $action for $(jq -r '.mac' <<< "$client")"
}

action_description() {
    local client=$1 name
    name=$(jq -r '.name' <<< "$client")
    case $ACTION in
        policy) printf 'set %s to policy "%s"' "$name" "$SELECTED_POLICY_LABEL" ;;
        block) printf 'block Internet for %s' "$name" ;;
        unblock) printf 'unblock Internet for %s' "$name" ;;
        wake) printf 'wake %s' "$name" ;;
    esac
}

apply_client_action() {
    local client=$1 action=$2 record=${3:-true}
    local name mac before current_id current_policy payload expected target_label success_message
    name=$(jq -r '.name' <<< "$client")
    mac=$(jq -r '.mac' <<< "$client")
    before=$(history_state "$client")
    current_id=$(client_policy_id "$client")
    current_policy=$(jq -c '.policy // false' <<< "$client")

    case $action in
        policy)
            target_label=$SELECTED_POLICY_LABEL
            if [[ $current_id == "$SELECTED_POLICY_ID" ]]; then
                unchanged "$name already uses $SELECTED_POLICY_LABEL. No changes made."
                return 0
            fi
            if [[ $SELECTED_POLICY_ID == __default__ ]]; then
                expected='{"policy":false,"deny":false}'
                payload=$(jq -nc --arg mac "$mac" \
                    '{mac:$mac, policy:false, permit:true, schedule:false}')
            else
                expected=$(jq -nc --arg policy "$SELECTED_POLICY_ID" \
                    '{policy:$policy, deny:false}')
                payload=$(jq -nc --arg mac "$mac" --arg policy "$SELECTED_POLICY_ID" \
                    '{mac:$mac, policy:$policy, permit:true, schedule:false}')
            fi
            success_message="Applied and verified policy \"$target_label\" for $name."
            ;;
        block)
            target_label='Blocked'
            if jq -e '.deny' <<< "$before" >/dev/null; then
                unchanged "$name is already blocked. No changes made."
                return 0
            fi
            expected=$(jq -nc --argjson policy "$current_policy" '{policy:$policy, deny:true}')
            payload=$(jq -nc --arg mac "$mac" '{mac:$mac, schedule:false, deny:true}')
            success_message="Blocked Internet access for $name and verified it."
            ;;
        unblock)
            target_label=$(client_policy_label "$(jq -c '.deny = false' <<< "$client")")
            if ! jq -e '.deny' <<< "$before" >/dev/null; then
                unchanged "$name is not blocked. No changes made."
                return 0
            fi
            expected=$(jq -nc --argjson policy "$current_policy" '{policy:$policy, deny:false}')
            payload=$(jq -nc --arg mac "$mac" --argjson policy "$current_policy" \
                '{mac:$mac, policy:$policy, permit:true, schedule:false}')
            success_message="Unblocked Internet access for $name and verified it."
            ;;
        *)
            fail "unsupported client action: $action"
            ;;
    esac

    if $DRY_RUN; then
        printf 'Would %s.\n' "$(action_description "$client")"
        return 0
    fi
    http_request POST /rci/ip/hotspot/host "$TMP_DIR/apply-result.json" "$payload"
    [[ $HTTP_STATUS == 200 ]] || response_error "failed to $action client" "$TMP_DIR/apply-result.json"
    verify_client_state "$mac" "$expected" "$target_label"
    $record && record_history "$client" "$before" "$expected" "$action"
    success "$success_message"
}

wake_client() {
    local client=$1 name mac payload detail
    name=$(jq -r '.name' <<< "$client")
    mac=$(jq -r '.mac' <<< "$client")
    if $DRY_RUN; then
        printf 'Would wake %s (%s).\n' "$name" "$mac"
        return 0
    fi
    payload=$(jq -nc --arg mac "$mac" '{mac:$mac}')
    http_request POST /rci/ip/hotspot/wake "$TMP_DIR/wake-result.json" "$payload"
    [[ $HTTP_STATUS == 200 ]] || response_error 'failed to send Wake-on-LAN' "$TMP_DIR/wake-result.json"
    detail=$(jq -r 'if type == "string" then . elif type == "object" then (.message // .result // tostring) else tostring end' \
        "$TMP_DIR/wake-result.json" 2>/dev/null || cat "$TMP_DIR/wake-result.json")
    success "Wake-on-LAN request for $name: $detail"
}

preflight_clients() {
    local index existing mac duplicate
    SELECTED_CLIENTS=()
    for ((index = 0; index < ${#CLIENT_SELECTORS[@]}; index++)); do
        resolve_client "${CLIENT_SELECTORS[index]}" "${CLIENT_VALUES[index]}" false
        mac=$(jq -r '.mac' <<< "$SELECTED_CLIENT")
        duplicate=false
        for existing in "${SELECTED_CLIENTS[@]}"; do
            [[ $(jq -r '.mac' <<< "$existing") == "$mac" ]] && duplicate=true
        done
        $duplicate || SELECTED_CLIENTS+=("$SELECTED_CLIENT")
    done
}

run_selected_actions() {
    local client index total=${#SELECTED_CLIENTS[@]}
    if ((total > 1)) || $DRY_RUN; then
        printf 'Plan (%d client%s):\n' "$total" "$([[ $total == 1 ]] || printf s)"
        for client in "${SELECTED_CLIENTS[@]}"; do
            printf '  - %s\n' "$(action_description "$client")"
        done
    fi
    for ((index = 0; index < total; index++)); do
        client=${SELECTED_CLIENTS[index]}
        if ((total > 1)); then
            OPERATION_CONTEXT="batch item $((index + 1))/$total ($(jq -r '.name' <<< "$client"); $index already completed)"
        fi
        if [[ $ACTION == wake ]]; then
            wake_client "$client"
        else
            apply_client_action "$client" "$ACTION"
        fi
        OPERATION_CONTEXT=
    done
}

remove_history_entry() {
    local index=$1 directory temporary
    directory=${HISTORY_FILE%/*}
    [[ $directory == "$HISTORY_FILE" ]] && directory=.
    temporary=$(mktemp "$directory/.history.XXXXXX")
    jq --argjson index "$index" 'del(.[$index])' "$HISTORY_FILE" > "$temporary"
    chmod 600 "$temporary"
    mv -f -- "$temporary" "$HISTORY_FILE"
}

undo_last_action() {
    local index entry mac name before client current payload target_label
    [[ -r $HISTORY_FILE ]] || fail 'no rollback history is available'
    jq -e 'type == "array"' "$HISTORY_FILE" >/dev/null \
        || fail "rollback history is not a JSON array: $HISTORY_FILE"
    index=$(jq -r --arg router "$ROUTER_URL" \
        '[to_entries[] | select(.value.router == $router)] | last | .key // empty' "$HISTORY_FILE")
    [[ -n $index ]] || fail "no rollback entry exists for $ROUTER_URL"
    entry=$(jq -c --argjson index "$index" '.[$index]' "$HISTORY_FILE")
    mac=$(jq -r '.mac' <<< "$entry")
    name=$(jq -r '.name' <<< "$entry")
    before=$(jq -c '.before' <<< "$entry")
    client=$(jq -c --arg mac "$mac" 'first(.[] | select(.mac == $mac)) // empty' "$TMP_DIR/all-clients.json")
    if [[ -z $client ]]; then
        client=$(jq -nc --arg name "$name" --arg mac "$mac" --argjson state "$(jq -c '.after' <<< "$entry")" \
            '{name:$name, ip:"N/A", mac:$mac, online:false, policy:$state.policy, deny:$state.deny}')
    fi
    current=$(history_state "$client")
    target_label=$(client_policy_label "$before")
    if $DRY_RUN; then
        printf 'Would restore %s (%s) to "%s" from the %s change recorded at %s.\n' \
            "$name" "$mac" "$target_label" "$(jq -r '.action' <<< "$entry")" "$(jq -r '.timestamp' <<< "$entry")"
        return 0
    fi
    if [[ $current == "$before" ]]; then
        unchanged "$name already has the recorded previous state."
    else
        if jq -e '.deny' <<< "$before" >/dev/null; then
            payload=$(jq -nc --arg mac "$mac" --argjson state "$before" \
                '{mac:$mac, policy:$state.policy, schedule:false, deny:true}')
        else
            payload=$(jq -nc --arg mac "$mac" --argjson state "$before" \
                '{mac:$mac, policy:$state.policy, permit:true, schedule:false}')
        fi
        http_request POST /rci/ip/hotspot/host "$TMP_DIR/undo-result.json" "$payload"
        [[ $HTTP_STATUS == 200 ]] || response_error 'failed to restore rollback state' "$TMP_DIR/undo-result.json"
        verify_client_state "$mac" "$before" "$target_label"
        success "Restored and verified \"$target_label\" for $name."
    fi
    remove_history_entry "$index"
    success 'Removed the restored change from rollback history.'
}


prepare_session() {
    require_command curl
    require_command jq
    command -v md5sum >/dev/null 2>&1 || command -v md5 >/dev/null 2>&1 \
        || fail 'required MD5 tool not found: install md5sum or md5'
    command -v sha256sum >/dev/null 2>&1 || command -v shasum >/dev/null 2>&1 \
        || fail 'required SHA-256 tool not found: install sha256sum or shasum'
    create_temp_dir
}

setup_main() {
    if $DISCOVER; then
        discover_router
    else
        prepare_session
        init_config
    fi
}

start_router_session() {
    if ! $SESSION_READY; then
        prepare_session
        load_config
        SESSION_READY=true
    fi
    authenticate
