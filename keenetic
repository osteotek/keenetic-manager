select_interface_interactively() {
    local count selected selected_index
    count=$(jq '.interfaces | length' "$TMP_DIR/status.json")
    if ((count == 0)); then
        unchanged 'No interfaces found.'
        return 1
    fi
    if command -v "$FZF_COMMAND" >/dev/null 2>&1; then
        selected=$(list_interface_status false true \
            | "$FZF_COMMAND" --delimiter=$'\t' --with-nth=2.. --height=70% --layout=reverse \
                --prompt='Interface> ' --header='Select interface (including inactive interfaces)'$'\n'"$(list_interface_status false true true)") || {
            unchanged "$MENU_CANCEL_MESSAGE"
            return 1
        }
        selected_index=${selected%%$'\t'*}
        if ! { [[ $selected_index =~ ^(0|[1-9][0-9]{0,5})$ ]] && ((selected_index < count)); }; then
            fail 'fzf returned an unknown interface selection'
        fi
    else
        MENU_KIND=interface
        MENU_CURRENT_INDEX=-1
        mapfile -t MENU_OPTIONS < <(list_interface_status false true | cut -f2-)
        printf 'Select interface (including inactive interfaces)\n\n' >&2
        if ! arrow_menu interface; then
            unchanged "$MENU_CANCEL_MESSAGE"
            return 1
        fi
        selected_index=$((SELECTED_INDEX - 1))
    fi
    SELECTED_INTERFACE=$(jq -c --argjson index "$selected_index" '.interfaces[$index]' "$TMP_DIR/status.json")
}

choose_interface_action() {
    local heading selected
    heading=$(jq -r '"Interface: " + .id + " | Status: " + .status | gsub("[[:cntrl:]]"; " ")' <<< "$SELECTED_INTERFACE")
    if command -v "$FZF_COMMAND" >/dev/null 2>&1; then
        selected=$(printf 'up\tConnect (enable)\ndown\tDisconnect (disable)\ninspect\tInspect (show details)\ncancel\tCancel\n' \
            | "$FZF_COMMAND" --delimiter=$'\t' --with-nth=2.. --height=70% --layout=reverse \
                --prompt='Action> ' --header="$heading") || {
            unchanged 'No changes made.'
            return 1
        }
        SELECTED_INTERFACE_ACTION=${selected%%$'\t'*}
    else
        MENU_KIND=interface-action
        MENU_CURRENT_INDEX=-1
        MENU_OPTIONS=('Connect (enable)' 'Disconnect (disable)' 'Inspect (show details)' 'Cancel')
        printf '%s\n\n' "$heading" >&2
        if ! arrow_menu action; then
            unchanged 'No changes made.'
            return 1
        fi
        case $SELECTED_INDEX in
            1) SELECTED_INTERFACE_ACTION=up ;;
            2) SELECTED_INTERFACE_ACTION=down ;;
            3) SELECTED_INTERFACE_ACTION=inspect ;;
            4) SELECTED_INTERFACE_ACTION=cancel ;;
        esac
    fi
    case $SELECTED_INTERFACE_ACTION in
        up|down|inspect) ;;
        cancel) unchanged 'No changes made.'; return 1 ;;
        *) fail 'fzf returned an unknown interface action' ;;
    esac
}

apply_interface_action() {
    local id label action=$SELECTED_INTERFACE_ACTION current payload attempt status
    id=$(jq -r '.id' <<< "$SELECTED_INTERFACE")
    label=$(jq -r '.id | gsub("[[:cntrl:]]"; " ")' <<< "$SELECTED_INTERFACE")
    # Refresh before writing: never create an interface that disappeared after selection.
    fetch_interface_status
    current=$(jq -c --arg id "$id" 'first(.interfaces[] | select(.id == $id)) // empty' "$TMP_DIR/status.json")
    [[ -n $current ]] || fail "interface $label is no longer available; no changes made"
    if $DRY_RUN; then
        printf 'Would set interface %s administratively %s (current status: %s).\n' \
            "$label" "$action" "$(jq -r '.status' <<< "$current")"
        return 0
    fi
    if [[ $(jq -r '.state' <<< "$current") == "$action" ]]; then
        unchanged "Interface $label is already administratively $action (status: $(jq -r '.status' <<< "$current"))."
        return 0
    fi
    # Structured RCI command; names with slashes remain a single interface key.
    payload=$(jq -nc --arg id "$id" --arg action "$action" \
        '{interface:{($id):{up:(if $action == "up" then true else {no:true} end)}}}')
    OPERATION_CONTEXT="interface $label: the requested state may have applied if router access is lost"
    http_request POST /rci/ "$TMP_DIR/interface-result.json" "$payload"
    [[ $HTTP_STATUS == 200 ]] || response_error 'failed to change interface state' "$TMP_DIR/interface-result.json"
    if ! jq -e 'type == "object" and (any(.. | objects; .status? == "error") | not)' \
        "$TMP_DIR/interface-result.json" >/dev/null 2>&1; then
        fail 'router rejected the interface command or returned an invalid response'
    fi
    for attempt in 0 1 2 3; do
        case $attempt in 1) sleep 0.2 ;; 2) sleep 0.3 ;; 3) sleep 0.5 ;; esac
        fetch_interface_status
        current=$(jq -c --arg id "$id" 'first(.interfaces[] | select(.id == $id)) // empty' "$TMP_DIR/status.json")
        if [[ -n $current && $(jq -r '.state' <<< "$current") == "$action" ]]; then
            status=$(jq -r '.status' <<< "$current")
            OPERATION_CONTEXT=
            success "Applied and verified interface $label administratively $action (status: $status)."
            return 0
        fi
    done
    fail "$EXIT_VERIFY" "could not verify administrative state $action after 4 checks over 1 second"
}

interface_inspect() {
    VIEW_MODE=all
    fetch_interface_status
    jq --arg id "$INSPECT_QUERY" '.interfaces |= map(select(.id == $id))' "$TMP_DIR/status.json" > "$TMP_DIR/inspect-selected.json"
    jq -e '.interfaces | length == 1' "$TMP_DIR/inspect-selected.json" >/dev/null || fail "$EXIT_USAGE" 'unknown interface ID'
    mv "$TMP_DIR/inspect-selected.json" "$TMP_DIR/status.json"
    fetch_interface_traffic
    fetch_routes
    # shellcheck disable=SC2016 # Variables in the filter belong to jq.
    normalize_data "$TMP_DIR/interfaces.json" "$TMP_DIR/interface-details.json" '
        (first(to_entries[] | select((.value.id // .key) == $id) | .value)) as $raw
        | {router:$router,interface:($selected[0].interfaces[0] + {
            mtu:($raw.mtu | num),mac:($raw.mac | txt),speed_mbps:($raw.speed // $raw.port.speed | num),duplex:($raw.duplex // $raw.port.duplex | txt),
            priority:($raw.priority | num),global:($raw.global | flag),default_gateway:($raw.defaultgw | flag),
            uptime_seconds:($raw.uptime | num),
            gateways:[$routes[0].routes[] | select(.interface == $id and (.destination == "0.0.0.0/0" or .destination == "::/0"))
                | {family,gateway,metric}],
            ports:((if ($raw.port | type) == "object" and ($raw.port | has("id") or has("link") or has("speed")) then [$raw.port]
                elif ($raw.port | type) == "object" then [$raw.port | to_entries[] | select(.value | type == "object")
                    | .value + {id:(.value.id // .key)} | select(has("link") or has("speed"))]
                elif ($raw.port | type) == "array" then $raw.port else [] end)
                | map({id:(.id | txt),label:(.label | txt),speed_mbps:(.speed | num),duplex:(.duplex | txt),link:(.link | txt)}))})}
    ' --arg id "$INSPECT_QUERY" --slurpfile selected "$TMP_DIR/status.json" --slurpfile routes "$TMP_DIR/routes.json"
    render_report "$TMP_DIR/interface-details.json" '
        .interface | fields("Interface details"; [["ID",.id],["Name",.description],["Type",.type],["Status",.status],
            ["MAC",.mac],["IPv4",.ipv4],["Mask",.mask],["IPv6",([.ipv6[] | .address] | join(", "))],
            ["MTU",.mtu],["Link Mbps",.speed_mbps],["Duplex",.duplex],["Priority",.priority],
            ["Default gateway",.default_gateway],["Gateways",([.gateways[].gateway] | join(", "))],["Uptime",(.uptime_seconds | duration)],
            ["RX",(.traffic.rx_bytes | bytes)],["TX",(.traffic.tx_bytes | bytes)],
            ["RX packets",.traffic.rx_packets],["TX packets",.traffic.tx_packets],["RX errors",.traffic.rx_errors],
            ["TX errors",.traffic.tx_errors],["RX dropped",.traffic.rx_dropped],["TX dropped",.traffic.tx_dropped]]),
        (if .ports | length > 0 then "",grid("Physical ports"; ["PORT","LABEL","LINK","SPEED Mbps","DUPLEX"];
            [.ports[] | [.id,.label,.link,.speed_mbps,.duplex]]) else empty end)'
}

interface_rates() {
    local previous="$TMP_DIR/rates-previous.json" sampled_at elapsed
    fetch_interface_status
    fetch_interface_traffic
    sampled_at=$SECONDS
    if [[ ! -f $previous ]]; then
        jq --argjson now "$sampled_at" '. + {sampled_at:$now}' "$TMP_DIR/status.json" > "$previous"
        wait_interval "$RATE_INTERVAL"
        fetch_interface_status
        fetch_interface_traffic
        sampled_at=$SECONDS
    fi
    elapsed=$((sampled_at - $(jq -r '.sampled_at' "$previous")))
    # A frame can be requested before one second has elapsed; avoid dividing by zero.
    if ((elapsed < 1)); then
        wait_interval 1
        fetch_interface_status
        fetch_interface_traffic
        sampled_at=$SECONDS
        elapsed=$((sampled_at - $(jq -r '.sampled_at' "$previous")))
    fi
    # shellcheck disable=SC2016 # Variables in the filter belong to jq.
    normalize_data "$TMP_DIR/status.json" "$TMP_DIR/rates.json" '
        ($previous[0].interfaces | map({key:.id,value:.}) | from_entries) as $before
        | . + {sampled_at:$now,sample_seconds:$elapsed}
        | .interfaces |= map(. as $current | $before[.id] as $old
            | def rate($key): ($current.traffic[$key] | num) as $new | ($old.traffic[$key] | num) as $last
                | if $elapsed > 0 and $new != null and $last != null and $new >= $last
                    and $old.status == $current.status and $old.ipv4 == $current.ipv4
                    and $current.link != "down" and ($current.status == "connected" or $current.status == "link up")
                  then ($new - $last) / $elapsed else null end;
              (rate("rx_bytes")) as $rx | (rate("tx_bytes")) as $tx
              | . + {rx_bytes_per_second:$rx,tx_bytes_per_second:$tx,
                    rx_history:(if $rx == null then [] else (($old.rx_history // []) + [$rx])[-20:] end),
                    tx_history:(if $tx == null then [] else (($old.tx_history // []) + [$tx])[-20:] end)})
    ' --argjson now "$sampled_at" --argjson elapsed "$elapsed" --slurpfile previous "$previous"
    cp "$TMP_DIR/rates.json" "$previous"
    # shellcheck disable=SC2016 # Variables in the filter belong to jq.
    render_report "$TMP_DIR/rates.json" '
        def mbps: if . == null then null else (. * 8 / 1000000 * 100 | round) / 100 end;
        def spark: . as $samples | (max // 0) as $peak
            | if length == 0 then "unknown" else [ $samples[] | if $peak == 0 then "▁" else
                "▁▂▃▄▅▆▇█"[([(. / $peak * 7 | floor),7] | min):([(. / $peak * 7 | floor),7] | min)+1] end ] | join("") end;
        grid("Interface rates · " + (.sample_seconds | tostring) + "s sample";
            ["INTERFACE","STATUS","RX Mbps","TX Mbps","RX HISTORY","TX HISTORY"];
            [.interfaces[] | [.id,.status,(.rx_bytes_per_second | mbps),(.tx_bytes_per_second | mbps),(.rx_history | spark),(.tx_history | spark)]])'
}

interfaces_main() {
    if $INTERACTIVE; then
        [[ -t 0 && -t 2 ]] || fail 'interactive interface selection requires a terminal'
        VIEW_MODE=all
    fi
    start_router_session
    if [[ $SUBCOMMAND == up || $SUBCOMMAND == down ]]; then
        VIEW_MODE=all
        fetch_interface_status
        SELECTED_INTERFACE=$(jq -c --arg id "$INSPECT_QUERY" 'first(.interfaces[] | select(.id == $id)) // empty' "$TMP_DIR/status.json")
        [[ -n $SELECTED_INTERFACE ]] || fail "$EXIT_USAGE" "unknown interface ID: $INSPECT_QUERY. Run 'keenetic interface list --all' to see IDs."
        SELECTED_INTERFACE_ACTION=$SUBCOMMAND
        apply_interface_action
        return
    fi
    if [[ $SUBCOMMAND == inspect ]]; then
        if $INTERACTIVE && [[ -z $INSPECT_QUERY ]]; then
            fetch_interface_status
            fetch_interface_traffic
            MENU_CANCEL_MESSAGE='No interface selected.'
            select_interface_interactively || return 0
            INSPECT_QUERY=$(jq -r '.id' <<< "$SELECTED_INTERFACE")
            printf '\n'
        fi
        interface_inspect; return
    fi
    if $INTERFACE_RATES; then interface_rates; return; fi
    fetch_interface_status
    fetch_interface_traffic
    if $JSON_OUTPUT; then
        cat "$TMP_DIR/status.json"
    elif $INTERACTIVE; then
        select_interface_interactively || return 0
        choose_interface_action || return 0
        if [[ $SELECTED_INTERFACE_ACTION == inspect ]]; then
            INSPECT_QUERY=$(jq -r '.id' <<< "$SELECTED_INTERFACE")
            printf '\n'
            interface_inspect
        else
            apply_interface_action
        fi
    else
        list_interface_status false
    fi
}

wifi_main() {
    start_router_session
    case $SUBCOMMAND in monitor) wifi_monitor_main; return ;; clients) wifi_clients_main; return ;; scan) wifi_scan_main; return ;; esac
    fetch_wifi_networks
    if $JSON_OUTPUT; then
        cat "$TMP_DIR/wifi.json"
    else
        list_wifi_networks
    fi
}

traffic_main() {
    start_router_session
    fetch_client_traffic
    if $JSON_OUTPUT; then
        cat "$TMP_DIR/client-traffic.json"
    else
        list_client_traffic
    fi
}

policy_main() {
    start_router_session
    fetch_router_state
    detect_current_client

    if [[ $SUBCOMMAND == list ]]; then
        list_policies
    elif [[ $SUBCOMMAND == inspect ]]; then
        inspect_policy
    elif $UNDO; then
        undo_last_action
    elif $JSON_OUTPUT; then
        list_clients_json
    elif $INTERACTIVE; then
        select_any_client true || return 0
        choose_policy_interactively "$SELECTED_CLIENT" "${#SELECTED_CLIENTS[@]}" || return 0
        if [[ $SELECTED_POLICY_ID == __block__ ]]; then
            ACTION=block
            confirm_block_interactively || return 0
        else
            ACTION=policy
        fi
        run_selected_actions
    elif [[ -n $ACTION ]]; then
        [[ $ACTION != policy ]] || resolve_policy "$POLICY_QUERY"
        preflight_clients
        run_selected_actions
    elif ((${#CLIENT_SELECTORS[@]} == 1)); then
        resolve_client "${CLIENT_SELECTORS[0]}" "${CLIENT_VALUES[0]}" true || return 0
        SELECTED_CLIENTS=("$SELECTED_CLIENT")
        choose_policy_interactively "$SELECTED_CLIENT" || return 0
        if [[ $SELECTED_POLICY_ID == __block__ ]]; then
            ACTION=block
            confirm_block_interactively || return 0
        else
            ACTION=policy
        fi
        apply_client_action "$SELECTED_CLIENT" "$ACTION"
    else
        list_clients_table
    fi
}

wake_main() {
    start_router_session
    if $INTERACTIVE; then
        VIEW_MODE=all
        fetch_router_state; detect_current_client
        MENU_CANCEL_MESSAGE='No client selected.'
        select_any_client true || return 0
    else
        fetch_router_state
        preflight_clients
    fi
    run_selected_actions
}

# `keenetic --interactive`: pick a command, then run it (interactively where that exists).
command_menu() {
    start_router_session
    MENU_CANCEL_MESSAGE='No command selected.'
    pick_from_list "Router $ROUTER_URL" 'Command' false 3< <(printf '%s\n' \
        $'status\tRouter status: KeenDNS, clients, interfaces, traffic totals' \
        $'interfaces\tInterfaces: pick one to inspect, connect, or disconnect' \
        $'clients\tClients: pick one to inspect' \
        $'policy\tPolicies: pick clients, then assign a policy or block Internet' \
        $'wake\tWake-on-LAN: pick clients to wake' \
        $'connections\tActive NAT connections for a chosen client' \
        $'logs\tRecent logs, filtered by a chosen source' \
        $'wifi\tWi-Fi networks' \
        $'traffic\tTop clients by recent traffic' \
        $'wan\tInternet health, connections, and DNS' \
        $'dhcp\tDHCP leases and reservations' \
        $'routes\tRouting table' \
        $'mesh\tMesh nodes' \
        $'forwards\tPort-forwarding rules' \
        $'vpn\tWireGuard peers' \
        $'system\tRouter health') || return 0
    printf '\n'
    case $SELECTED_VALUE in
        status) COMMAND=root; INTERACTIVE=false; status_main ;;
        interfaces|clients|policy|wake|connections|logs)
            COMMAND=$SELECTED_VALUE
            [[ $SELECTED_VALUE != wake ]] || ACTION=wake
            run_command_once ;;
        vpn) COMMAND=vpn; SUBCOMMAND=peers; INTERACTIVE=false; run_command_once ;;
        *) COMMAND=$SELECTED_VALUE; INTERACTIVE=false; run_command_once ;;
    esac
}

run_command_once() {
    case $COMMAND in
        root)
            if $INIT_CONFIG || $DISCOVER; then setup_main; elif $INTERACTIVE; then command_menu; else status_main; fi
            ;;
        policy) policy_main ;;
        interfaces) interfaces_main ;;
        traffic) traffic_main ;;
        wifi) wifi_main ;;
        clients) clients_main ;;
        system) system_main ;;
        vpn) vpn_main ;;
        logs) logs_main ;;
        diagnose) diagnose_main ;;
        wake) wake_main ;;
        wan) wan_main ;; dhcp) dhcp_main ;; routes) routes_main ;; mesh) mesh_main ;;
        connections) connections_main ;; forwards) forwards_main ;; speedtest) speedtest_main ;;
    esac
}

main() {
    parse_args "$@"
    init_colors
    if [[ -z $WATCH_INTERVAL ]]; then
        run_command_once
        return
    fi
    start_router_session
    if ! $JSON_OUTPUT; then
        WATCH_SCREEN=true
        CURSOR_HIDDEN=true
        printf '\033[?1049h\033[?25l'
    fi
    while true; do
        run_command_once > "$TMP_DIR/watch-frame"
        if $JSON_OUTPUT; then
            jq -c . "$TMP_DIR/watch-frame"
        else
            printf '\033[H%sEvery %ss · updated %s · Ctrl-C to exit%s\n\n%s\033[J' \
                "$DIM" "$WATCH_INTERVAL" "$(date +%H:%M:%S)" "$RESET" "$(cat "$TMP_DIR/watch-frame")"
        fi
        sleep "$WATCH_INTERVAL" &
        WATCH_SLEEP_PID=$!
        wait "$WATCH_SLEEP_PID"
        WATCH_SLEEP_PID=
    done
}

main "$@"
