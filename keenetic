check_write_reply() {
    [[ $HTTP_STATUS == 200 ]] || response_error "$1" "$2"
    jq -e 'type == "object" and (any(.. | objects; .status? == "error") | not)' "$2" >/dev/null 2>&1 \
        || fail "$1: router rejected the command or returned invalid data"
}

system_save() {
    local attempt
    fetch_changes
    if $DRY_RUN; then
        printf 'Would save the running configuration on %s (unsaved: %s).\n' "$ROUTER_URL" "$(jq -r '.unsaved' "$TMP_DIR/changes.json")"
        return
    fi
    jq -e '.unsaved | type == "boolean"' "$TMP_DIR/changes.json" >/dev/null || fail 'router does not report whether configuration is saved'
    if jq -e '.unsaved == false' "$TMP_DIR/changes.json" >/dev/null; then unchanged 'Configuration is already saved.'; return; fi
    OPERATION_CONTEXT='configuration save may have started if the response is lost'
    http_request POST /rci/ "$TMP_DIR/save-result.json" '{"system":{"configuration":{"save":{}}}}'
    check_write_reply 'failed to save configuration' "$TMP_DIR/save-result.json"
    for attempt in 0 1 2 3; do
        ((attempt == 0)) || wait_interval 1
        fetch_changes
        if jq -e '.unsaved == false' "$TMP_DIR/changes.json" >/dev/null; then
            OPERATION_CONTEXT=
            success "Configuration saved and verified on $ROUTER_URL."
            return
        fi
    done
    fail "$EXIT_VERIFY" 'configuration is still unsaved or cannot be verified after 4 checks'
}

clients_rename() {
