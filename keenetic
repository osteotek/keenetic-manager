read_optional_json() {
    local endpoint=$1 file=$2 kind=$3 label=$4
    http_request GET "$endpoint" "$file"
    if [[ $HTTP_STATUS == 401 || $HTTP_STATUS == 403 ]]; then response_error "failed to retrieve $label" "$file"; fi
    if [[ $HTTP_STATUS != 200 ]] || ! jq -e --arg kind "$kind" \
        'type == $kind and (any(.. | objects; .status? == "error") | not)' "$file" >/dev/null 2>&1; then
        warn "$label unavailable (HTTP $HTTP_STATUS)."
        printf 'null\n' > "$file"
    fi
}

report_format_filter() {
    cat <<'JQ'
        def text: if . == null then "unknown" elif type == "boolean" then (if . then "yes" else "no" end) else tostring end | clean;
        def number: if type == "number" or type == "string" then (try tonumber catch null) else null end;
        def nonnegative: number | if . != null and . >= 0 then . else null end;
        ($columns | tonumber | if . < 20 then 20 else . end) as $screen
        | def fields($title; $rows):
            ($title | clean | wordwrap($screen)[]),
            (($rows | map(.[0] | width) | max // 0) as $natural
             | ([$natural, 22] | min) as $label_width
             | $rows[] | (.[0] | clean) as $field_label | (.[1] | text) as $value
             | if $screen < 40 then $dim + $field_label + $reset, ($value | wordwrap($screen - 2)[] | "  " + .)
               else ($value | wordwrap($screen - $label_width - 2) | to_entries[])
                 | $dim + ((if .key == 0 then $field_label else "" end) | fit($label_width; false)) + $reset + "  " + .value end);
          def grid($title; $headers; $data):
            ($title | clean | wordwrap($screen)[]),
            (if $data | length == 0 then "None"
             else ($data | map(map(text))) as $rows
               | ($headers | length) as $n
               | if $screen < 72 then
                   $rows[] | . as $row
                   | ($row[0] | wordwrap($screen)[]),
                     (range(1; $n) as $i | ($headers[$i] + ": " + $row[$i]) | wordwrap($screen - 2)[] | "  " + .)
                 else
                   [range(0; $n) as $i | ([$headers[$i] | width] + [$rows[] | .[$i] | width] | max)
                      | [., 40] | min] as $natural
                   | ([($natural | add) - ($screen - 2 * ($n - 1)), 0] | max) as $excess
                   | (reduce range(0; $excess) as $step ($natural;
                        max as $largest | index($largest) as $i | .[$i] -= 1)) as $widths
                   | def line($row): [range(0; $n) as $i | $row[$i] | fit($widths[$i]; false)] | join("  ");
                   $dim + line($headers) + $reset, ($rows[] | line(.))
                 end
             end);
JQ
}

render_report() {
    local file=$1 filter=$2
    if $JSON_OUTPUT; then cat "$file"; return; fi
    jq -r --arg columns "$(terminal_columns)" --arg dim "$DIM" --arg reset "$RESET" \
        "$(table_format_filter) $(report_format_filter) $filter" "$file"
}

system_main() {
    start_router_session
    api_get /rci/show/system "$TMP_DIR/system-raw.json" 'system health' object
    read_optional_json /rci/show/version "$TMP_DIR/version.json" object 'Firmware metadata'
    if ! jq --arg router "$ROUTER_URL" --slurpfile version "$TMP_DIR/version.json" '
        def num: if type == "number" or type == "string" then (try tonumber catch null) else null end;
        def kb: num | if . != null and . >= 0 then . * 1024 else null end;
        def text: if type == "string" then . else null end;
        if (has("uptime") or has("cpuload") or has("memory") | not)
            or any(.. | objects; .status? == "error") then error("invalid system data") else . end
        | ((.memory | text // "") | split("/")) as $memory
        | {router:$router, hostname:(.hostname | text), model:($version[0].model | text),
           firmware:($version[0].title | text), uptime_seconds:(.uptime | num), cpu_percent:(.cpuload | num),
           memory:{used_bytes:($memory[0] | kb), total_bytes:((.memtotal // $memory[1]) | kb),
                   free_bytes:(.memfree | kb), cached_bytes:(.memcache | kb)},
           swap:{total_bytes:(.swaptotal | kb), free_bytes:(.swapfree | kb)},
           connections:{capacity:(.conntotal | num), used:(if (.conntotal | num) != null and (.connfree | num) != null
                then (.conntotal | num) - (.connfree | num) else null end)}}
    ' "$TMP_DIR/system-raw.json" > "$TMP_DIR/system.json"; then fail 'the router returned invalid system health data'; fi
    render_report "$TMP_DIR/system.json" '
        fields("Router health"; [["Model",.model],["Firmware",.firmware],["Hostname",.hostname],
            ["Uptime",(.uptime_seconds | duration)],["CPU",((.cpu_percent | text) + "%")],
            ["RAM used / total",((.memory.used_bytes | bytes) + " / " + (.memory.total_bytes | bytes))],
            ["RAM free",(.memory.free_bytes | bytes)],["RAM cached",(.memory.cached_bytes | bytes)],
            ["Swap free / total",((.swap.free_bytes | bytes) + " / " + (.swap.total_bytes | bytes))],
            ["Connections",((.connections.used | text) + " / " + (.connections.capacity | text))]])'
}

