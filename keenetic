select_interface_interactively() {
    local count selected selected_index
    count=$(jq '.interfaces | length' "$TMP_DIR/status.json")
    if ((count == 0)); then
        unchanged 'No interfaces found.'
        return 1
    fi
    if command -v "$FZF_COMMAND" >/dev/null 2>&1; then
        selected=$(list_interface_status false true \
            | "$FZF_COMMAND" --delimiter=$'\t' --with-nth=2.. --height=70% --layout=reverse \
                --prompt='Interface> ' --header='Select interface (including inactive interfaces)') || {
            unchanged 'No changes made.'
            return 1
        }
        selected_index=${selected%%$'\t'*}
        if ! { [[ $selected_index =~ ^(0|[1-9][0-9]{0,5})$ ]] && ((selected_index < count)); }; then
            fail 'fzf returned an unknown interface selection'
        fi
    else
        MENU_KIND=interface
        MENU_CURRENT_INDEX=-1
        mapfile -t MENU_OPTIONS < <(list_interface_status false true | cut -f2-)
        printf 'Select interface (including inactive interfaces)\n\n' >&2
        if ! arrow_menu interface; then
            unchanged 'No changes made.'
            return 1
        fi
        selected_index=$((SELECTED_INDEX - 1))
    fi
    SELECTED_INTERFACE=$(jq -c --argjson index "$selected_index" '.interfaces[$index]' "$TMP_DIR/status.json")
}

choose_interface_action() {
    local heading selected
    heading=$(jq -r '"Interface: " + .id + " | Status: " + .status | gsub("[[:cntrl:]]"; " ")' <<< "$SELECTED_INTERFACE")
    if command -v "$FZF_COMMAND" >/dev/null 2>&1; then
        selected=$(printf 'up\tConnect (enable)\ndown\tDisconnect (disable)\ncancel\tCancel\n' \
            | "$FZF_COMMAND" --delimiter=$'\t' --with-nth=2.. --height=70% --layout=reverse \
                --prompt='Action> ' --header="$heading") || {
            unchanged 'No changes made.'
            return 1
        }
        SELECTED_INTERFACE_ACTION=${selected%%$'\t'*}
    else
        MENU_KIND=interface-action
        MENU_CURRENT_INDEX=-1
        MENU_OPTIONS=('Connect (enable)' 'Disconnect (disable)' 'Cancel')
        printf '%s\n\n' "$heading" >&2
        if ! arrow_menu action; then
            unchanged 'No changes made.'
            return 1
        fi
        case $SELECTED_INDEX in
            1) SELECTED_INTERFACE_ACTION=up ;;
            2) SELECTED_INTERFACE_ACTION=down ;;
            3) SELECTED_INTERFACE_ACTION=cancel ;;
        esac
    fi
    case $SELECTED_INTERFACE_ACTION in
        up|down) ;;
        cancel) unchanged 'No changes made.'; return 1 ;;
        *) fail 'fzf returned an unknown interface action' ;;
    esac
}

apply_interface_action() {
    local id label action=$SELECTED_INTERFACE_ACTION current payload attempt status
    id=$(jq -r '.id' <<< "$SELECTED_INTERFACE")
    label=$(jq -r '.id | gsub("[[:cntrl:]]"; " ")' <<< "$SELECTED_INTERFACE")
    # Refresh before writing: never create an interface that disappeared after selection.
    fetch_interface_status
    current=$(jq -c --arg id "$id" 'first(.interfaces[] | select(.id == $id)) // empty' "$TMP_DIR/status.json")
    [[ -n $current ]] || fail "interface $label is no longer available; no changes made"
    if $DRY_RUN; then
        printf 'Would set interface %s administratively %s (current status: %s).\n' \
            "$label" "$action" "$(jq -r '.status' <<< "$current")"
        return 0
    fi
    if [[ $(jq -r '.state' <<< "$current") == "$action" ]]; then
        unchanged "Interface $label is already administratively $action (status: $(jq -r '.status' <<< "$current"))."
        return 0
    fi
    # Structured RCI command; names with slashes remain a single interface key.
    payload=$(jq -nc --arg id "$id" --arg action "$action" \
        '{interface:{($id):{up:(if $action == "up" then true else {no:true} end)}}}')
    OPERATION_CONTEXT="interface $label: the requested state may have applied if router access is lost"
    http_request POST /rci/ "$TMP_DIR/interface-result.json" "$payload"
    [[ $HTTP_STATUS == 200 ]] || response_error 'failed to change interface state' "$TMP_DIR/interface-result.json"
    if ! jq -e 'type == "object" and (any(.. | objects; .status? == "error") | not)' \
        "$TMP_DIR/interface-result.json" >/dev/null 2>&1; then
        fail 'router rejected the interface command or returned an invalid response'
    fi
    for attempt in 0 1 2 3; do
        case $attempt in 1) sleep 0.2 ;; 2) sleep 0.3 ;; 3) sleep 0.5 ;; esac
        fetch_interface_status
        current=$(jq -c --arg id "$id" 'first(.interfaces[] | select(.id == $id)) // empty' "$TMP_DIR/status.json")
        if [[ -n $current && $(jq -r '.state' <<< "$current") == "$action" ]]; then
            status=$(jq -r '.status' <<< "$current")
            OPERATION_CONTEXT=
            success "Applied and verified interface $label administratively $action (status: $status)."
            return 0
        fi
    done
    fail "$EXIT_VERIFY" "could not verify administrative state $action after 4 checks over 1 second"
}

