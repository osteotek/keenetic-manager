        VIEW_MODE=all
        fetch_router_state; detect_current_client
        MENU_CANCEL_MESSAGE='No client selected.'
        select_any_client || return 0
        NEW_CLIENT_NAME=$(prompt_value 'New name' "$(jq -r '.name' <<< "$SELECTED_CLIENT")")
        validate_client_name "$NEW_CLIENT_NAME"
    else
        select_report_client
    fi
    mac=$(jq -r '.mac' <<< "$SELECTED_CLIENT")
    [[ $mac =~ ^([[:xdigit:]]{2}:){5}[[:xdigit:]]{2}$ ]] || fail "$EXIT_CLIENT" 'selected client has an invalid MAC address'
    if $DRY_RUN; then printf 'Would rename client %s to %s on %s.\n' "$mac" "$NEW_CLIENT_NAME" "$ROUTER_URL"; return; fi
    if [[ $(jq -r '.name' <<< "$SELECTED_CLIENT") == "$NEW_CLIENT_NAME" ]]; then unchanged 'Client already has this name.'; return; fi
    payload=$(jq -nc --arg mac "$mac" --arg name "$NEW_CLIENT_NAME" '{known:{host:{mac:$mac,name:$name}}}')
    OPERATION_CONTEXT="client $mac may have been renamed if the response is lost"
    http_request POST /rci/ "$TMP_DIR/rename-result.json" "$payload"
    check_write_reply 'failed to rename client' "$TMP_DIR/rename-result.json"
    for attempt in 0 1 2 3; do
        ((attempt == 0)) || wait_interval 0.3
        api_get /rci/show/ip/hotspot/host "$TMP_DIR/rename-hosts.json" 'client names' array
        if jq -e --arg mac "$mac" --arg name "$NEW_CLIENT_NAME" 'any(.[]; (.mac | ascii_downcase) == $mac and .name == $name)' "$TMP_DIR/rename-hosts.json" >/dev/null; then
            OPERATION_CONTEXT=
            success "Client $mac renamed to $NEW_CLIENT_NAME and verified."
            return
        fi
    done
    fail "$EXIT_VERIFY" 'could not verify the new client name after 4 checks'
}

speedtest_main() {
