wifi_monitor_main() {
    local id encoded
    api_get /rci/show/interface "$TMP_DIR/monitor-interfaces.json" 'Wi-Fi radios' object
    if ! jq --arg view "$VIEW_MODE" '
        if any(.[]; type != "object") then error("invalid interface") else . end
        | [to_entries[] | .key as $key | .value | select(.type == "WifiMaster")
            | select($view == "all" or .state != "down")
            | {id:(.id // $key),channel:(.channel // null),width_mhz:(.bandwidth // null),state:(.state // "unknown")}]
    ' "$TMP_DIR/monitor-interfaces.json" > "$TMP_DIR/radios.json"; then fail 'invalid Wi-Fi radio data'; fi
    printf '[]\n' > "$TMP_DIR/radio-loads.json"
    while IFS= read -r id; do
        encoded=$(jq -rn --arg id "$id" '$id | @uri')
        read_optional_json "/rci/show/interface/channel-utilization/rrd?name=$encoded&attribute=load&detail=0" \
            "$TMP_DIR/radio-load.json" object "Channel utilization for $id"
        jq --arg id "$id" --slurpfile sample "$TMP_DIR/radio-load.json" '
            def num: if type == "number" or type == "string" then (try tonumber catch null) else null end;
            (if ($sample[0].data | type) == "array" then [$sample[0].data[] | select(type == "object")
                | {t:(.t | num),v:(.v | num)} | select(.t != null and .v != null and .v >= 0 and .v <= 100)] else [] end) as $data
            | ($data | map(.t) | max) as $latest
            | [$data[] | select(.t > $latest - 180)] as $window
            | . + [{id:$id, samples:($window | length), current_percent:($window | max_by(.t) | .v),
                average_percent:(if $window | length > 0 then (($window | map(.v) | add) / ($window | length) * 10 | round) / 10 else null end),
                peak_percent:($window | map(.v) | max)}]
        ' "$TMP_DIR/radio-loads.json" > "$TMP_DIR/radio-loads-next.json"
        mv "$TMP_DIR/radio-loads-next.json" "$TMP_DIR/radio-loads.json"
    done < <(jq -r '.[].id' "$TMP_DIR/radios.json")
    jq --arg router "$ROUTER_URL" --slurpfile loads "$TMP_DIR/radio-loads.json" '
        ($loads[0] | map({key:.id,value:.}) | from_entries) as $by_id
        | {router:$router,window_seconds:180,radios:map(. + $by_id[.id])}
    ' "$TMP_DIR/radios.json" > "$TMP_DIR/wifi-monitor.json"
    render_report "$TMP_DIR/wifi-monitor.json" '
        grid("Wi-Fi channel utilization · last 3 minutes"; ["RADIO","CH","WIDTH MHz","NOW %","AVG %","PEAK %","STATE"];
            [.radios[] | [.id,.channel,.width_mhz,.current_percent,.average_percent,.peak_percent,.state]])'
}

clients_main() {
    start_router_session
    if [[ $SUBCOMMAND != inspect ]]; then
        fetch_router_state; detect_current_client
        if $JSON_OUTPUT; then list_clients_json; else list_clients_table; fi
        return
    fi
    VIEW_MODE=all
    fetch_router_state
    local matches count mac
    matches=$(jq --arg query "$INSPECT_QUERY" '[.[] | select(.ip == $query or .mac == ($query | ascii_downcase)
        or (.name | ascii_downcase) == ($query | ascii_downcase))] | unique_by(.mac)' "$TMP_DIR/all-clients.json")
    count=$(jq 'length' <<< "$matches")
    ((count > 0)) || fail "$EXIT_CLIENT" "no client matches $INSPECT_QUERY"
    ((count == 1)) || fail "$EXIT_CLIENT" 'client name is ambiguous; use its IP or MAC address'
    SELECTED_CLIENT=$(jq -c '.[0]' <<< "$matches")
    mac=$(jq -r '.mac' <<< "$SELECTED_CLIENT")
    read_optional_json '/rci/show/ip/hotspot/summary?detail=0&attribute=sumbytes' "$TMP_DIR/inspect-traffic.json" object 'Recent client traffic'
    read_optional_json /rci/show/interface "$TMP_DIR/inspect-interfaces.json" object 'Client radio details'
    jq --arg router "$ROUTER_URL" --arg mac "$mac" --argjson client "$SELECTED_CLIENT" \
        --slurpfile traffic "$TMP_DIR/inspect-traffic.json" --slurpfile interfaces "$TMP_DIR/inspect-interfaces.json" \
        --slurpfile policies "$TMP_DIR/policies.json" "def policy_label: $policy_label_filter;"'
        def text: if type == "string" then . else null end;
        def num: if type == "number" or type == "string" then (try tonumber catch null) else null end;
        (first(.[] | select((.mac | ascii_downcase) == $mac)) // {}) as $host
        | (($host.ap // $host.mws.ap) | text) as $ap
        | ($ap // "" | split("/")[0]) as $radio_id
        | ((if $traffic[0].t == 0 and ($traffic[0].host | type) == "array" then
              first($traffic[0].host[] | select((.mac // "" | ascii_downcase) == $mac)) else null end) // null) as $usage
        | {router:$router, client:($client | {name,ip,mac,online,blocked:.deny,policy:policy_label,
            policy_id:(if .policy == false then null else .policy end)}
            + {hostname:($host.hostname | text), connection:(if $ap != null or ($host.ssid | type) == "string" then "wireless" else "wired" end),
               interface:($host.interface.id | text), ap:$ap, ssid:($host.ssid // $host.mws.ssid | text),
               signal_dbm:($host.rssi // $host.mws.rssi | num), tx_rate_mbps:($host.txrate | num), rx_rate_mbps:($host.rxrate | num),
               uptime_seconds:($host.uptime | num), channel:($interfaces[0][$radio_id].channel // null),
               band:($interfaces[0][$radio_id] as $radio
                   | if $radio.band != null then ($radio.band | tostring)
                     elif (($radio.frequency | num) // 0) >= 5925 then "6 GHz"
                     elif (($radio.frequency | num) // 0) >= 4900 then "5 GHz"
                     elif $radio_id == "WifiMaster0" then "2.4 GHz"
                     elif $radio_id == "WifiMaster1" then "5 GHz" else null end),
               recent_traffic:(if $usage == null then null else {window_seconds:180,rx_bytes:($usage.rxbytes | num),
                   tx_bytes:($usage.txbytes | num),total_bytes:($usage.sumbytes | num)} end)})}
    ' "$TMP_DIR/clients.json" > "$TMP_DIR/client-inspect.json"
    render_report "$TMP_DIR/client-inspect.json" '
        .client | fields("Client details"; [["Name",.name],["IP",.ip],["MAC",.mac],["Hostname",.hostname],
            ["Status",(if .online then "online" else "offline" end)],["Connection",.connection],["Policy",.policy],["Blocked",.blocked],
            ["Interface",.interface],["Access point",.ap],["SSID",.ssid],["Band",.band],["Channel",.channel],
            ["Signal dBm",.signal_dbm],["TX Mbps",.tx_rate_mbps],["RX Mbps",.rx_rate_mbps],["Connected for",(.uptime_seconds | duration)],
            ["Traffic · 3 minutes",((.recent_traffic.rx_bytes | bytes) + " RX / " + (.recent_traffic.tx_bytes | bytes) + " TX")]])'
}

