# Closest known command by edit distance, for "did you mean" hints.
suggest_command() {
    local word=${1,,} best='' best_distance=3 candidate distance
    for candidate in status client clients policy interface interfaces wifi traffic wan dhcp routes mesh nat connections forwards vpn system logs diagnose speedtest wake config; do
        distance=$(awk -v a="$word" -v b="$candidate" 'BEGIN {
            n = length(a); m = length(b);
            for (i = 0; i <= n; i++) d[i, 0] = i;
            for (j = 0; j <= m; j++) d[0, j] = j;
            for (i = 1; i <= n; i++) for (j = 1; j <= m; j++) {
                cost = (substr(a, i, 1) == substr(b, j, 1)) ? 0 : 1;
                v = d[i - 1, j] + 1; if (d[i, j - 1] + 1 < v) v = d[i, j - 1] + 1;
                if (d[i - 1, j - 1] + cost < v) v = d[i - 1, j - 1] + cost;
                d[i, j] = v }
            print d[n, m] }')
        if ((distance < best_distance)) || { ((distance == best_distance)) && [[ -z $best ]]; }; then
            best=$candidate; best_distance=$distance
        fi
        [[ $candidate != "$word"* ]] || { best=$candidate; break; }
    done
    [[ -z $best ]] || printf '%s' "$best"
}

