    fetch_interface_traffic
    if $JSON_OUTPUT; then
        cat "$TMP_DIR/status.json"
    elif $INTERACTIVE; then
        select_interface_interactively || return 0
        choose_interface_action || return 0
        apply_interface_action
    else
        list_interface_status false
    fi
}

