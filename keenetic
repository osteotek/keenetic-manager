fail() {
    local status=$EXIT_GENERAL
    if [[ ${1-} =~ ^[1-9][0-9]*$ ]]; then
        status=$1
        shift
    fi
    if [[ -n $OPERATION_CONTEXT ]]; then
        set -- "$OPERATION_CONTEXT: $*"
    fi
    if $WATCH_SCREEN; then
        printf '\033[?1049l\033[?25h'
        WATCH_SCREEN=false
        CURSOR_HIDDEN=false
    fi
    printf '%sError:%s %s\n' "$RED" "$RESET" "$*" >&2
    exit "$status"
}

warn() {
    printf '%sWarning:%s %s\n' "$YELLOW" "$RESET" "$*" >&2
}

success() {
    $QUIET || printf '%s%s%s\n' "$GREEN" "$*" "$RESET"
}

unchanged() {
    $QUIET || printf '%s%s%s\n' "$YELLOW" "$*" "$RESET"
}

info() {
    $QUIET || printf '%s\n' "$*"
}

debug() {
    if $VERBOSE; then
        printf '%sDebug: %s%s\n' "$DIM" "$*" "$RESET" >&2
    fi
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || fail "required command not found: $1"
}

add_client_selector() {
    local selector=$1 value=$2
    [[ -n $value ]] || fail "$EXIT_USAGE" "--$selector requires a non-empty value"
    if [[ $selector == mac ]]; then
        value=${value,,}
        [[ $value =~ ^([0-9a-f]{2}:){5}[0-9a-f]{2}$ ]] \
            || fail "$EXIT_USAGE" 'MAC address must use aa:bb:cc:dd:ee:ff format'
    fi
    CLIENT_SELECTORS+=("$selector")
    CLIENT_VALUES+=("$value")
}

declare -a CANONICAL_ARGS=()

# True when the remaining policy arguments already name a client or an action,
# in which case bare `policy` keeps its one-client picker semantics.
has_policy_action_args() {
    local word
    for word in "$@"; do
        case $word in
            --client|--client=*|--ip|--ip=*|--mac|--mac=*|--policy|--policy=*|--block|--unblock|--undo|-i|--interactive) return 0 ;;
        esac
    done
    return 1
}

# Translate the verb grammar (client show X, interface up ID, config init, ...)
# into the flag grammar the parser understands. Earlier spellings pass through
# unchanged, so existing scripts keep working.
canonicalize_args() {
    local -a args=("$@")
    local i=0 n=$# word group verb='' skip=0
    CANONICAL_ARGS=()
    while ((i < n)); do
        word=${args[i]}
        case $word in
            --) CANONICAL_ARGS=("${args[@]}"); return 0 ;;
            --router|--ca-file|--watch|--client|--ip|--mac|--policy|--top|--period|--interface|--limit|--filter|--server|--port|--duration|--sample|--radio)
                CANONICAL_ARGS+=("$word" "${args[i + 1]-}"); i=$((i + 2)); continue ;;
            -*) CANONICAL_ARGS+=("$word"); i=$((i + 1)); continue ;;
        esac
        break
    done
    ((i < n)) || return 0
    group=${args[i]}; i=$((i + 1))
    if ((i < n)) && [[ ${args[i]} != -* ]]; then verb=${args[i]}; fi
    case $group in
        status) ;;
        client|clients)
            case $verb in
                '') CANONICAL_ARGS+=(clients) ;;
                list) CANONICAL_ARGS+=(clients); skip=1 ;;
                show|inspect) CANONICAL_ARGS+=(clients inspect); skip=1 ;;
                rename) CANONICAL_ARGS+=(clients rename); skip=1 ;;
                wake) CANONICAL_ARGS+=(wake); skip=1 ;;
                block|unblock) CANONICAL_ARGS+=(policy "$verb"); skip=1 ;;
                assign|set) CANONICAL_ARGS+=(policy set); skip=1 ;;
                nat|connections)
                    CANONICAL_ARGS+=(connections); skip=1
                    if ((i + 1 < n)) && [[ ${args[i + 1]} != -* ]]; then CANONICAL_ARGS+=(--client "${args[i + 1]}"); skip=2; fi ;;
                *) fail "$EXIT_USAGE" "unknown client verb: $verb. Use list, show, rename, wake, block, unblock, assign, or nat." ;;
            esac ;;
        policy|policies)
            case $verb in
                '') CANONICAL_ARGS+=(policy); has_policy_action_args "${args[@]:i}" || CANONICAL_ARGS+=(list) ;;
                list) CANONICAL_ARGS+=(policy list); skip=1 ;;
                show) CANONICAL_ARGS+=(policy inspect); skip=1 ;;
                assign) CANONICAL_ARGS+=(policy set); skip=1 ;;
                undo) CANONICAL_ARGS+=(policy --undo); skip=1 ;;
                *) CANONICAL_ARGS+=(policy) ;;
            esac ;;
        interface|interfaces)
            case $verb in
                '') CANONICAL_ARGS+=(interfaces) ;;
                list) CANONICAL_ARGS+=(interfaces); skip=1 ;;
                show|inspect) CANONICAL_ARGS+=(interfaces inspect); skip=1 ;;
                rates) CANONICAL_ARGS+=(interfaces --rates); skip=1 ;;
                up|down) CANONICAL_ARGS+=(interfaces "$verb"); skip=1 ;;
                *) fail "$EXIT_USAGE" "unknown interface verb: $verb. Use list, show, rates, up, or down." ;;
            esac ;;
        wifi)
            case $verb in
                ''|clients|scan|monitor) CANONICAL_ARGS+=(wifi) ;;
                list) CANONICAL_ARGS+=(wifi); skip=1 ;;
                load) CANONICAL_ARGS+=(wifi monitor); skip=1 ;;
                *) fail "$EXIT_USAGE" "unknown wifi verb: $verb. Use list, clients, scan, or load." ;;
            esac ;;
        nat|connections)
            CANONICAL_ARGS+=(connections)
            [[ $verb != list && $verb != show ]] || skip=1 ;;
        system)
            CANONICAL_ARGS+=(system)
            [[ $verb != show ]] || skip=1 ;;
        log|logs)
            CANONICAL_ARGS+=(logs)
            [[ $verb != show ]] || skip=1 ;;
        config)
            case $verb in
                init) CANONICAL_ARGS+=(--init); skip=1 ;;
                discover) CANONICAL_ARGS+=(--discover); skip=1 ;;
                '')
                    local wants_help=false
                    for word in "${args[@]:i}"; do
                        [[ $word != -h && $word != --help ]] || wants_help=true
                    done
                    $wants_help || fail "$EXIT_USAGE" 'use config init or config discover'
                    CANONICAL_ARGS+=(--init) ;;
                *) fail "$EXIT_USAGE" "unknown config verb: $verb. Use init or discover." ;;
            esac ;;
        wan|dhcp|routes|mesh|forwards|traffic|vpn)
            CANONICAL_ARGS+=("$group")
            [[ $verb != list && $verb != show ]] || skip=1 ;;
        *) CANONICAL_ARGS+=("$group") ;;
    esac
    CANONICAL_ARGS+=("${args[@]:i + skip}")
}

validate_client_name() {
    [[ -n $1 && ${#1} -le 255 && $1 != *[[:cntrl:]]* ]] \
        || fail "$EXIT_USAGE" 'client name must contain 1–255 characters without control characters'
}

# Positional NAME|IP|MAC selectors for verb-style policy commands.
add_auto_selector() {
    local value=$1
    if [[ ${value,,} =~ ^([0-9a-f]{2}:){5}[0-9a-f]{2}$ ]]; then
        add_client_selector mac "$value"
    elif [[ $value =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ || ( $value == *:*:* && $value =~ ^[0-9a-fA-F:.]+$ ) ]]; then
        add_client_selector ip "$value"
    else
        add_client_selector client "$value"
    fi
}

set_action() {
    local action=$1
    [[ -z $ACTION || $ACTION == "$action" ]] \
        || fail "$EXIT_USAGE" 'use only one of --policy, --block, or --unblock'
    ACTION=$action
}

parse_args() {
    local scope=root selector help=false version=false suggestion
    local -a positional=()
    canonicalize_args "$@"
    set -- "${CANONICAL_ARGS[@]}"
    while (($#)); do
        if [[ $scope == root ]]; then
            case $1 in
                policy|wake|interfaces|traffic|wifi|clients|system|vpn|diagnose|logs|wan|dhcp|routes|mesh|speedtest|connections|forwards|--watch|--watch=*|--all|--json|--init|--discover|-i|--interactive|--router|--router=*|--ca-file|--ca-file=*|--insecure|-q|--quiet|-v|--verbose|--color|--color=*|--no-color|-h|--help|-V|--version) ;;
                -*) fail "$EXIT_USAGE" "unknown command or option: $1. Run '$PROGRAM --help'." ;;
                *) suggestion=$(suggest_command "$1")
                   [[ -z $suggestion ]] || suggestion=" Did you mean '$PROGRAM $suggestion'?"
                   fail "$EXIT_USAGE" "unknown command: $1.$suggestion Run '$PROGRAM --help'." ;;
            esac
        elif [[ $scope == wan || $scope == dhcp || $scope == routes || $scope == mesh || $scope == connections || $scope == forwards || $scope == speedtest ]]; then
            case $1 in
                --json|--watch|--watch=*|--router|--router=*|--ca-file|--ca-file=*|--insecure|-q|--quiet|-v|--verbose|--color|--color=*|--no-color|-h|--help|-V|--version) ;;
                --client|--client=*) [[ $scope == connections ]] || fail "$EXIT_USAGE" '--client is only valid for connections' ;;
                -i|--interactive) [[ $scope == connections || $scope == speedtest ]] || fail "$EXIT_USAGE" "$1 is not valid for $scope" ;;
                --server|--server=*|--port|--port=*|--duration|--duration=*|--reverse|--interface|--interface=*|--dry-run)
                    [[ $scope == speedtest ]] || fail "$EXIT_USAGE" "$1 is only valid for speedtest" ;;
                *) fail "$EXIT_USAGE" "unknown option for $scope: $1" ;;
            esac
        elif [[ $scope == clients || $scope == system || $scope == vpn || $scope == diagnose || $scope == logs ]]; then
            case $1 in
                --json|--watch|--watch=*|--router|--router=*|--ca-file|--ca-file=*|--insecure|-q|--quiet|-v|--verbose|--color|--color=*|--no-color|-h|--help|-V|--version|--) ;;
                --dry-run) [[ $scope == system || $scope == clients ]] || fail "$EXIT_USAGE" "$1 is only valid for system actions or clients rename" ;;
                --all|--offline) [[ $scope == clients ]] || fail "$EXIT_USAGE" "$1 is only valid for client listings" ;;
                -i|--interactive) [[ $scope == clients || $scope == diagnose || $scope == logs ]] || fail "$EXIT_USAGE" "$1 is not valid for $scope" ;;
                -y|--yes) [[ $scope == system ]] || fail "$EXIT_USAGE" "$1 is only valid for system reboot" ;;
                --interface|--interface=*) [[ $scope == diagnose || $scope == speedtest ]] || fail "$EXIT_USAGE" "$1 is only valid for diagnose" ;;
                --limit|--limit=*|--filter|--filter=*) [[ $scope == logs ]] || fail "$EXIT_USAGE" "$1 is only valid for logs" ;;
                -*) fail "$EXIT_USAGE" "unknown option for $scope: $1" ;;
            esac
        elif [[ $scope == wifi ]]; then
            case $1 in
                monitor|clients|scan|-i|--interactive|--radio|--radio=*|--watch|--watch=*|--all|--json|--router|--router=*|--ca-file|--ca-file=*|--insecure|-q|--quiet|-v|--verbose|--color|--color=*|--no-color|-h|--help|-V|--version) ;;
                *) fail "$EXIT_USAGE" "unknown option for wifi: $1. Run '$PROGRAM wifi --help'." ;;
            esac
        elif [[ $scope == traffic ]]; then
            case $1 in
                --watch|--watch=*|--top|--top=*|--period|--period=*|--json|--router|--router=*|--ca-file|--ca-file=*|--insecure|-q|--quiet|-v|--verbose|--color|--color=*|--no-color|-h|--help|-V|--version) ;;
                *) fail "$EXIT_USAGE" "unknown option for traffic: $1. Run '$PROGRAM traffic --help'." ;;
            esac
        elif [[ $scope == interfaces ]]; then
            case $1 in
                inspect|--rates|--sample|--sample=*|--watch|--watch=*|--all|--json|-i|--interactive|--dry-run|--router|--router=*|--ca-file|--ca-file=*|--insecure|-q|--quiet|-v|--verbose|--color|--color=*|--no-color|-h|--help|-V|--version) ;;
                -*) fail "$EXIT_USAGE" "unknown option for interfaces: $1. Run '$PROGRAM interfaces --help'." ;;
            esac
        elif [[ $scope == wake ]]; then
            case $1 in
                --client|--client=*|--ip|--ip=*|--mac|--mac=*|-i|--interactive|--dry-run|--router|--router=*|--ca-file|--ca-file=*|--insecure|-q|--quiet|-v|--verbose|--color|--color=*|--no-color|-h|--help|-V|--version|--) ;;
                -*) fail "$EXIT_USAGE" "unknown option for wake: $1. Run '$PROGRAM wake --help'." ;;
            esac
        fi
        case $1 in
            policy|wake|interfaces|traffic|wifi|clients|system|vpn|diagnose|logs|wan|dhcp|routes|mesh|speedtest|connections|forwards)
                if [[ $scope == root ]]; then
                    $INIT_CONFIG || $DISCOVER \
                        && fail "$EXIT_USAGE" '--init and --discover cannot be combined with a subcommand'
                    scope=$1
                    COMMAND=$scope
                    [[ $scope != wake ]] || ACTION=wake
                else
                    positional+=("$1")
                fi
                ;;
            -h|--help)
                help=true
                ;;
            -V|--version)
                version=true
                ;;
            -i|--interactive)
                INTERACTIVE=true
                ;;
            -y|--yes)
                ASSUME_YES=true
                ;;
            --rates) [[ $scope == interfaces ]] || fail "$EXIT_USAGE" '--rates is only valid for interfaces'; INTERFACE_RATES=true ;;
            --reverse) [[ $scope == speedtest ]] || fail "$EXIT_USAGE" '--reverse is only valid for speedtest'; SPEED_REVERSE=true ;;
            --server|--port|--duration|--sample|--radio)
                case $scope:$1 in
                    speedtest:--server|speedtest:--port|speedtest:--duration|interfaces:--sample|wifi:--radio) ;;
                    *) fail "$EXIT_USAGE" "$1 is not valid for $scope" ;;
                esac
                if ! { (($# >= 2)) && [[ -n $2 ]]; }; then
                    fail "$EXIT_USAGE" "$1 requires a value"
                fi
                case $1 in
                    --server) SPEED_SERVER=$2 ;; --port) SPEED_PORT=$2 ;; --duration) SPEED_DURATION=$2 ;;
                    --sample) RATE_INTERVAL=$2; RATE_SAMPLE_SET=true ;; --radio) SCAN_RADIO=$2 ;;
                esac
                shift ;;
            --server=*|--port=*|--duration=*|--sample=*|--radio=*)
                case $scope:${1%%=*} in
                    speedtest:--server|speedtest:--port|speedtest:--duration|interfaces:--sample|wifi:--radio) ;;
                    *) fail "$EXIT_USAGE" "${1%%=*} is not valid for $scope" ;;
                esac
                [[ -n ${1#*=} ]] || fail "$EXIT_USAGE" "${1%%=*} requires a value"
                case $1 in
                    --server=*) SPEED_SERVER=${1#*=} ;; --port=*) SPEED_PORT=${1#*=} ;; --duration=*) SPEED_DURATION=${1#*=} ;;
                    --sample=*) RATE_INTERVAL=${1#*=}; RATE_SAMPLE_SET=true ;; --radio=*) SCAN_RADIO=${1#*=} ;;
                esac ;;
            --watch|--interface|--limit|--filter)
                (($# >= 2)) || fail "$EXIT_USAGE" "$1 requires a value"
                case $1 in
                    --watch) WATCH_INTERVAL=$2 ;;
                    --interface) [[ $scope == diagnose || $scope == speedtest ]] || fail "$EXIT_USAGE" '--interface is only valid for diagnose or speedtest'; DIAG_INTERFACE=$2 ;;
                    --limit) [[ $scope == logs ]] || fail "$EXIT_USAGE" '--limit is only valid for logs'; LOG_LIMIT=$2 ;;
                    --filter) [[ $scope == logs ]] || fail "$EXIT_USAGE" '--filter is only valid for logs'; LOG_FILTER=$2 ;;
                esac
                [[ -n $2 ]] || fail "$EXIT_USAGE" "$1 requires a non-empty value"
                shift
                ;;
            --watch=*|--interface=*|--limit=*|--filter=*)
                [[ -n ${1#*=} ]] || fail "$EXIT_USAGE" "${1%%=*} requires a non-empty value"
                case $1 in
                    --watch=*) WATCH_INTERVAL=${1#*=} ;;
                    --interface=*) [[ $scope == diagnose || $scope == speedtest ]] || fail "$EXIT_USAGE" '--interface is only valid for diagnose or speedtest'; DIAG_INTERFACE=${1#*=} ;;
                    --limit=*) [[ $scope == logs ]] || fail "$EXIT_USAGE" '--limit is only valid for logs'; LOG_LIMIT=${1#*=} ;;
                    --filter=*) [[ $scope == logs ]] || fail "$EXIT_USAGE" '--filter is only valid for logs'; LOG_FILTER=${1#*=} ;;
                esac
                ;;
            --top|--period)
                [[ $scope == traffic ]] || fail "$EXIT_USAGE" "$1 is only valid for traffic"
                (($# >= 2)) || fail "$EXIT_USAGE" "$1 requires a value"
                if [[ $1 == --top ]]; then TRAFFIC_TOP=$2; else TRAFFIC_PERIOD=$2; fi
                shift
                ;;
            --top=*|--period=*)
                [[ $scope == traffic ]] || fail "$EXIT_USAGE" "${1%%=*} is only valid for traffic"
                if [[ $1 == --top=* ]]; then TRAFFIC_TOP=${1#*=}; else TRAFFIC_PERIOD=${1#*=}; fi
                ;;
            --client|--ip|--mac)
                (($# >= 2)) || fail "$EXIT_USAGE" "$1 requires a value"
                if [[ $scope == connections ]]; then
                    [[ -z $INSPECT_QUERY && -n $2 ]] || fail "$EXIT_USAGE" 'connections accepts one non-empty --client'
                    INSPECT_QUERY=$2
                else add_client_selector "${1#--}" "$2"; fi
                shift
                ;;
            --client=*|--ip=*|--mac=*)
                selector=${1%%=*}
                if [[ $scope == connections ]]; then
                    [[ -z $INSPECT_QUERY && -n ${1#*=} ]] || fail "$EXIT_USAGE" 'connections accepts one non-empty --client'
                    INSPECT_QUERY=${1#*=}
                else add_client_selector "${selector#--}" "${1#*=}"; fi
                ;;
            --policy)
                (($# >= 2)) || fail "$EXIT_USAGE" '--policy requires an ID or description'
                [[ -n $2 ]] || fail "$EXIT_USAGE" '--policy requires a non-empty ID or description'
                set_action policy
                POLICY_QUERY=$2
                shift
                ;;
            --policy=*)
                set_action policy
                POLICY_QUERY=${1#*=}
                [[ -n $POLICY_QUERY ]] || fail "$EXIT_USAGE" '--policy requires a non-empty ID or description'
                ;;
            --block)
                set_action block
                ;;
            --unblock)
                set_action unblock
                ;;
            --wake)
                fail "$EXIT_USAGE" "use the '$PROGRAM wake' subcommand instead of --wake"
                ;;
            --undo)
                UNDO=true
                ;;
            --dry-run)
                DRY_RUN=true
                ;;
            --all)
                [[ $VIEW_MODE == connected || $VIEW_MODE == all ]] \
                    || fail "$EXIT_USAGE" '--all and --offline cannot be combined'
                VIEW_MODE=all
                ;;
            --offline)
                [[ $VIEW_MODE == connected || $VIEW_MODE == offline ]] \
                    || fail "$EXIT_USAGE" '--all and --offline cannot be combined'
                VIEW_MODE=offline
                ;;
            --router)
                (($# >= 2)) || fail "$EXIT_USAGE" '--router requires a profile name'
                ROUTER_PROFILE=$2
                shift
                ;;
            --router=*)
                ROUTER_PROFILE=${1#*=}
                ;;
            --discover)
                [[ $scope == root ]] || fail "$EXIT_USAGE" "use '$PROGRAM --discover' outside the policy subcommand"
                DISCOVER=true
                ;;
            --json)
                JSON_OUTPUT=true
                ;;
            -q|--quiet)
                QUIET=true
                ;;
            -v|--verbose)
                VERBOSE=true
                ;;
            --init)
                [[ $scope == root ]] || fail "$EXIT_USAGE" "use '$PROGRAM --init' outside the policy subcommand"
                INIT_CONFIG=true
                ;;
            --ca-file)
                (($# >= 2)) || fail "$EXIT_USAGE" '--ca-file requires a path'
                CLI_CA_FILE=$2
                shift
                ;;
            --ca-file=*)
                CLI_CA_FILE=${1#*=}
                ;;
            --insecure)
                CLI_INSECURE=true
                ;;
            --color)
                COLOR_MODE=always
                ;;
            --color=auto|--color=always|--color=never)
                COLOR_MODE=${1#*=}
                ;;
            --color=*)
                fail "$EXIT_USAGE" '--color must be auto, always, or never'
                ;;
            --no-color)
                COLOR_MODE=never
                ;;
            --)
                shift
                while (($#)); do
                    positional+=("$1")
                    shift
                done
                break
                ;;
            -*)
                fail "$EXIT_USAGE" "unknown option: $1"
                ;;
            *)
                positional+=("$1")
                ;;
        esac
        shift
    done

    if $help; then
        case $scope in
            root) usage ;;
            policy) policy_usage ;;
            interfaces) interfaces_usage ;;
            traffic) traffic_usage ;;
            wifi) wifi_usage ;;
            clients|system|vpn|diagnose|logs|wan|dhcp|routes|mesh|speedtest|connections|forwards) read_command_usage ;;
            wake) wake_usage ;;
        esac
        exit 0
    fi
    if $version; then
        printf '%s %s\n' "$PROGRAM" "$VERSION"
        exit 0
    fi
    if [[ $COMMAND == traffic ]]; then
        if ! { [[ $TRAFFIC_TOP =~ ^[1-9][0-9]{0,9}$ ]] && ((TRAFFIC_TOP <= 2147483647)); }; then
            fail "$EXIT_USAGE" '--top requires a positive integer (maximum 2147483647)'
        fi
        case $TRAFFIC_PERIOD in
            3m|1h|3h|1d) ;;
            *) fail "$EXIT_USAGE" '--period must be 3m, 1h, 3h, or 1d' ;;
        esac
    fi
    if [[ $VIEW_MODE != connected ]] && { $INIT_CONFIG || $DISCOVER || [[ $COMMAND == wake || $COMMAND == traffic || $COMMAND == system || $COMMAND == vpn || $COMMAND == logs || $COMMAND == diagnose || $COMMAND == wan || $COMMAND == dhcp || $COMMAND == routes || $COMMAND == mesh || $COMMAND == connections || $COMMAND == forwards || $COMMAND == speedtest ]]; }; then
        fail "$EXIT_USAGE" '--all is only valid for interface or policy listings'
    fi
    case $COMMAND in
        clients)
            if ((${#positional[@]})); then
                case ${positional[0]} in
                    inspect)
                        [[ ${#positional[@]} == 2 ]] || { $INTERACTIVE && [[ ${#positional[@]} == 1 ]]; } \
                            || fail "$EXIT_USAGE" 'use clients inspect NAME|IP|MAC, or clients inspect --interactive' ;;
                    rename)
                        if $INTERACTIVE; then
                            [[ ${#positional[@]} == 1 ]] || fail "$EXIT_USAGE" 'clients rename --interactive picks the client and asks for the new name'
                        else
                            [[ ${#positional[@]} == 3 ]] || fail "$EXIT_USAGE" 'use clients rename NAME|IP|MAC NEW_NAME, or clients rename --interactive'
                            NEW_CLIENT_NAME=${positional[2]}
                            validate_client_name "$NEW_CLIENT_NAME"
                        fi
                        ;;
                    *) fail "$EXIT_USAGE" 'use clients inspect or clients rename' ;;
                esac
                SUBCOMMAND=${positional[0]}; INSPECT_QUERY=${positional[1]-}; positional=()
            fi ;;
        policy)
            case ${positional[0]-} in
                list)
                    [[ ${#positional[@]} == 1 ]] || fail "$EXIT_USAGE" 'policy list takes no arguments'
                    SUBCOMMAND=list; positional=() ;;
                inspect)
                    [[ ${#positional[@]} == 2 ]] || { $INTERACTIVE && [[ ${#positional[@]} == 1 ]]; } \
                        || fail "$EXIT_USAGE" 'policy show requires a policy name or ID, or --interactive'
                    SUBCOMMAND=inspect; INSPECT_QUERY=${positional[1]-}; positional=() ;;
                set)
                    ((${#positional[@]} >= 3)) || fail "$EXIT_USAGE" 'use policy set NAME|IP|MAC... POLICY'
                    set_action policy
                    POLICY_QUERY=${positional[-1]}
                    [[ -n $POLICY_QUERY ]] || fail "$EXIT_USAGE" 'policy set requires a non-empty policy ID or description'
                    for value in "${positional[@]:1:${#positional[@]}-2}"; do add_auto_selector "$value"; done
                    positional=() ;;
                block|unblock)
                    ((${#positional[@]} >= 2)) || fail "$EXIT_USAGE" "use policy ${positional[0]} NAME|IP|MAC..."
                    set_action "${positional[0]}"
                    for value in "${positional[@]:1}"; do add_auto_selector "$value"; done
                    positional=() ;;
            esac ;;
        wifi)
            if ((${#positional[@]})); then
                [[ ${#positional[@]} == 1 ]] || fail "$EXIT_USAGE" 'use wifi monitor, wifi clients, or wifi scan'
                case ${positional[0]} in monitor|clients|scan) ;; *) fail "$EXIT_USAGE" 'use wifi monitor, wifi clients, or wifi scan' ;; esac
                SUBCOMMAND=${positional[0]}; positional=()
            fi ;;
        vpn)
            [[ ${#positional[@]} == 0 || ( ${#positional[@]} == 1 && ${positional[0]} == peers ) ]] || fail "$EXIT_USAGE" 'use vpn peers'
            SUBCOMMAND=peers; positional=() ;;
        system)
            if ((${#positional[@]})); then
                [[ ${#positional[@]} == 1 ]] || fail "$EXIT_USAGE" 'use system, system changes, system save, or system reboot'
                case ${positional[0]} in reboot|save|changes) ;; *) fail "$EXIT_USAGE" 'use system, system changes, system save, or system reboot' ;; esac
                SUBCOMMAND=${positional[0]}; positional=()
            fi ;;
        interfaces)
            if ((${#positional[@]})); then
                case ${positional[0]} in
                    inspect)
                        if [[ ${#positional[@]} != 2 ]] && { ! $INTERACTIVE || [[ ${#positional[@]} != 1 ]]; }; then
                            fail "$EXIT_USAGE" 'use interface show ID, or interface show --interactive'
                        fi ;;
                    up|down)
                        [[ ${#positional[@]} == 2 && -n ${positional[1]} ]] || fail "$EXIT_USAGE" "use interface ${positional[0]} ID"
                        ! $INTERACTIVE || fail "$EXIT_USAGE" "interface ${positional[0]} takes an ID; use interface --interactive to pick one" ;;
                    *) fail "$EXIT_USAGE" 'use interface list, show ID, rates, up ID, or down ID' ;;
                esac
                SUBCOMMAND=${positional[0]}; INSPECT_QUERY=${positional[1]-}; positional=()
            fi ;;
        logs|wan|dhcp|routes|mesh|speedtest|connections|forwards) ((${#positional[@]} == 0)) || fail "$EXIT_USAGE" "$COMMAND does not accept positional arguments" ;;
        diagnose)
            [[ ${#positional[@]} == 1 ]] || fail "$EXIT_USAGE" 'diagnose requires a hostname or IP address'
            DIAG_HOST=${positional[0]}; positional=()
            [[ $DIAG_HOST =~ ^[a-zA-Z0-9:][a-zA-Z0-9.:%_-]*$ && ${#DIAG_HOST} -le 253 ]] || fail "$EXIT_USAGE" 'invalid diagnostic hostname or IP address' ;;
    esac
    if [[ $SUBCOMMAND == reboot || $SUBCOMMAND == save || $SUBCOMMAND == rename || $SUBCOMMAND == up || $SUBCOMMAND == down ]]; then
        if [[ -n $WATCH_INTERVAL ]] || $JSON_OUTPUT || { $INTERACTIVE && [[ $SUBCOMMAND != rename ]]; } || [[ $VIEW_MODE != connected ]] || ((${#CLIENT_SELECTORS[@]})); then
            fail "$EXIT_USAGE" "$COMMAND $SUBCOMMAND cannot be combined with listing or interactive options"
        fi
    fi
    if [[ $COMMAND == policy && $SUBCOMMAND == list ]]; then
        [[ $VIEW_MODE == connected ]] || fail "$EXIT_USAGE" 'policy list shows policies; use client list --all or --offline for clients'
        if $INTERACTIVE || $UNDO || $DRY_RUN || [[ -n $ACTION ]] || ((${#CLIENT_SELECTORS[@]})); then
            fail "$EXIT_USAGE" 'policy list cannot be combined with client selectors or actions'
        fi
    fi
    if [[ $COMMAND == interfaces ]]; then
        if ! { [[ $RATE_INTERVAL =~ ^[1-9][0-9]?$ ]] && ((RATE_INTERVAL <= 60)); }; then fail "$EXIT_USAGE" '--sample must be between 1 and 60 seconds'; fi
        ! $RATE_SAMPLE_SET || $INTERFACE_RATES || fail "$EXIT_USAGE" '--sample requires --rates'
        if $INTERFACE_RATES && { $INTERACTIVE || [[ $SUBCOMMAND == inspect ]]; }; then fail "$EXIT_USAGE" '--rates is only valid for interface listings'; fi
    fi
    if [[ $COMMAND == wifi ]]; then
        ! $INTERACTIVE || [[ $SUBCOMMAND == scan ]] || fail "$EXIT_USAGE" '--interactive picks a radio for wifi scan'
        [[ -z $SCAN_RADIO || $SUBCOMMAND == scan ]] || fail "$EXIT_USAGE" '--radio requires wifi scan'
        [[ $SUBCOMMAND != clients || $VIEW_MODE == connected ]] || fail "$EXIT_USAGE" 'wifi clients lists associated stations only'
    fi
    if [[ $COMMAND == speedtest ]]; then
        { $INTERACTIVE && [[ -z $SPEED_SERVER ]]; } || [[ $SPEED_SERVER =~ ^[a-zA-Z0-9:][a-zA-Z0-9.:%_-]*$ && ${#SPEED_SERVER} -le 253 ]] \
            || fail "$EXIT_USAGE" 'speedtest requires --server HOST, or --interactive to pick one'
        if ! { [[ $SPEED_PORT =~ ^[1-9][0-9]{0,4}$ ]] && ((SPEED_PORT <= 65535)); }; then fail "$EXIT_USAGE" '--port must be between 1 and 65535'; fi
        if ! { [[ $SPEED_DURATION =~ ^[1-9][0-9]?$ ]] && ((SPEED_DURATION <= 30)); }; then fail "$EXIT_USAGE" '--duration must be between 1 and 30 seconds'; fi
        $DRY_RUN && $JSON_OUTPUT && fail "$EXIT_USAGE" 'speedtest --dry-run cannot be combined with --json'
    fi
    [[ $SUBCOMMAND != inspect && $SUBCOMMAND != rename || -n $INSPECT_QUERY ]] || $INTERACTIVE || fail "$EXIT_USAGE" 'inspect requires a non-empty name or ID'
    if [[ $SUBCOMMAND == inspect ]] && { { $INTERACTIVE && [[ -n $INSPECT_QUERY ]]; } || $DRY_RUN || $UNDO || [[ -n $ACTION ]] || ((${#CLIENT_SELECTORS[@]})); }; then
        fail "$EXIT_USAGE" 'inspect cannot be combined with client selectors or actions'
    fi
    if [[ $COMMAND == logs ]]; then
        if ! { [[ $LOG_LIMIT =~ ^[1-9][0-9]{0,3}$ ]] && ((LOG_LIMIT <= 1000)); }; then
            fail "$EXIT_USAGE" '--limit must be between 1 and 1000'
        fi
    fi
    for value in "${positional[@]}"; do
        add_auto_selector "$value"
    done
    if [[ -n $ROUTER_PROFILE ]]; then
        [[ $ROUTER_PROFILE =~ ^[A-Za-z0-9._-]+$ ]] \
            || fail "$EXIT_USAGE" 'router profile may contain only letters, digits, dots, underscores, and hyphens'
        $CONFIG_ENV_SET && fail "$EXIT_USAGE" '--router cannot be combined with KEENETIC_CONFIG'
        CONFIG_FILE=$CONFIG_HOME/routers/$ROUTER_PROFILE
    fi
    $CLI_INSECURE && [[ -n $CLI_CA_FILE ]] \
        && fail "$EXIT_USAGE" '--insecure and --ca-file cannot be combined'
    if $DISCOVER; then
        $INIT_CONFIG || $INTERACTIVE || $JSON_OUTPUT || $UNDO || [[ -n $ACTION ]] || ((${#CLIENT_SELECTORS[@]} > 0)) \
            && fail "$EXIT_USAGE" '--discover must be used alone'
    fi
    ! $ASSUME_YES || [[ $SUBCOMMAND == reboot ]] || fail "$EXIT_USAGE" '--yes is only valid for system reboot'
    if [[ $COMMAND == connections ]] && $INTERACTIVE && [[ -n $INSPECT_QUERY ]]; then
        fail "$EXIT_USAGE" '--interactive picks the client itself; drop --client'
    fi
    if $UNDO; then
        $JSON_OUTPUT || $INIT_CONFIG || [[ -n $ACTION ]] || ((${#CLIENT_SELECTORS[@]} > 0)) \
            && fail "$EXIT_USAGE" '--undo cannot be combined with another action or client selector'
    fi
    if $INIT_CONFIG; then
        $INTERACTIVE || $JSON_OUTPUT || [[ -n $ACTION ]] || ((${#CLIENT_SELECTORS[@]} > 0)) \
            && fail "$EXIT_USAGE" '--init cannot be combined with a client, action, --interactive, or --json'
    fi
    if $JSON_OUTPUT && { $INTERACTIVE || [[ -n $ACTION ]] || ((${#CLIENT_SELECTORS[@]} > 0)); }; then
        fail "$EXIT_USAGE" '--json is only valid for non-interactive listings'
    fi
    if [[ -n $ACTION ]] && ((${#CLIENT_SELECTORS[@]} == 0)) && ! $INTERACTIVE; then
        fail "$EXIT_USAGE" 'an action requires at least one --client, --ip, or --mac selector, or --interactive'
    fi
    if $INTERACTIVE && { [[ -n $ACTION && $ACTION != wake ]] || ((${#CLIENT_SELECTORS[@]} > 0)); }; then
        fail "$EXIT_USAGE" '--interactive selects the client and action itself'
    fi
    if ((${#CLIENT_SELECTORS[@]} > 1)) && [[ -z $ACTION ]]; then
        fail "$EXIT_USAGE" 'multiple client selectors require an explicit action'
    fi
    if $DRY_RUN && [[ -z $ACTION && $SUBCOMMAND != reboot && $SUBCOMMAND != save && $SUBCOMMAND != rename && $SUBCOMMAND != up && $SUBCOMMAND != down && $COMMAND != speedtest ]] && ! $INTERACTIVE && ! $UNDO; then
        fail "$EXIT_USAGE" '--dry-run requires an action, --interactive, undo, interface up/down, or system reboot'
    fi
    if [[ -n $WATCH_INTERVAL ]]; then
        if ! { [[ $WATCH_INTERVAL =~ ^[1-9][0-9]{0,3}$ ]] && ((WATCH_INTERVAL <= 3600)); }; then
            fail "$EXIT_USAGE" '--watch must be between 1 and 3600 seconds'
        fi
        $INIT_CONFIG || $DISCOVER || $INTERACTIVE || $DRY_RUN || $UNDO || [[ -n $ACTION || $COMMAND == diagnose || $COMMAND == speedtest || ( $COMMAND == wifi && $SUBCOMMAND == scan ) ]] || ((${#CLIENT_SELECTORS[@]})) \
            && fail "$EXIT_USAGE" '--watch is only available for read-only views'
        [[ -t 1 ]] || $JSON_OUTPUT || fail "$EXIT_USAGE" '--watch requires a terminal or --json'
    fi
}

init_colors() {
    local enabled=false
    if [[ $COLOR_MODE == always ]]; then
        enabled=true
    elif [[ $COLOR_MODE == auto ]] && [[ -t 1 && -t 2 ]] && [[ ! -v NO_COLOR ]] && ! $JSON_OUTPUT; then
        enabled=true
    fi

    if $enabled; then
        RED=$'\033[31m'
        GREEN=$'\033[32m'
        YELLOW=$'\033[33m'
        DIM=$'\033[2m'
        HIGHLIGHT=$'\033[7m'
        RESET=$'\033[0m'
    fi
    COLOR_ARGS=(--arg red "$RED" --arg green "$GREEN" --arg yellow "$YELLOW" --arg dim "$DIM" --arg reset "$RESET")
}

trim_key() {
    local value=$1
    value=${value#"${value%%[![:space:]]*}"}
    value=${value%"${value##*[![:space:]]}"}
    printf '%s' "$value"
}

resolve_password() {
    local password source_count=0
    local -a password_command password_lines
    [[ -n $ROUTER_PASSWORD ]] && ((source_count += 1))
    [[ -n $ROUTER_PASSWORD_COMMAND ]] && ((source_count += 1))
    [[ -n $ROUTER_PASSWORD_FILE ]] && ((source_count += 1))
    ((source_count <= 1)) \
        || fail "set exactly one of ROUTER_PASSWORD, ROUTER_PASSWORD_COMMAND, or ROUTER_PASSWORD_FILE in $CONFIG_FILE"

    if [[ -n $ROUTER_PASSWORD_COMMAND ]]; then
        read -r -a password_command <<< "$ROUTER_PASSWORD_COMMAND"
        ((${#password_command[@]} > 0)) || fail 'ROUTER_PASSWORD_COMMAND is empty'
        command -v "${password_command[0]}" >/dev/null 2>&1 \
            || fail "password command not found: ${password_command[0]}"
        if ! password=$("${password_command[@]}"); then
            fail 'ROUTER_PASSWORD_COMMAND failed'
        fi
        [[ -n $password ]] || fail 'ROUTER_PASSWORD_COMMAND returned an empty password'
        [[ $password != *$'\n'* ]] || fail 'ROUTER_PASSWORD_COMMAND returned more than one line'
        ROUTER_PASSWORD=$password
    elif [[ -n $ROUTER_PASSWORD_FILE ]]; then
        [[ -r $ROUTER_PASSWORD_FILE ]] || fail "cannot read password file: $ROUTER_PASSWORD_FILE"
        mapfile -t password_lines < "$ROUTER_PASSWORD_FILE"
        ((${#password_lines[@]} == 1)) \
            || fail 'ROUTER_PASSWORD_FILE must contain exactly one line'
        [[ -n ${password_lines[0]} ]] || fail 'ROUTER_PASSWORD_FILE contains an empty password'
        ROUTER_PASSWORD=${password_lines[0]}
    fi
    [[ -n $ROUTER_PASSWORD ]] \
        || fail "set ROUTER_PASSWORD, ROUTER_PASSWORD_COMMAND, or ROUTER_PASSWORD_FILE in $CONFIG_FILE"
}

validate_router_settings() {
    [[ -n $ROUTER_URL ]] || fail 'router URL cannot be empty'
    [[ -n $ROUTER_USERNAME ]] || fail 'router username cannot be empty'
    [[ $ROUTER_URL == http://* || $ROUTER_URL == https://* ]] \
        || fail 'router URL must start with http:// or https://'
    ROUTER_URL=${ROUTER_URL%/}
    [[ $ROUTER_INSECURE == true || $ROUTER_INSECURE == false ]] \
        || fail 'ROUTER_INSECURE must be true or false'
    [[ $ROUTER_ALLOW_HTTP == true || $ROUTER_ALLOW_HTTP == false ]] \
        || fail 'ROUTER_ALLOW_HTTP must be true or false'
    if [[ -n $ROUTER_CA_FILE && $ROUTER_INSECURE == true ]]; then
        fail 'ROUTER_CA_FILE and ROUTER_INSECURE=true cannot be combined'
    fi
    if [[ -n $ROUTER_CA_FILE && ! -r $ROUTER_CA_FILE ]]; then
        fail "cannot read router CA file: $ROUTER_CA_FILE"
    fi
    resolve_password
}

load_config() {
    [[ -r $CONFIG_FILE ]] || fail "cannot read $CONFIG_FILE
Run '$PROGRAM --init' to create and test it."

    local line key value line_number=0 permissions
    while IFS= read -r line || [[ -n $line ]]; do
        ((line_number += 1))
        line=${line%$'\r'}
        [[ -z $line || $line =~ ^[[:space:]]*# ]] && continue
        [[ $line == *=* ]] || fail "$CONFIG_FILE:$line_number: expected KEY=VALUE"

        key=$(trim_key "${line%%=*}")
        value=${line#*=}
        case $key in
            ROUTER_URL) ROUTER_URL=$value ;;
            ROUTER_USERNAME) ROUTER_USERNAME=$value ;;
            ROUTER_PASSWORD) ROUTER_PASSWORD=$value ;;
            ROUTER_PASSWORD_COMMAND) ROUTER_PASSWORD_COMMAND=$value ;;
            ROUTER_PASSWORD_FILE) ROUTER_PASSWORD_FILE=$value ;;
            ROUTER_CA_FILE) ROUTER_CA_FILE=$value ;;
            ROUTER_INSECURE) ROUTER_INSECURE=${value,,} ;;
            ROUTER_ALLOW_HTTP) ROUTER_ALLOW_HTTP=${value,,} ;;
            *) fail "$CONFIG_FILE:$line_number: unknown setting: $key" ;;
        esac
    done < "$CONFIG_FILE"

    [[ -n $ROUTER_URL ]] || fail "ROUTER_URL is missing from $CONFIG_FILE"
    [[ -n $ROUTER_USERNAME ]] || fail "ROUTER_USERNAME is missing from $CONFIG_FILE"
    if [[ -n $CLI_CA_FILE ]]; then
        ROUTER_CA_FILE=$CLI_CA_FILE
        ROUTER_INSECURE=false
    fi
    if $CLI_INSECURE; then
        ROUTER_CA_FILE=
        ROUTER_INSECURE=true
    fi
    validate_router_settings

    if command -v stat >/dev/null 2>&1 && permissions=$(stat -c '%a' "$CONFIG_FILE" 2>/dev/null); then
        if [[ $permissions =~ ^[0-7]+$ ]] && (((8#$permissions & 077) != 0)); then
            warn "$CONFIG_FILE is readable by other users; run: chmod 600 '$CONFIG_FILE'"
        fi
    fi
    if [[ $ROUTER_URL == http://* ]]; then
        [[ $ROUTER_ALLOW_HTTP == true ]] \
            || warn "HTTP does not protect the authenticated router session; prefer HTTPS or KeenDNS. Set ROUTER_ALLOW_HTTP=true in $CONFIG_FILE to hide this."
    elif [[ $ROUTER_INSECURE == true ]]; then
        warn 'HTTPS certificate verification is disabled for this connection.'
    fi
}

show_cursor() {
    if $CURSOR_HIDDEN; then
        printf '\033[?25h' >&2
        CURSOR_HIDDEN=false
    fi
}

cleanup() {
    [[ -z $WATCH_SLEEP_PID ]] || kill "$WATCH_SLEEP_PID" 2>/dev/null || true
    if [[ -n $DIAG_ACTIVE_ENDPOINT && -n $TMP_DIR ]]; then
        (HTTP_TIMEOUT=3 http_request DELETE "$DIAG_ACTIVE_ENDPOINT" "$TMP_DIR/cancel.json") >/dev/null 2>&1 || true
    fi
    if $WATCH_SCREEN; then printf '\033[?1049l' || true; fi
    show_cursor
    [[ -z ${TMP_DIR:-} ]] || rm -rf -- "$TMP_DIR"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

create_temp_dir() {
    TMP_DIR=$(mktemp -d)
    chmod 700 "$TMP_DIR"
}

http_request() {
    local method=$1 endpoint=$2 output=$3 data=${4-} curl_status response_meta
    local -a arguments=(
        --silent
        --show-error
        --connect-timeout 5
        --max-time "${HTTP_TIMEOUT:-20}"
        --cookie "$TMP_DIR/cookies"
        --cookie-jar "$TMP_DIR/cookies"
        --dump-header "$TMP_DIR/headers"
        --output "$output"
        --write-out $'%{http_code}\t%{local_ip}'
        --request "$method"
    )
    if [[ $ROUTER_INSECURE == true ]]; then
        arguments+=(--insecure)
    elif [[ -n $ROUTER_CA_FILE ]]; then
        arguments+=(--cacert "$ROUTER_CA_FILE")
    fi

    if [[ $method == POST ]]; then
        arguments+=(--header 'Content-Type: application/json' --data "$data")
    fi

    debug "$method $endpoint"
    if response_meta=$(curl "${arguments[@]}" "$ROUTER_URL$endpoint"); then
        HTTP_STATUS=${response_meta%%$'\t'*}
        ROUTER_LOCAL_IP=${response_meta#*$'\t'}
        return 0
    else
        curl_status=$?
    fi

    case $curl_status in
        6)
            fail "cannot resolve the router address in $ROUTER_URL
Check ROUTER_URL and the current network connection."
            ;;
        7)
            fail "cannot connect to the router at $ROUTER_URL
Check that this device is on the router network and its web interface is available."
            ;;
        28)
            fail "the router at $ROUTER_URL did not respond within ${HTTP_TIMEOUT:-20} seconds
Check the network connection and router address."
            ;;
        60)
            fail "TLS certificate verification failed for $ROUTER_URL
Use the router's valid KeenDNS address or a trusted local HTTP address."
            ;;
        *)
            fail "request failed: $method $ROUTER_URL$endpoint (curl exit $curl_status)"
            ;;
    esac
}

response_error() {
    local context=$1 file=$2 detail
    detail=$(jq -r 'if type == "object" then (.message // .error // empty) else empty end' "$file" 2>/dev/null || true)
    if [[ $HTTP_STATUS == 401 || $HTTP_STATUS == 403 ]]; then
        fail "$context (HTTP $HTTP_STATUS)
Check ROUTER_USERNAME and ROUTER_PASSWORD in $CONFIG_FILE."
    elif [[ -n $detail ]]; then
        fail "$context (HTTP $HTTP_STATUS): $detail"
    fi
    fail "$context (HTTP $HTTP_STATUS)"
}

header_value() {
    local wanted=${1,,} name value
    while IFS=: read -r name value; do
        if [[ ${name,,} == "$wanted" ]]; then
            value=${value%$'\r'}
            value=${value#"${value%%[![:space:]]*}"}
            printf '%s' "$value"
            return 0
        fi

    done < "$TMP_DIR/headers"
    return 1
}
hash_md5() {
    if command -v md5sum >/dev/null 2>&1; then
        md5sum
    elif command -v md5 >/dev/null 2>&1; then
        md5 -q
    else
        fail 'required MD5 tool not found: install md5sum or md5'
    fi
}

hash_sha256() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256
    else
        fail 'required SHA-256 tool not found: install sha256sum or shasum'
    fi
}

authenticate() {
    http_request GET /auth "$TMP_DIR/auth.json"
    case $HTTP_STATUS in
        200)
            debug 'Authentication: existing session accepted'
            return 0
            ;;
        401)
            debug 'Authentication: challenge response'
            ;;
        *) response_error 'authentication probe failed' "$TMP_DIR/auth.json" ;;
    esac

    local realm challenge md5 password_hash payload
    realm=$(header_value x-ndm-realm) || fail 'router did not return the X-NDM-Realm authentication header'
    challenge=$(header_value x-ndm-challenge) || fail 'router did not return the X-NDM-Challenge authentication header'
    md5=$(printf '%s' "$ROUTER_USERNAME:$realm:$ROUTER_PASSWORD" | hash_md5)
    md5=${md5%% *}
    password_hash=$(printf '%s' "$challenge$md5" | hash_sha256)
    password_hash=${password_hash%% *}
    payload=$(jq -nc --arg login "$ROUTER_USERNAME" --arg password "$password_hash" \
        '{login: $login, password: $password}')

    http_request POST /auth "$TMP_DIR/auth-result.json" "$payload"
    [[ $HTTP_STATUS == 200 ]] || response_error 'authentication failed' "$TMP_DIR/auth-result.json"
}

prompt_value() {
    local prompt=$1 default=$2 value
    printf '%s [%s]: ' "$prompt" "$default" >&2
    IFS= read -r value || fail 'configuration input ended unexpectedly'
    printf '%s' "${value:-$default}"
}

default_gateway() {
    if command -v ip >/dev/null 2>&1; then
        ip -json route show default \
            | jq -r '[.[] | select(.gateway != null)] | sort_by(.metric // 0) | .[0].gateway // empty'
    elif command -v route >/dev/null 2>&1; then
        # macOS and BSD: `route -n get default` prints a `gateway: ADDRESS` line.
        route -n get default 2>/dev/null | awk '$1 == "gateway:" { print $2; exit }'
    else
        fail 'neither ip nor route is available to find the default gateway'
    fi
}

discover_router() {
    local gateway url status
    require_command jq
    require_command curl
    gateway=$(default_gateway) || fail 'cannot inspect the default route'
    [[ -n $gateway ]] || fail 'no default gateway was found'
    if [[ $gateway == *:* ]]; then
        url=http://[$gateway]
    else
        url=http://$gateway
    fi
    debug "Probing GET $url/auth"
    if ! status=$(curl --silent --show-error --connect-timeout 3 --max-time 5 \
        --output /dev/null --write-out '%{http_code}' "$url/auth"); then
        fail "default gateway $gateway did not respond to an HTTP authentication probe"
    fi
    case $status in
        200|401)
            printf '%s\n' "$url"
            ;;
        *)
            fail "default gateway $gateway did not expose a Keenetic-compatible /auth endpoint (HTTP $status)"
            ;;
    esac
}

init_config() {
    local answer password_confirmation config_dir config_temp password_command_input password_file_input ca_input
    if [[ -e $CONFIG_FILE ]]; then
        printf 'Configuration already exists at %s. Overwrite it? [y/N]: ' "$CONFIG_FILE" >&2
        IFS= read -r answer || fail 'configuration input ended unexpectedly'
        [[ ${answer,,} == y || ${answer,,} == yes ]] || {
            unchanged 'No changes made.'
            return 0
        }
    fi

    info 'Configure Keenetic router access. Credentials are tested before being saved.'
    ROUTER_URL=$(prompt_value 'Router URL' 'http://192.168.1.1')
    ROUTER_USERNAME=$(prompt_value 'Username' 'admin')
    printf 'Password (leave blank to read it from a file or command instead): ' >&2
    IFS= read -rs ROUTER_PASSWORD || fail 'configuration input ended unexpectedly'
    printf '\n' >&2
    if [[ -n $ROUTER_PASSWORD ]]; then
        printf 'Confirm password: ' >&2
        IFS= read -rs password_confirmation || fail 'configuration input ended unexpectedly'
        printf '\n' >&2
        [[ $ROUTER_PASSWORD == "$password_confirmation" ]] || fail 'passwords do not match'
    else
        printf 'Password file (one line; leave blank to use a command): ' >&2
        IFS= read -r password_file_input || fail 'configuration input ended unexpectedly'
        if [[ -n $password_file_input ]]; then
            ROUTER_PASSWORD_FILE=$password_file_input
        else
            printf 'Password command (for example: pass show routers/keenetic): ' >&2
            IFS= read -r password_command_input || fail 'configuration input ended unexpectedly'
            [[ -n $password_command_input ]] || fail 'a password, password file, or password command is required'
            ROUTER_PASSWORD_COMMAND=$password_command_input
        fi
    fi

    if [[ -n $CLI_CA_FILE ]]; then
        ROUTER_CA_FILE=$CLI_CA_FILE
    elif $CLI_INSECURE; then
        ROUTER_INSECURE=true
    elif [[ $ROUTER_URL == https://* ]]; then
        printf 'Trusted CA file (leave blank for system trust): ' >&2
        IFS= read -r ca_input || fail 'configuration input ended unexpectedly'
        ROUTER_CA_FILE=$ca_input
        if [[ -z $ROUTER_CA_FILE ]]; then
            printf 'Disable certificate verification? [y/N]: ' >&2
            IFS= read -r answer || fail 'configuration input ended unexpectedly'
            if [[ ${answer,,} == y || ${answer,,} == yes ]]; then
                ROUTER_INSECURE=true
            fi
        fi
    fi
    validate_router_settings

    if [[ $ROUTER_URL == http://* ]]; then
        warn 'HTTP does not protect the authenticated router session; prefer HTTPS or KeenDNS. This warning is shown once; the saved configuration acknowledges it.'
        ROUTER_ALLOW_HTTP=true
    elif [[ $ROUTER_INSECURE == true ]]; then
        warn 'HTTPS certificate verification is disabled for this connection.'
    fi
    info "Testing connection to $ROUTER_URL..."
    authenticate

    if [[ $CONFIG_FILE == */* ]]; then
        config_dir=${CONFIG_FILE%/*}
    else
        config_dir=.
    fi
    if [[ ! -d $config_dir ]]; then
        mkdir -p -- "$config_dir"
        chmod 700 "$config_dir"
    fi
    config_temp=$(mktemp "$config_dir/.keenetic.XXXXXX")
    chmod 600 "$config_temp"
    {
        printf '%s\n' \
            '# Generated by keenetic --init. Values are literal.' \
            "ROUTER_URL=$ROUTER_URL" \
            "ROUTER_USERNAME=$ROUTER_USERNAME"
        if [[ -n $ROUTER_PASSWORD_COMMAND ]]; then
            printf 'ROUTER_PASSWORD_COMMAND=%s\n' "$ROUTER_PASSWORD_COMMAND"
        elif [[ -n $ROUTER_PASSWORD_FILE ]]; then
            printf 'ROUTER_PASSWORD_FILE=%s\n' "$ROUTER_PASSWORD_FILE"
        else
            printf 'ROUTER_PASSWORD=%s\n' "$ROUTER_PASSWORD"
        fi
        [[ -z $ROUTER_CA_FILE ]] || printf 'ROUTER_CA_FILE=%s\n' "$ROUTER_CA_FILE"
        printf 'ROUTER_INSECURE=%s\n' "$ROUTER_INSECURE"
        [[ $ROUTER_ALLOW_HTTP != true ]] || printf 'ROUTER_ALLOW_HTTP=true\n'
    } > "$config_temp"
    mv -f -- "$config_temp" "$CONFIG_FILE"
    success "Connected successfully. Configuration saved to $CONFIG_FILE."
}

api_get() {
    local endpoint=$1 output=$2 description=$3 expected_type=$4
    http_request GET "$endpoint" "$output"
    [[ $HTTP_STATUS == 200 ]] || response_error "failed to retrieve $description" "$output"
    jq -e --arg type "$expected_type" 'type == $type' "$output" >/dev/null \
        || fail "the router returned invalid $description data from $endpoint
The installed Keenetic firmware may not support this API."
}

fetch_interface_status() {
    api_get /rci/show/interface "$TMP_DIR/interfaces.json" 'interfaces' object
    # Whitelist status fields: the raw response can also contain VPN peer data.
    if ! jq --arg router "$ROUTER_URL" --arg view "$VIEW_MODE" '
        def text: if type == "string" then . else "" end;
        def connection:
            if . == "yes" or . == true then true
            elif . == "no" or . == false then false else null end;
        if any(.[]; type != "object") then error("invalid interface entry") else . end
        | {router: $router, interfaces: [to_entries[]
            | .key as $key | .value
            | {
                id: ((.id | text | select(length > 0)) // $key),
                description: (.description | text),
                type: (.type | text),
                state: (.state | text),
                link: (.link | text),
                connected: (.connected | connection),
                ipv4: ((.address | text | select(length > 0)) // null),
                mask: ((.mask | text | select(length > 0)) // null),
                ipv6: [(.ipv6.addresses // [])[]
                    | select((.address | type) == "string" and (.address | length) > 0)
                    | {address: .address, prefix_length: (."prefix-length" // null)}]
            }
            | .vpn = (.type | test("wireguard|openvpn|l2tp|pptp|sstp|ipsec|ike|openconnect|zerotier|proxy"; "i"))
            | .status = (if .state == "down" then "disabled"
                         elif .connected == true then "connected"
                         elif .connected == false then "disconnected"
                         elif .link == "up" then "link up"
                         elif .link == "down" then "link down"
                         else "unknown" end)
            | select($view == "all" or
                (.state != "down" and .link != "down" and
                 (.connected == true or (.connected == null and .link == "up"))))
        ] | sort_by([(.vpn | not), .id])}
    ' "$TMP_DIR/interfaces.json" > "$TMP_DIR/status.json"; then
        fail 'the router returned invalid interface status data'
    fi
    debug "Router: $ROUTER_URL"
    debug "Interfaces: $(jq '.interfaces | length' "$TMP_DIR/status.json")"
}

fetch_status_details() {
    fetch_keendns_status
    fetch_interface_traffic
    jq --slurpfile dns "$TMP_DIR/keendns.json" '.keendns = $dns[0]' \
        "$TMP_DIR/status.json" > "$TMP_DIR/status-details.json"
    mv "$TMP_DIR/status-details.json" "$TMP_DIR/status.json"
}

fetch_keendns_status() {
    printf 'null\n' > "$TMP_DIR/keendns.json"
    http_request GET /rci/show/ndns "$TMP_DIR/ndns.json"
    if [[ $HTTP_STATUS == 401 || $HTTP_STATUS == 403 ]]; then
        response_error 'failed to retrieve KeenDNS status' "$TMP_DIR/ndns.json"
    fi
    if [[ $HTTP_STATUS == 200 ]] && jq -e '
        type == "object" and ([.. | objects | select(.status? == "error")] | length == 0)
    ' "$TMP_DIR/ndns.json" >/dev/null 2>&1; then
        jq '
            def text: if type == "string" and length > 0 then . else null end;
            (.name | text) as $name | (.domain | text) as $domain
            | {hostname: (if $name == null or $domain == null then null
                          elif $name | endswith("." + $domain) then $name
                          else $name + "." + $domain end), access: (.access | text)}
        ' "$TMP_DIR/ndns.json" > "$TMP_DIR/keendns.json"
    else
        warn "KeenDNS status unavailable (HTTP $HTTP_STATUS)."
    fi
}

fetch_interface_traffic() {
    local payload count unavailable
    count=$(jq '.interfaces | length' "$TMP_DIR/status.json")
    printf '[]\n' > "$TMP_DIR/traffic.json"
    if ((count > 0)); then
        # RCI requires the interface name as an argument, not a URL path segment.
        # Every command in this POST is a read-only show operation.
        payload=$(jq -c '[.interfaces[] | {show:{interface:{name:.id, stat:{}}}}]' "$TMP_DIR/status.json")
        http_request POST /rci/ "$TMP_DIR/traffic-response.json" "$payload"
        if [[ $HTTP_STATUS == 401 || $HTTP_STATUS == 403 ]]; then
            response_error 'failed to retrieve traffic statistics' "$TMP_DIR/traffic-response.json"
        fi
        # Positional results can only be matched safely when all entries are present.
        if [[ $HTTP_STATUS == 200 ]] && jq -e --argjson count "$count" '
            type == "array" and length == $count
        ' "$TMP_DIR/traffic-response.json" >/dev/null 2>&1; then
            jq '
                def counter:
                    (try tonumber catch null)
                    | if type == "number" and . >= 0 and floor == . then . else null end;
                map(
                    if type != "object" then null
                    elif any(.. | objects; .status? == "error") then null
                    else (.show.interface.stat // null)
                        | if type != "object" then null else {
                            rx_bytes: (.rxbytes | counter), tx_bytes: (.txbytes | counter),
                            rx_packets: (.rxpackets | counter), tx_packets: (.txpackets | counter),
                            rx_errors: (.rxerrors | counter), tx_errors: (.txerrors | counter),
                            rx_dropped: (.rxdropped | counter), tx_dropped: (.txdropped | counter)
                        } | if all(.[]; . == null) then null else . end end
                    end
                )
            ' "$TMP_DIR/traffic-response.json" > "$TMP_DIR/traffic.json" || {
                printf '[]\n' > "$TMP_DIR/traffic.json"
            }
        fi
    fi
    jq --slurpfile traffic "$TMP_DIR/traffic.json" '
        .interfaces |= (to_entries | map(.value + {traffic: $traffic[0][.key]}))
    ' "$TMP_DIR/status.json" > "$TMP_DIR/status-details.json"
    mv "$TMP_DIR/status-details.json" "$TMP_DIR/status.json"
    unavailable=$(jq '[.interfaces[] | select(.traffic == null)] | length' "$TMP_DIR/status.json")
    if ((unavailable > 0)); then
        warn "Traffic statistics unavailable for $unavailable of $count interfaces."
    fi
}

fetch_wifi_networks() {
    api_get /rci/show/interface "$TMP_DIR/wifi-interfaces.json" 'Wi-Fi interfaces' object
    if ! jq --arg router "$ROUTER_URL" --arg view "$VIEW_MODE" '
        def text: if type == "string" then . else null end;
        def positive:
            if type == "number" or type == "string" then
                (try tonumber catch null) | if . != null and . > 0 then . else null end
            else null end;
        def band:
            if type == "number" or type == "string" then tostring | ascii_downcase | gsub("[ -]|ghz"; "")
                | if . == "2.4" then "2.4 GHz" elif . == "5" then "5 GHz" elif . == "6" then "6 GHz" else null end
            else null end;
        if any(.[]; type != "object") or any(.. | objects; .status? == "error")
            then error("invalid interfaces") else . end
        | [to_entries[] | .key as $key | .value
            | .id = ((.id | text | select(length > 0)) // $key)] as $interfaces
        | ($interfaces | map({key:.id, value:.}) | from_entries) as $by_id
        | {router:$router, networks: [$interfaces[]
            | select(.type == "AccessPoint" or (.id | test("^WifiMaster[0-9]+/AccessPoint[0-9]+$")))
            | (.id | split("/")[0]) as $radio_id
            | ($by_id[$radio_id] // {}) as $radio
            | ((.band | band) // ($radio.band | band)) as $reported_band
            | ((.frequency | positive) // ($radio.frequency | positive)) as $frequency
            | (if $frequency >= 2400 and $frequency < 2500 then "2.4 GHz"
               elif $frequency >= 4900 and $frequency < 5925 then "5 GHz"
               elif $frequency >= 5925 and $frequency <= 7125 then "6 GHz" else null end) as $frequency_band
            | {
                id, radio_id:$radio_id, ssid:(.ssid | text), description:(.description | text),
                bssid:(.mac | text), state:(.state | text), link:(.link | text),
                band: ($reported_band // $frequency_band //
                    (if $radio_id == "WifiMaster0" then "2.4 GHz"
                     elif $radio_id == "WifiMaster1" then "5 GHz" else null end)),
                band_source: (if $reported_band != null then "reported"
                    elif $frequency_band != null then "frequency"
                    elif $radio_id == "WifiMaster0" or $radio_id == "WifiMaster1" then "radio_id" else null end),
                channel: ((.channel | positive) // ($radio.channel | positive)),
                channel_width_mhz: ((.bandwidth | positive) // ($radio.bandwidth | positive)),
                authentication:(."auth-type" | text), encryption:(.encryption | text), clients:null,
                status:(if .state == "down" or $radio.state == "down" then "disabled"
                    elif .link == "down" or $radio.link == "down" then "link down"
                    elif .link == "up" or .connected == "yes" or .connected == true then "active"
                    else "unknown" end)
              }
            | select($view == "all" or .status == "active")
          ] | sort_by([.radio_id, .id])}
    ' "$TMP_DIR/wifi-interfaces.json" > "$TMP_DIR/wifi.json"; then
        fail 'the router returned invalid Wi-Fi interface data'
    fi
    http_request GET /rci/show/ip/hotspot/host "$TMP_DIR/wifi-hosts.json"
    if [[ $HTTP_STATUS == 401 || $HTTP_STATUS == 403 ]]; then
        response_error 'failed to retrieve Wi-Fi clients' "$TMP_DIR/wifi-hosts.json"
    fi
    if [[ $HTTP_STATUS == 200 ]] && jq -e 'type == "array" and all(.[]; type == "object")' \
        "$TMP_DIR/wifi-hosts.json" >/dev/null 2>&1; then
        jq --slurpfile hosts "$TMP_DIR/wifi-hosts.json" '
            [$hosts[0][] | select((.mac | type) == "string" and .mac != "")
                | select(.link == "up" or .mws.link? == "up")
                | {mac:(.mac | ascii_downcase), aps:([.ap, .mws.ap?] | map(select(type == "string")))}] as $clients
            | .networks |= map(.id as $id
                | .clients = ([$clients[] | select(.aps | index($id)) | .mac] | unique | length))
        ' "$TMP_DIR/wifi.json" > "$TMP_DIR/wifi-clients.json"
        mv "$TMP_DIR/wifi-clients.json" "$TMP_DIR/wifi.json"
    else
        warn "Wi-Fi client counts unavailable (HTTP $HTTP_STATUS)."
    fi
}

list_wifi_networks() {
    jq -r --arg columns "$(terminal_columns)" "${COLOR_ARGS[@]}" \
        --arg view "$VIEW_MODE" \
        "$(table_format_filter)"'
        def value: if . == null or . == "" then "-" else tostring | clean end;
        def security:
            if .encryption != null and .encryption != "" and .encryption != "none" then .encryption | ascii_upcase
            elif .authentication != null and .authentication != "" and .authentication != "none" then .authentication | ascii_upcase
            elif .encryption == "none" and .authentication == "none" then "Open" else "unknown" end;
        ($columns | tonumber | if . < 20 then 20 else . end) as $screen
        | [.networks[] | {ssid:(.ssid | value), band:(.band | value), channel:(.channel | value),
            width:(.channel_width_mhz | value), security:(security | clean),
            clients:(.clients | value), status}] as $rows
        | "Wi-Fi networks",
          (if $rows | length == 0 then
                (if $view == "all" then "No Wi-Fi networks found." else "No active Wi-Fi networks. Use --all to include disabled and link-down networks." end) | wordwrap($screen)[]
           else ($screen >= 72) as $wide
            | ([$rows[].status | width] + [6] | max) as $status_width
            | ([$rows[].band | width] + [4] | max) as $band_width
            | ([$rows[].channel | width] + [2] | max) as $channel_width
            | ([$rows[].width | width] + [5] | max) as $width_width
            | ([$rows[].clients | width] + [7] | max) as $clients_width
            | ([$rows[].security | width] + [8] | max | . as $natural
                | [$natural, ($screen * 0.2 | floor)] | min) as $security_width
            | ([$rows[].ssid | width] + [4] | max | . as $natural
                | [$natural, ($screen - $status_width - 2
                    - (if $wide then $band_width + $channel_width + $width_width
                        + $clients_width + $security_width + 10 else 0 end))] | min) as $ssid_width
            | def line($ssid; $band; $channel; $width; $security; $clients; $status):
                ($ssid | fit($ssid_width; false)) + "  "
                + (if $wide then ($band | pad($band_width; false)) + "  "
                    + ($channel | pad($channel_width; true)) + "  " + ($width | pad($width_width; true)) + "  "
                    + ($security | fit($security_width; false)) + "  " + ($clients | pad($clients_width; true)) + "  " else "" end)
                + ($status | pad($status_width; false) | paint($status)) | rtrim;
            $dim + line("SSID"; "BAND"; "CH"; "WIDTH"; "SECURITY"; "CLIENTS"; "STATUS") + $reset,
            ($rows[] | line(.ssid; .band; .channel; .width; .security; .clients; .status),
                (if $wide then empty else
                    (.band + " / CH " + .channel + " / " + .width + " MHz",
                     .security + " / Clients: " + .clients)
                    | wordwrap($screen - 2)[] | "  " + . end))
           end)
    ' "$TMP_DIR/wifi.json"
}

fetch_client_traffic() {
    local detail seconds
    case $TRAFFIC_PERIOD in
        3m) detail=0; seconds=180 ;;
        1h) detail=1; seconds=3600 ;;
        3h) detail=2; seconds=10800 ;;
        1d) detail=3; seconds=86400 ;;
    esac
    api_get "/rci/show/ip/hotspot/summary?count=$TRAFFIC_TOP&detail=$detail&attribute=sumbytes" \
        "$TMP_DIR/traffic-summary.json" "$TRAFFIC_PERIOD client traffic summary" object
    if ! jq --arg router "$ROUTER_URL" --arg period "$TRAFFIC_PERIOD" \
        --argjson limit "$TRAFFIC_TOP" --argjson detail "$detail" --argjson seconds "$seconds" '
        def counter:
            if . == null then null
            else (if type == "number" or type == "string" then tonumber else error("invalid counter") end)
                | if . >= 0 and floor == . then . else error("invalid counter") end
            end;
        if .t != $detail or (.host | type) != "array"
            or any(.. | objects; .status? == "error") then error("invalid traffic summary") else . end
        | [.host[]
            | if type != "object" then error("invalid host") else . end
            | select(.type != "others" and .type != "unregistered" and .type != "multicast")
            | if (.mac | type) != "string" then error("missing client MAC") else . end
            | if (.mac | test("^([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}$") | not)
                then error("invalid client MAC") else . end
            | (.rxbytes | counter) as $rx | (.txbytes | counter) as $tx
            | (.sumbytes | counter) as $sum
            | ($sum // (if $rx != null and $tx != null then $rx + $tx else null end)) as $total
            | if $total == null then error("missing traffic total") else . end
            | {name: (if (.name | type) == "string" and (.name | length) > 0 then .name else .mac end),
               mac: (.mac | ascii_downcase), ip: null, online: null,
               rx_bytes: $rx, tx_bytes: $tx, total_bytes: $total}
          ]
        | group_by(.mac) | map(max_by(.total_bytes))
        | sort_by([-.total_bytes, (.name | ascii_downcase), .mac]) | .[:$limit]
        | to_entries | map(.value + {rank: (.key + 1)})
        | {router: $router, period: $period, window_seconds: $seconds, limit: $limit, clients: .}
    ' "$TMP_DIR/traffic-summary.json" > "$TMP_DIR/client-traffic.json"; then
        fail "the router returned invalid $TRAFFIC_PERIOD traffic history; this firmware may not support the Traffic Monitor API"
    fi

    # Connection status comes from current links, not historical traffic activity.
    http_request GET /rci/show/ip/hotspot/host "$TMP_DIR/traffic-hosts.json"
    if [[ $HTTP_STATUS == 401 || $HTTP_STATUS == 403 ]]; then
        response_error 'failed to retrieve traffic client details' "$TMP_DIR/traffic-hosts.json"
    fi
    if [[ $HTTP_STATUS == 200 ]] && jq -e 'type == "array" and all(.[]; type == "object")' \
        "$TMP_DIR/traffic-hosts.json" >/dev/null 2>&1; then
        jq --slurpfile hosts "$TMP_DIR/traffic-hosts.json" '
            ($hosts[0] | map(select((.mac | type) == "string"))
                | group_by(.mac | ascii_downcase)
                | map({key: (.[0].mac | ascii_downcase), value: {
                    ip: ([.[].ip | select(type == "string" and length > 0)] | first // null),
                    online: (if any(.[]; .link == "up" or .mws.link? == "up") then true
                             elif any(.[]; .link == "down" or .mws.link? == "down") then false
                             else null end)
                }}) | from_entries) as $known
            | .clients |= map(.ip = $known[.mac].ip | .online = $known[.mac].online)
        ' "$TMP_DIR/client-traffic.json" > "$TMP_DIR/client-traffic-addresses.json"
        mv "$TMP_DIR/client-traffic-addresses.json" "$TMP_DIR/client-traffic.json"
    else
        warn "Traffic client details unavailable (HTTP $HTTP_STATUS)."
    fi
}

list_client_traffic() {
    jq -r --arg columns "$(terminal_columns)" "${COLOR_ARGS[@]}" \
        "$(table_format_filter)"'
        ($columns | tonumber | if . < 20 then 20 else . end) as $screen
        | (.clients | map({name: (.name | clean), ip: ((.ip // "-") | clean),
            rx: (.rx_bytes | bytes), tx: (.tx_bytes | bytes), total: (.total_bytes | bytes),
            status: (if .online == true then "online" elif .online == false then "offline" else "unknown" end)})) as $rows
        | ("Top \(.limit) clients · last " + (if .period == "3m" then "3 minutes"
            elif .period == "1h" then "1 hour" elif .period == "3h" then "3 hours" else "1 day" end)
            | wordwrap($screen)[]),
          (if $rows | length == 0 then "No client traffic recorded in this window. Try a longer --period such as 1h or 1d." | wordwrap($screen)[]
           else
            ($screen >= 72) as $wide
            | ($screen >= 32) as $inline_total
            | ([$rows[].status | width] + [6] | max) as $status_width
            | ([$rows[].rx | width] + [2] | max) as $rx_width
            | ([$rows[].tx | width] + [2] | max) as $tx_width
            | ([$rows[].total | width] + [5] | max) as $total_width
            | ([$rows[].ip | width] + [10] | max | . as $natural
                | [$natural, ($screen * 0.25 | floor)] | min) as $ip_width
            | ([$rows[].name | width] + [4] | max | . as $natural
                | [$natural, ($screen - $status_width - 2
                    - (if $inline_total then $total_width + 2 else 0 end)
                    - (if $wide then $ip_width + $rx_width + $tx_width + 6 else 0 end))]
                | min) as $name_width
            | def line($name; $ip; $rx; $tx; $total; $status):
                ($name | fit($name_width; false)) + "  "
                + (if $wide then ($ip | fit($ip_width; false)) + "  "
                    + ($rx | pad($rx_width; true)) + "  " + ($tx | pad($tx_width; true)) + "  " else "" end)
                + (if $inline_total then ($total | pad($total_width; true)) + "  " else "" end)
                + ($status | pad($status_width; false) | paint($status)) | rtrim;
            $dim + line("NAME"; "IP ADDRESS"; "RX"; "TX"; "TOTAL"; "STATUS") + $reset,
            ($rows[] | line(.name; .ip; .rx; .tx; .total; .status),
                (if $wide then empty else (.ip, ("RX " + .rx + " / TX " + .tx))
                    | wordwrap($screen - 2)[] | "  " + . end),
                (if $inline_total then empty else "TOTAL " + .total | wordwrap($screen - 2)[] | "  " + . end))
           end)
    ' "$TMP_DIR/client-traffic.json"
}

fetch_client_summary() {
    printf 'null\n' > "$TMP_DIR/client-summary.json"
    http_request GET /rci/show/ip/hotspot/host "$TMP_DIR/status-clients.json"
    if [[ $HTTP_STATUS == 401 || $HTTP_STATUS == 403 ]]; then
        response_error 'failed to retrieve connected clients' "$TMP_DIR/status-clients.json"
    fi
    if [[ $HTTP_STATUS == 200 ]] && jq -e '
        type == "array" and all(.[]; type == "object" and
            (.mac | type == "string" and length > 0))
    ' "$TMP_DIR/status-clients.json" >/dev/null 2>&1; then
        if ! jq '
            def wifi:
                any([.ap, .mws.ap?][]; type == "string" and length > 0)
                or any([.ssid, .mws.ssid?][]; type == "string");
            [.[] | select(.link == "up" or .mws.link? == "up")]
            | group_by(.mac | ascii_downcase)
            | map(any(.[]; wifi))
            | {connected: length, wired: (map(select(. == false)) | length),
               wireless: (map(select(. == true)) | length)}
        ' "$TMP_DIR/status-clients.json" > "$TMP_DIR/client-summary.json"; then
            printf 'null\n' > "$TMP_DIR/client-summary.json"
        fi
    fi
    if [[ $(cat "$TMP_DIR/client-summary.json") == null ]]; then
        warn "Connected client counts unavailable (HTTP $HTTP_STATUS)."
    fi
    jq --slurpfile clients "$TMP_DIR/client-summary.json" '.clients = $clients[0]' \
        "$TMP_DIR/status.json" > "$TMP_DIR/status-with-clients.json"
    mv "$TMP_DIR/status-with-clients.json" "$TMP_DIR/status.json"
}

# Shared cell-aware formatting for non-interactive status and client tables.
table_format_filter() {
    cat <<'JQ'
        def clean: gsub("[[:cntrl:]]"; " ");
        # Terminal cell widths for common combining marks, CJK, and emoji.
        def width:
            explode | map(
                if (. >= 768 and . <= 879) or (. >= 65024 and . <= 65039) or . == 8205 then 0
                elif (. >= 4352 and . <= 4447) or (. >= 9001 and . <= 9002)
                    or (. >= 11904 and . <= 42191) or (. >= 44032 and . <= 55203)
                    or (. >= 63744 and . <= 64255) or (. >= 65040 and . <= 65049)
                    or (. >= 65072 and . <= 65135) or (. >= 65281 and . <= 65376)
                    or (. >= 65504 and . <= 65510) or (. >= 127744 and . <= 129791)
                    or (. >= 131072 and . <= 262141) then 2 else 1 end
            ) | add // 0;
        def wrap($limit):
            reduce (explode[] | [.] | implode) as $char
                ({lines: [], text: "", size: 0};
                 ($char | width) as $size
                 | if .size + $size > $limit then
                       .lines += [.text] | .text = $char | .size = $size
                   else .text += $char | .size += $size end)
            | .lines + [.text];
        def wordwrap($limit):
            reduce (split(" ")[]) as $word ({lines: [], text: ""};
                (.text + (if .text == "" then "" else " " end) + $word) as $next
                | if ($next | width) <= $limit then .text = $next
                  else (if .text == "" then . else .lines += [.text] end)
                    | ($word | wrap($limit)) as $parts
                    | .lines += $parts[0:-1] | .text = $parts[-1] end)
            | .lines + [.text];
        def pad($size; $right):
            . as $text | (" " * ([$size - width, 0] | max)) as $space
            | if $right then $space + $text else $text + $space end;
        def fit($size; $right):
            (if width > $size then (wrap($size - 1)[0] + "…") else . end)
            | pad($size; $right);
        def bytes:
            if . == null then "unavailable"
            else . as $value
                | [0, 1, 2, 3, 4, 5, 6]
                | map(select($value >= pow(1024; .))) | (last // 0) as $unit
                | (($value / pow(1024; $unit) * 10 | round) / 10 | tostring)
                  + " " + ["B", "KiB", "MiB", "GiB", "TiB", "PiB", "EiB"][$unit]
            end;
        def duration:
            if . == null then "unknown" else floor as $s
                | "\($s / 86400 | floor)d \(($s % 86400) / 3600 | floor)h \(($s % 3600) / 60 | floor)m \($s % 60)s" end;
        # Color for a status word; applied after padding so widths stay correct.
        def status_color:
            ascii_downcase
            | if . == "online" or . == "connected" or . == "link up" or . == "responding" or . == "pass"
                 or . == "active" or . == "up" or . == "enabled" then $green
              elif . == "offline" or . == "disconnected" or . == "link down" or . == "not ready" or . == "disabled"
                 or . == "alternate" or . == "api errors" or . == "warning" or . == "down" or . == "fail" then $yellow
              elif . == "error" or . == "critical" or . == "blocked" or . == "failed" then $red
              elif . == "unknown" or . == "unavailable" or . == "-" or . == "none" or . == "(hidden)" then $dim
              else "" end;
        def paint($word): ($word | status_color) as $color
            | if $color == "" then . else $color + . + $reset end;
        def rtrim: sub(" +(?<tail>(\u001b\\[[0-9;]*m)*)$"; .tail);
        def unreported: . == "unknown" or . == "unavailable" or . == "" or . == "unknown / unknown"
            or . == "unavailable / unavailable" or . == "unknown%" or . == "unavailable RX / unavailable TX";
JQ
}

list_interface_status() {
    jq -r --arg columns "$(terminal_columns)" \
        --argjson summary "${1:-true}" --argjson menu "${2:-false}" --argjson header_only "${3:-false}" \
        "${COLOR_ARGS[@]}" "$(table_format_filter)"'
        def row_color: if $menu then "" else status_color end;
        ($columns | tonumber | if . < 20 then 20 else . end | . - (if $menu then 4 else 0 end)) as $screen
        | . as $router
        | (if $summary then [
            {label: "Router", value: .router},
            {label: "KeenDNS", value: (if .keendns == null then "unavailable"
                elif .keendns.hostname == null then "not configured"
                else .keendns.hostname + (if .keendns.access == null then "" else " (" + .keendns.access + ")" end) end)},
            {label: "Connected clients", value: (if .clients == null then "unavailable"
             else "\(.clients.connected) (\(.clients.wired) wired / \(.clients.wireless) wireless)" end)}
          ] as $info
          | ([$info[].label | width] + [11] | max) as $label_width
          | if $screen >= 40 then
              $dim + ("ROUTER INFO" | pad($label_width; false)) + "  VALUE" + $reset,
              ($info[] | .label as $field_label
                | (.value | clean | wordwrap($screen - $label_width - 2))
                | to_entries[]
                | ((if .key == 0 then $field_label else "" end) | pad($label_width; false))
                  + "  " + .value)
            else
              $dim + "ROUTER INFO" + $reset,
              ($info[] | .label, (.value | clean | wordwrap($screen - 2)[] | "  " + .))
            end else empty end),
          ($router |
        [.interfaces | to_entries[] | .key as $index | .value | {
            index: $index, vpn, status,
            name: ([.id, (.description | select(length > 0)),
                    (if .type == "" then empty else "[" + .type + "]" end)] | join(" ") | clean),
            addresses: (([.ipv4 // empty] + [.ipv6[] | .address +
                (if .prefix_length == null then "" else "/" + (.prefix_length | tostring) end)])
                | if length == 0 then ["-"] else . end | map(clean)),
            rx: (.traffic.rx_bytes | bytes), tx: (.traffic.tx_bytes | bytes)
        }] as $rows
        | ($screen >= 72) as $wide
        | ([$rows[].status | width] + [6] | max) as $status_width
        | ([$rows[].rx | width] + [2] | max) as $rx_width
        | ([$rows[].tx | width] + [2] | max) as $tx_width
        | ($screen - $status_width - $rx_width - $tx_width - 8) as $remaining
        | ([$remaining * 0.5 | floor, 10] | max) as $ip_width
        | (if $wide then $remaining - $ip_width else $screen - $status_width - 2 end) as $name_width
        | def line($name; $status; $ip; $rx; $tx; $color):
            ($name | fit($name_width; false)) + "  "
            + $color + ($status | fit($status_width; false)) + (if $color == "" then "" else $reset end)
            + (if $wide then "  " + ($ip | fit($ip_width; false))
                + "  " + ($rx | fit($rx_width; true)) + "  " + ($tx | fit($tx_width; true)) else "" end)
            | if $menu then . else rtrim end;
        if $header_only then line("INTERFACE / NAME"; "STATUS"; "IP ADDRESS"; "RX"; "TX"; "")
        elif $menu then
            $rows[] | (.index | tostring) + "\t"
                + line(.name; .status; (.addresses | join(", ")); .rx; .tx; "")
        else (true, false) as $vpn
        | (if $summary or ($vpn | not) then "" else empty end),
          ((if $vpn then "VPN / proxy interfaces" else "Other interfaces" end) | wordwrap($screen)[]),
          ([$rows[] | select(.vpn == $vpn)] as $section
            | if $section | length == 0 then $dim + "  None" + (if $vpn or $summary | not then "" else " (use --all to include inactive interfaces)" end) + $reset
              else $dim + line("INTERFACE / NAME"; "STATUS"; "IP ADDRESS"; "RX"; "TX"; "") + $reset,
                ($section[] |
                    line(.name; .status; (.addresses | join(", ")); .rx; .tx; (.status | row_color)),
                    (if $wide then empty else
                        ((.addresses | join(", ")), ("RX " + .rx + " / TX " + .tx))
                        | wordwrap($screen - 2)[] | "  " + .
                     end))
              end) end
          )
    ' "$TMP_DIR/status.json"
}

fetch_router_state() {
    api_get /rci/show/ip/hotspot/host "$TMP_DIR/clients.json" 'clients' array
    api_get /rci/show/rc/ip/hotspot/host "$TMP_DIR/assignments.json" 'client policies' array
    api_get /rci/show/rc/ip/policy "$TMP_DIR/policies.json" 'policies' object

    if ! jq -n \
        --slurpfile clients "$TMP_DIR/clients.json" \
        --slurpfile assignments "$TMP_DIR/assignments.json" '
        ($assignments[0]
            | map(select(.mac != null) | {key: (.mac | ascii_downcase), value: .})
            | from_entries) as $by_mac
        | [$clients[0][]
            | . as $client
            | (($client.mac // "") | ascii_downcase) as $mac
            | ($by_mac[$mac] // {}) as $assignment
            | {
                name: ($client.name // "Unknown"),
                ip: ($client.ip // "N/A"),
                mac: $mac,
                policy: ($assignment.policy // null),
                deny: ($assignment.deny // false),
                online: (.link == "up" or .mws.link? == "up")
              }
          ]' > "$TMP_DIR/all-clients.json"; then
        fail 'could not combine the client and policy data returned by the router'
    fi
    case $VIEW_MODE in
        connected) jq '[.[] | select(.online)]' "$TMP_DIR/all-clients.json" > "$TMP_DIR/clients-view.json" ;;
        offline) jq '[.[] | select(.online | not)]' "$TMP_DIR/all-clients.json" > "$TMP_DIR/clients-view.json" ;;
        all) cp "$TMP_DIR/all-clients.json" "$TMP_DIR/clients-view.json" ;;
    esac
    cp "$TMP_DIR/clients-view.json" "$TMP_DIR/connected.json"
    debug "Router: $ROUTER_URL"
    debug "Local address: ${ROUTER_LOCAL_IP:-unknown}"
    debug "Clients: $(jq 'length' "$TMP_DIR/all-clients.json") total, $(jq '[.[] | select(.online)] | length' "$TMP_DIR/all-clients.json") online"
    debug "Policies: $(jq '[to_entries[] | select(.value.description? != null)] | length' "$TMP_DIR/policies.json")"
}

list_local_macs() {
    local address_file local_mac
    if [[ -d /sys/class/net ]]; then
        for address_file in /sys/class/net/*/address; do
            [[ -r $address_file ]] || continue
            IFS= read -r local_mac < "$address_file" || continue
            printf '%s\n' "${local_mac,,}"
        done
    elif command -v ifconfig >/dev/null 2>&1; then
        # macOS and BSD: `ether xx:xx:xx:xx:xx:xx` lines from ifconfig.
        ifconfig 2>/dev/null | awk '$1 == "ether" { print tolower($2) }'
    fi
}

detect_current_client() {
    local local_mac
    CURRENT_CLIENT_MAC=
    if [[ -n $ROUTER_LOCAL_IP ]]; then
        CURRENT_CLIENT_MAC=$(jq -r --arg ip "$ROUTER_LOCAL_IP" \
            'first(.[] | select(.ip == $ip) | .mac) // empty' "$TMP_DIR/connected.json")
    fi
    [[ -z $CURRENT_CLIENT_MAC ]] || return 0

    while IFS= read -r local_mac; do
        [[ -n $local_mac && $local_mac != 00:00:00:00:00:00 ]] || continue
        if jq -e --arg mac "$local_mac" 'any(.[]; .mac == $mac)' "$TMP_DIR/connected.json" >/dev/null; then
            CURRENT_CLIENT_MAC=$local_mac
            return 0
        fi
    done < <(list_local_macs)
}

terminal_columns() {
    local columns=${COLUMNS:-}
    if [[ ! $columns =~ ^[0-9]+$ ]] && [[ -t 2 ]] && command -v tput >/dev/null 2>&1; then
        columns=$(tput cols 2>/dev/null || true)
    fi
    [[ $columns =~ ^[0-9]+$ ]] || columns=80
    printf '%s' "$columns"
}

shorten_text() {
    local text=$1 width=$2
    local text_width=$width
    # Bash has no wcwidth(3). A conservative half-width limit guarantees that
    # double-width CJK and emoji do not spill into the next column.
    if [[ $text == *[![:ascii:]]* ]]; then
        text_width=$((width / 2))
        ((text_width >= 2)) || text_width=2
    fi
    if ((${#text} > text_width)); then
        printf '%s~' "${text:0:text_width - 1}"
    else
        printf '%s' "$text"
    fi
}

compute_client_widths() {
    local prefix_width=$1 columns available
    columns=$(terminal_columns)
    ((columns >= 32)) || fail 'terminal is too narrow; at least 32 columns are required'
    available=$((columns - prefix_width))
    CLIENT_IP_WIDTH=$((available / 4))
    ((CLIENT_IP_WIDTH < 7)) && CLIENT_IP_WIDTH=7
    ((CLIENT_IP_WIDTH > 15)) && CLIENT_IP_WIDTH=15
    CLIENT_POLICY_WIDTH=$((available / 4))
    ((CLIENT_POLICY_WIDTH < 8)) && CLIENT_POLICY_WIDTH=8
    ((CLIENT_POLICY_WIDTH > 18)) && CLIENT_POLICY_WIDTH=18
    CLIENT_NAME_WIDTH=$((available - CLIENT_IP_WIDTH - CLIENT_POLICY_WIDTH - 2))
    ((CLIENT_NAME_WIDTH >= 8)) || fail 'terminal is too narrow to display the client selector'
    ((CLIENT_NAME_WIDTH <= 36)) || CLIENT_NAME_WIDTH=36
}

# shellcheck disable=SC2016 # The dollar expression belongs to jq.
policy_label_filter='
    if .deny then
        "Blocked"
    elif .policy == null or .policy == false then
        "Default"
    else
        ($policies[0][(.policy | tostring)].description // (.policy | tostring))
    end
'

list_clients_table() {
    local empty_message='No connected clients found.'
    [[ $VIEW_MODE == offline ]] && empty_message='No offline clients found.'
    [[ $VIEW_MODE == all ]] && empty_message='No known clients found.'
    [[ $VIEW_MODE != connected ]] || empty_message+=' Use --all to include offline clients.'
    if ! jq -e 'length > 0' "$TMP_DIR/connected.json" >/dev/null; then
        printf '%s\n' "$empty_message"
        return 0
    fi
    jq -r --slurpfile policies "$TMP_DIR/policies.json" \
        --arg columns "$(terminal_columns)" --arg current "$CURRENT_CLIENT_MAC" \
        "${COLOR_ARGS[@]}" \
        "$(table_format_filter) def policy_label: $policy_label_filter;"'
        ($columns | tonumber | if . < 20 then 20 else . end) as $screen
        | [sort_by([if .online then 0 else 1 end, (.name | ascii_downcase)])[]
            | (.mac == $current and $current != "") as $this_device
            | {
                name: ((if $this_device then "* " + .name + " (this device)"
                        else .name end) | clean),
                ip: (.ip | clean), policy: (policy_label | clean), current: $this_device,
                status: (if .online then "online" else "offline" end)
            }] as $rows
        | ($screen >= 72) as $wide
        | ($screen >= 32) as $inline_policy
        | ([$rows[].status | width] + [6] | max) as $status_width
        | ([$rows[].ip | width] + [10] | max | . as $natural
            | [$natural, ($screen * 0.3 | floor)] | min) as $ip_width
        | ([$rows[].policy | width] + [6] | max | . as $natural
            | [$natural, ([$screen * 0.25 | floor, 6] | max)] | min) as $policy_width
        | ([$rows[].name | width] + [4] | max | . as $natural
            | [$natural, ($screen - $status_width - 2
                - (if $inline_policy then $policy_width + 2 else 0 end)
                - (if $wide then $ip_width + 2 else 0 end))]
            | min) as $name_width
        | def line($name; $ip; $policy; $status; $current_row):
            ($name | fit($name_width; false)) + "  "
            + (if $wide then ($ip | fit($ip_width; false)) + "  " else "" end)
            + (if $inline_policy then ($policy | fit($policy_width; false)) + "  " else "" end)
            + ($status | pad($status_width; false) | (if $current_row then . else paint($status) end)) | rtrim;
        $dim + line("NAME"; "IP ADDRESS"; "POLICY"; "STATUS"; false) + $reset,
        ($rows[] | (if .current then $green else "" end)
            + line(.name; .ip; .policy; .status; .current) + (if .current then $reset else "" end),
            (if $wide then empty else .ip | wordwrap($screen - 2)[] | "  " + . end),
            (if $inline_policy then empty else "Policy: " + .policy | wordwrap($screen - 2)[] | "  " + . end))
    ' "$TMP_DIR/connected.json"
}

list_clients_json() {
    jq --slurpfile policies "$TMP_DIR/policies.json" \
        "sort_by([if .online then 0 else 1 end, (.name | ascii_downcase)])
        | map({
            name,
            ip,
            mac,
            online,
            blocked: .deny,
            policy: ($policy_label_filter),
            policy_id: (if .deny or .policy == null or .policy == false then null else (.policy | tostring) end)
          })" "$TMP_DIR/connected.json"
}

format_menu_option() {
    local index=$1 columns name ip policy status fitted_name fitted_ip fitted_policy option_width
    if [[ $MENU_KIND == interface ]]; then
        printf '%s' "${MENU_OPTIONS[index]}"
    elif [[ $MENU_KIND == client ]]; then
        IFS=$'\t' read -r name ip policy status <<< "${MENU_OPTIONS[index]}"
        [[ $status == online ]] || name="$name (offline)"
        compute_client_widths "$($MENU_MULTI && printf 6 || printf 4)"
        fitted_name=$(shorten_text "$name" "$CLIENT_NAME_WIDTH")
        fitted_ip=$(shorten_text "$ip" "$CLIENT_IP_WIDTH")
        fitted_policy=$(shorten_text "$policy" "$CLIENT_POLICY_WIDTH")
        printf "%-${CLIENT_NAME_WIDTH}s %-${CLIENT_IP_WIDTH}s %-${CLIENT_POLICY_WIDTH}s" \
            "$fitted_name" "$fitted_ip" "$fitted_policy"
    else
        columns=$(terminal_columns)
        ((columns >= 20)) || fail 'terminal is too narrow to display the policy selector'
        option_width=$((columns - 6))
        shorten_text "${MENU_OPTIONS[index]}" "$option_width"
    fi
}

render_arrow_menu() {
    local selected=$1 redraw=$2 count=${#MENU_OPTIONS[@]} index marker style option
    if [[ $MENU_KIND == interface ]]; then
        mapfile -t MENU_OPTIONS < <(list_interface_status false true | cut -f2-)
    fi
    if $redraw; then
        printf '\033[%dA' "$count" >&2
    fi

    for ((index = 0; index < count; index++)); do
        marker=' '
        style=
        if $MENU_MULTI; then
            if [[ ${MENU_CHECKED[index]:-0} == 1 ]]; then marker='[x]'; else marker='[ ]'; fi
        elif ((index == MENU_CURRENT_INDEX)); then
            marker='*'
            style=$DIM
        fi
        option=$(format_menu_option "$index")
        if ((index == selected)); then
            printf '\r\033[2K%s> %s %s%s\n' "$HIGHLIGHT" "$marker" "$option" "$RESET" >&2
        else
            printf '\r\033[2K%s  %s %s%s\n' "$style" "$marker" "$option" "$RESET" >&2
        fi
    done
}

finish_arrow_menu() {
    show_cursor
}

arrow_menu() {
    local subject=$1 count=${#MENU_OPTIONS[@]} selected=0 key suffix
    ((count > 0)) || fail "no $subject options are available"
    [[ -t 0 && -t 2 ]] || fail "interactive $subject selection requires a terminal"
    if ((MENU_CURRENT_INDEX >= 0)); then
        selected=$MENU_CURRENT_INDEX
    fi

    CURSOR_HIDDEN=true
    MENU_RESIZED=false
    trap 'MENU_RESIZED=true' WINCH
    printf '\033[?25l' >&2
    if $MENU_MULTI; then
        MENU_CHECKED=()
        printf 'Use Up/Down arrows, Space to toggle, Enter to confirm, or Esc/q to cancel.\n' >&2
    else
        printf 'Use Up/Down arrows, Enter to select, or Esc/q to cancel.\n' >&2
    fi
    local indent='    '
    $MENU_MULTI && indent='      '
    if [[ $MENU_KIND == client ]]; then
        compute_client_widths "${#indent}"
        printf "%s%s%-${CLIENT_NAME_WIDTH}.${CLIENT_NAME_WIDTH}s %-${CLIENT_IP_WIDTH}.${CLIENT_IP_WIDTH}s %-${CLIENT_POLICY_WIDTH}.${CLIENT_POLICY_WIDTH}s%s\n" \
            "$indent" "$DIM" 'NAME' 'IP ADDRESS' 'POLICY' "$RESET" >&2
    elif [[ $MENU_KIND == interface ]]; then
        printf '%s%s%s%s\n' "$indent" "$DIM" "$(list_interface_status false true true)" "$RESET" >&2
    fi
    render_arrow_menu "$selected" false
    while true; do
        if ! IFS= read -rsn1 -t 0.2 key; then
            if $MENU_RESIZED; then
                MENU_RESIZED=false
                render_arrow_menu "$selected" true
            fi
            continue
        fi
        if [[ $key == $'\033' ]]; then
            suffix=
            IFS= read -rsn2 -t 0.1 suffix || true
            key+=$suffix
        fi

        case $key in
            $'\033[A'|k)
                selected=$(((selected + count - 1) % count))
                ;;
            $'\033[B'|j)
                selected=$(((selected + 1) % count))
                ;;
            ' ')
                $MENU_MULTI || continue
                if [[ ${MENU_CHECKED[selected]:-0} == 1 ]]; then MENU_CHECKED[selected]=0; else MENU_CHECKED[selected]=1; fi
                ;;
            '')
                SELECTED_INDEX=$((selected + 1))
                trap - WINCH
                finish_arrow_menu
                return 0
                ;;
            q|Q|$'\033')
                trap - WINCH
                finish_arrow_menu
                return 1
                ;;
            *)
                continue
                ;;
        esac
        render_arrow_menu "$selected" true
    done
}

# Generic picker over "VALUE<TAB>LABEL" lines supplied on fd 3 (`3< <(...)`). Sets SELECTED_VALUE and
# SELECTED_VALUES; returns 1 after printing MENU_CANCEL_MESSAGE when cancelled.
pick_from_list() {
    local heading=$1 prompt=$2 multi=${3:-false} value label line index selected
    local -a fzf_args
    MENU_OPTIONS=(); MENU_VALUES=(); MENU_CURRENT_INDEX=-1; MENU_KIND=generic
    SELECTED_VALUE=; SELECTED_VALUES=()
    # Rows arrive on fd 3 so that stdin stays attached to the terminal for the menu.
    while IFS=$'\t' read -r -u 3 value label; do
        MENU_VALUES+=("$value"); MENU_OPTIONS+=("${label:-$value}")
    done
    ((${#MENU_OPTIONS[@]})) || fail "no ${prompt,,} options are available"
    if [[ -t 0 && -t 2 ]] && command -v "$FZF_COMMAND" >/dev/null 2>&1; then
        fzf_args=(--delimiter=$'\t' --with-nth=2.. --height=70% --layout=reverse --prompt="$prompt> " --header="$heading")
        ! $multi || fzf_args+=(--multi --header="$heading"$'\n''Tab marks several entries; Enter confirms.')
        selected=$(
            for ((index = 0; index < ${#MENU_VALUES[@]}; index++)); do
                printf '%s\t%s\n' "${MENU_VALUES[index]}" "${MENU_OPTIONS[index]}"
            done | "$FZF_COMMAND" "${fzf_args[@]}"
        ) || { unchanged "$MENU_CANCEL_MESSAGE"; return 1; }
        while IFS= read -r line; do SELECTED_VALUES+=("${line%%$'\t'*}"); done <<< "$selected"
        SELECTED_VALUE=${SELECTED_VALUES[0]}
        return 0
    fi
    printf '%s\n\n' "$heading" >&2
    MENU_MULTI=$multi
    if ! arrow_menu "${prompt,,}"; then
        MENU_MULTI=false
        unchanged "$MENU_CANCEL_MESSAGE"
        return 1
    fi
    MENU_MULTI=false
    if $multi; then
        for ((index = 0; index < ${#MENU_VALUES[@]}; index++)); do
            [[ ${MENU_CHECKED[index]:-0} == 1 ]] && SELECTED_VALUES+=("${MENU_VALUES[index]}")
        done
    fi
    ((${#SELECTED_VALUES[@]})) || SELECTED_VALUES=("${MENU_VALUES[SELECTED_INDEX - 1]}")
    SELECTED_VALUE=${SELECTED_VALUES[0]}
}

# "VALUE<TAB>LABEL" rows for router interfaces, VPN first, with a default entry.
interface_menu_rows() {
    printf '__default__\tRouter default (no source interface)\n'
    jq -r '.interfaces | sort_by(if .vpn then 0 else 1 end)[]
        | [.id, (.id + (if (.description // "") == "" then "" else "  " + .description end) + "  (" + .status + ")")] | @tsv' \
        "$TMP_DIR/status.json"
}

fzf_client_rows() {
    local name ip mac policy online display_name fitted_name fitted_ip fitted_policy status index=0
    while IFS=$'\t' read -r name ip mac policy online; do
        display_name=$name
        [[ -z $CURRENT_CLIENT_MAC || $mac != "$CURRENT_CLIENT_MAC" ]] \
            || display_name+=" (this device)"
        fitted_name=$(shorten_text "$display_name" "$CLIENT_NAME_WIDTH")
        fitted_ip=$(shorten_text "$ip" "$CLIENT_IP_WIDTH")
        fitted_policy=$(shorten_text "$policy" "$CLIENT_POLICY_WIDTH")
        status=offline
        [[ $online == true ]] && status=online
        printf "%d\t%-${CLIENT_NAME_WIDTH}s %-${CLIENT_IP_WIDTH}s %-${CLIENT_POLICY_WIDTH}s %-7s\n" \
            "$index" "$fitted_name" "$fitted_ip" "$fitted_policy" "$status"
        index=$((index + 1))
    done < <(
        jq -r --slurpfile policies "$TMP_DIR/policies.json" \
            ".[] | [.name, .ip, .mac, ($policy_label_filter), .online] | @tsv" \
            "$TMP_DIR/menu-clients.json"
    )
}

select_client_from_candidates() {
    local candidates=$1 heading=$2 multi=${3:-false} count name ip mac policy online display_name index=0 selected selected_index header line
    local -a fzf_args
    SELECTED_CLIENTS=()
    count=$(jq 'length' <<< "$candidates")
    ((count > 0)) || fail "$EXIT_CLIENT" 'no matching clients found'
    jq --arg current "$CURRENT_CLIENT_MAC" \
        'sort_by([if .mac == $current then 0 else 1 end, if .online then 0 else 1 end, (.name | ascii_downcase), .ip])' \
        <<< "$candidates" > "$TMP_DIR/menu-clients.json"

    if [[ -t 0 && -t 2 ]] && command -v "$FZF_COMMAND" >/dev/null 2>&1; then
        compute_client_widths 12
        printf -v header "%-${CLIENT_NAME_WIDTH}s %-${CLIENT_IP_WIDTH}s %-${CLIENT_POLICY_WIDTH}s %-7s" \
            'NAME' 'IP' 'POLICY' 'STATUS'
        fzf_args=(--delimiter=$'\t' --with-nth=2.. --height=70% --layout=reverse --prompt='Client> ' --header="$heading"$'\n'"$header")
        ! $multi || fzf_args+=(--multi --header="$heading (Tab marks several; Enter confirms)"$'\n'"$header")
        selected=$(fzf_client_rows | "$FZF_COMMAND" "${fzf_args[@]}") || {
            unchanged "$MENU_CANCEL_MESSAGE"
            return 1
        }
        while IFS= read -r line; do
            selected_index=${line%%$'\t'*}
            SELECTED_CLIENTS+=("$(jq -c --argjson index "$selected_index" '.[$index]' "$TMP_DIR/menu-clients.json")")
        done <<< "$selected"
        SELECTED_CLIENT=${SELECTED_CLIENTS[0]}
        return 0
    fi

    MENU_OPTIONS=()
    MENU_CURRENT_INDEX=-1
    MENU_KIND=client
    MENU_MULTI=$multi
    while IFS=$'\t' read -r name ip mac policy online; do
        display_name=$name
        if [[ -n $CURRENT_CLIENT_MAC && $mac == "$CURRENT_CLIENT_MAC" ]]; then
            display_name+=" (this device)"
            MENU_CURRENT_INDEX=$index
        fi
        MENU_OPTIONS+=("$display_name"$'\t'"$ip"$'\t'"$policy"$'\t'"$([[ $online == true ]] && printf online || printf offline)")
        index=$((index + 1))
    done < <(
        jq -r --slurpfile policies "$TMP_DIR/policies.json" \
            ".[] | [.name, .ip, .mac, ($policy_label_filter), .online] | @tsv" \
            "$TMP_DIR/menu-clients.json"
    )

    printf '%s\n\n' "$heading" >&2
    if ! arrow_menu client; then
        MENU_MULTI=false
        unchanged "$MENU_CANCEL_MESSAGE"
        return 1
    fi
    MENU_MULTI=false
    if $multi; then
        for ((index = 0; index < ${#MENU_OPTIONS[@]}; index++)); do
            [[ ${MENU_CHECKED[index]:-0} == 1 ]] \
                && SELECTED_CLIENTS+=("$(jq -c --argjson index "$index" '.[$index]' "$TMP_DIR/menu-clients.json")")
        done
    fi
    ((${#SELECTED_CLIENTS[@]})) \
        || SELECTED_CLIENTS=("$(jq -c --argjson index "$((SELECTED_INDEX - 1))" '.[$index]' "$TMP_DIR/menu-clients.json")")
    SELECTED_CLIENT=${SELECTED_CLIENTS[0]}
}

resolve_client() {
    local selector=$1 value=$2 allow_prompt=$3 matches count label
    local pool=$TMP_DIR/connected.json
    [[ $ACTION == wake ]] && pool=$TMP_DIR/all-clients.json
    case $selector in
        client)
            label="name '$value'"
            matches=$(jq --arg value "$value" \
                '[.[] | select((.name | ascii_downcase) == ($value | ascii_downcase))]' "$pool")
            ;;
        ip)
            label="IP '$value'"
            matches=$(jq --arg value "$value" '[.[] | select(.ip == $value)]' "$pool")
            ;;
        mac)
            label="MAC '$value'"
            matches=$(jq --arg value "${value,,}" '[.[] | select(.mac == $value)]' "$pool")
            ;;
        *)
            fail "unknown client selector: $selector"
            ;;
    esac
    count=$(jq 'length' <<< "$matches")

    if ((count == 0)); then
        fail "$EXIT_CLIENT" "no client in the selected view has $label
Use --all to include offline clients."
    elif ((count == 1)); then
        SELECTED_CLIENT=$(jq -c '.[0]' <<< "$matches")
    elif $allow_prompt; then
        select_client_from_candidates "$matches" "Multiple clients match $label:" || return 1
    else
        printf 'Multiple clients match %s. Re-run with an exact address:\n' "$label" >&2
        jq -r --arg program "$PROGRAM" --arg command "$(action_command_suffix)" \
            'sort_by(.ip)[] | .ip as $ip | "  \($program) \($command | sub("SELECTOR"; "--ip " + $ip))    (\(.name), \(.mac))"' <<< "$matches" >&2
        fail "$EXIT_CLIENT" "client selector is ambiguous; use --ip or --mac"
    fi
}

# Command tail that reproduces the current action with a SELECTOR placeholder.
action_command_suffix() {
    case $ACTION in
        wake) printf 'wake SELECTOR' ;;
        policy) printf 'policy SELECTOR --policy %q' "$POLICY_QUERY" ;;
        block) printf 'policy SELECTOR --block' ;;
        unblock) printf 'policy SELECTOR --unblock' ;;
        *) printf 'policy SELECTOR' ;;
    esac
    $DRY_RUN && printf ' --dry-run'
    return 0
}

# Shared ambiguity report for positional NAME|IP|MAC lookups.
ambiguous_lookup() {
    local matches=$1 command=$2
    printf 'Multiple clients match %s. Re-run with an exact address:\n' "$INSPECT_QUERY" >&2
    jq -r --arg program "$PROGRAM" --arg command "$command" \
        'sort_by(.ip)[] | .ip as $ip | "  \($program) \($command | sub("SELECTOR"; $ip))    (\(.name), \(.mac))"' <<< "$matches" >&2
    fail "$EXIT_CLIENT" 'client name is ambiguous; use its IP or MAC address'
}

select_any_client() {
    local multi=${1:-false} clients heading='Connected clients:'
    clients=$(cat "$TMP_DIR/connected.json")
    [[ $VIEW_MODE == all ]] && heading='Known clients:'
    [[ $VIEW_MODE == offline ]] && heading='Offline clients:'
    select_client_from_candidates "$clients" "$heading" "$multi"
}

# Confirm an interactive block for SELECTED_CLIENTS that are not already blocked.
confirm_block_interactively() {
    local answer pending=0 client
    $DRY_RUN && return 0
    for client in "${SELECTED_CLIENTS[@]}"; do
        [[ $(client_policy_id "$client") == __block__ ]] || ((pending += 1))
    done
    ((pending > 0)) || return 0
    if ((${#SELECTED_CLIENTS[@]} == 1)); then
        printf 'Block Internet access for %s? [y/N]: ' "$(jq -r '.name' <<< "${SELECTED_CLIENTS[0]}")" >&2
    else
        printf 'Block Internet access for %d clients? [y/N]: ' "$pending" >&2
    fi
    IFS= read -r answer || fail 'confirmation input ended unexpectedly'
    [[ ${answer,,} == y || ${answer,,} == yes ]] || { unchanged 'No changes made.'; return 1; }
}

client_policy_id() {
    jq -r 'if .deny then "__block__" elif .policy == null or .policy == false then "__default__" else (.policy | tostring) end' \
        <<< "$1"
}

client_policy_label() {
    jq -r --slurpfile policies "$TMP_DIR/policies.json" "$policy_label_filter" <<< "$1"
}

load_policy_options() {
    POLICY_IDS=('__default__' '__block__')
    POLICY_LABELS=('Default' 'Block Internet')
    local id label
    while IFS=$'\t' read -r id label; do
        POLICY_IDS+=("$id")
        POLICY_LABELS+=("$label")
    done < <(
        jq -r 'to_entries
            | sort_by(.value.description // .key)
            | .[]
            | [.key, (.value.description // .key)]
            | @tsv' "$TMP_DIR/policies.json"
    )
}

choose_policy_interactively() {
    local client=$1 batch=${2:-1} name ip current_id current_label index option selected selected_id heading
    name=$(jq -r '.name' <<< "$client")
    ip=$(jq -r '.ip' <<< "$client")
    current_id=$(client_policy_id "$client")
    current_label=$(client_policy_label "$client")
    if ((batch > 1)); then
        current_id=; current_label=
        heading="Clients: $batch selected"
    else
        heading="Client: $name ($ip) | Current: $current_label"
    fi
    load_policy_options

    if [[ -t 0 && -t 2 ]] && command -v "$FZF_COMMAND" >/dev/null 2>&1; then
        selected=$(
            {
                for ((index = 0; index < ${#POLICY_IDS[@]}; index++)); do
                    [[ ${POLICY_IDS[index]} == "$current_id" ]] || continue
                    printf '%s\t%s (current)\n' "${POLICY_IDS[index]}" "${POLICY_LABELS[index]}"
                done
                for ((index = 0; index < ${#POLICY_IDS[@]}; index++)); do
                    [[ ${POLICY_IDS[index]} != "$current_id" ]] || continue
                    printf '%s\t%s\n' "${POLICY_IDS[index]}" "${POLICY_LABELS[index]}"
                done
            } | "$FZF_COMMAND" --delimiter=$'\t' --with-nth=2.. --height=70% --layout=reverse \
                --prompt='Policy> ' --header="$heading"
        ) || {
            unchanged 'No changes made.'
            return 1
        }
        selected_id=${selected%%$'\t'*}
        for ((index = 0; index < ${#POLICY_IDS[@]}; index++)); do
            if [[ ${POLICY_IDS[index]} == "$selected_id" ]]; then
                SELECTED_POLICY_ID=$selected_id
                SELECTED_POLICY_LABEL=${POLICY_LABELS[index]}
                return 0
            fi
        done
        fail 'fzf returned an unknown policy selection'
    fi

    MENU_OPTIONS=()
    MENU_CURRENT_INDEX=-1
    MENU_KIND=policy
    for ((index = 0; index < ${#POLICY_IDS[@]}; index++)); do
        option=${POLICY_LABELS[index]}
        if [[ ${POLICY_IDS[index]} == "$current_id" ]]; then
            option+=" (current)"
            MENU_CURRENT_INDEX=$index
        fi
        MENU_OPTIONS+=("$option")
    done

    if ((batch > 1)); then
        printf '%s\n\n' "$heading" >&2
    else
        printf 'Client: %s (%s)\n' "$name" "$ip" >&2
        printf 'Current policy: %s\n\n' "$current_label" >&2
    fi
    if ! arrow_menu policy; then
        unchanged 'No changes made.'
        return 1
    fi
    SELECTED_POLICY_ID=${POLICY_IDS[SELECTED_INDEX - 1]}
    SELECTED_POLICY_LABEL=${POLICY_LABELS[SELECTED_INDEX - 1]}
}

resolve_policy() {
    local query=$1 matches count
    if [[ ${query,,} == default ]]; then
        SELECTED_POLICY_ID=__default__
        SELECTED_POLICY_LABEL=Default
        return 0
    fi

    matches=$(jq --arg query "$query" \
        '[to_entries[] | select((.key | ascii_downcase) == ($query | ascii_downcase))]' \
        "$TMP_DIR/policies.json")
    count=$(jq 'length' <<< "$matches")
    if ((count == 0)); then
        matches=$(jq --arg query "$query" \
            '[to_entries[] | select(((.value.description // .key) | ascii_downcase) == ($query | ascii_downcase))]' \
            "$TMP_DIR/policies.json")
        count=$(jq 'length' <<< "$matches")
    fi

    if ((count == 0)); then
        printf 'Available policies:\n  Default\n' >&2
        jq -r 'to_entries | sort_by(.value.description // .key)[] | "  \(.value.description // .key) [\(.key)]"' \
            "$TMP_DIR/policies.json" >&2
        fail "$EXIT_POLICY" "unknown policy: $query"
    elif ((count > 1)); then
        fail "$EXIT_POLICY" "policy description is ambiguous: $query; use its policy ID instead"
    fi

    SELECTED_POLICY_ID=$(jq -r '.[0].key' <<< "$matches")
    SELECTED_POLICY_LABEL=$(jq -r '.[0].value.description // .[0].key' <<< "$matches")
}

verify_client_state() {
    local mac=$1 expected=$2 target_label=$3 delay attempt=0 assignment actual last_label=Unknown
    local -a delays=(0 0.25 0.25 0.5)
    for delay in "${delays[@]}"; do
        [[ $delay == 0 ]] || sleep "$delay"
        attempt=$((attempt + 1))
        api_get /rci/show/rc/ip/hotspot/host "$TMP_DIR/verify-assignments-$attempt.json" 'client policies' array
        assignment=$(jq -c --arg mac "$mac" \
            'first(.[] | select((.mac // "" | ascii_downcase) == $mac)) // empty' \
            "$TMP_DIR/verify-assignments-$attempt.json")
        if [[ -n $assignment ]]; then
            actual=$(jq -c '{policy: (.policy // false), deny: (.deny // false)}' <<< "$assignment")
        else
            actual='{"policy":false,"deny":false}'
        fi
        if jq -e --argjson expected "$expected" \
            '(.deny == $expected.deny) and (.policy == $expected.policy)' <<< "$actual" >/dev/null; then
            debug "Verification: $target_label observed on attempt $attempt"
            return 0
        fi
        last_label=$(client_policy_label "$actual")
    done
    fail "$EXIT_VERIFY" \
        "router still reported \"$last_label\" after applying \"$target_label\" (4 checks over 1 second)"
}

history_state() {
    jq -c '{policy: (.policy // false), deny: (.deny // false)}' <<< "$1"
}

record_history() {
    local client=$1 before=$2 after=$3 action=$4 directory temporary entry existing='[]'
    directory=${HISTORY_FILE%/*}
    [[ $directory == "$HISTORY_FILE" ]] && directory=.
    mkdir -p -- "$directory"
    chmod 700 "$directory"
    if [[ -e $HISTORY_FILE ]]; then
        jq -e 'type == "array"' "$HISTORY_FILE" >/dev/null \
            || fail "rollback history is not a JSON array: $HISTORY_FILE"
        existing=$(cat "$HISTORY_FILE")
    fi
    entry=$(jq -nc \
        --arg router "$ROUTER_URL" \
        --arg mac "$(jq -r '.mac' <<< "$client")" \
        --arg name "$(jq -r '.name' <<< "$client")" \
        --arg action "$action" \
        --arg timestamp "$(date -u +'%Y-%m-%dT%H:%M:%SZ')" \
        --argjson before "$before" \
        --argjson after "$after" \
        '{router:$router, mac:$mac, name:$name, action:$action, timestamp:$timestamp, before:$before, after:$after}')
    temporary=$(mktemp "$directory/.history.XXXXXX")
    jq --argjson entry "$entry" '. + [$entry] | if length > 20 then .[-20:] else . end' \
        <<< "$existing" > "$temporary"
    chmod 600 "$temporary"
    mv -f -- "$temporary" "$HISTORY_FILE"
    debug "Rollback history: recorded $action for $(jq -r '.mac' <<< "$client")"
}

action_description() {
    local client=$1 name
    name=$(jq -r '.name' <<< "$client")
    case $ACTION in
        policy) printf 'set %s to policy "%s"' "$name" "$SELECTED_POLICY_LABEL" ;;
        block) printf 'block Internet for %s' "$name" ;;
        unblock) printf 'unblock Internet for %s' "$name" ;;
        wake) printf 'wake %s' "$name" ;;
    esac
}

apply_client_action() {
    local client=$1 action=$2 record=${3:-true}
    local name mac before current_id current_policy payload expected target_label success_message
    name=$(jq -r '.name' <<< "$client")
    mac=$(jq -r '.mac' <<< "$client")
    before=$(history_state "$client")
    current_id=$(client_policy_id "$client")
    current_policy=$(jq -c '.policy // false' <<< "$client")

    case $action in
        policy)
            target_label=$SELECTED_POLICY_LABEL
            if [[ $current_id == "$SELECTED_POLICY_ID" ]]; then
                unchanged "$name already uses $SELECTED_POLICY_LABEL. No changes made."
                return 0
            fi
            if [[ $SELECTED_POLICY_ID == __default__ ]]; then
                expected='{"policy":false,"deny":false}'
                payload=$(jq -nc --arg mac "$mac" \
                    '{mac:$mac, policy:false, permit:true, schedule:false}')
            else
                expected=$(jq -nc --arg policy "$SELECTED_POLICY_ID" \
                    '{policy:$policy, deny:false}')
                payload=$(jq -nc --arg mac "$mac" --arg policy "$SELECTED_POLICY_ID" \
                    '{mac:$mac, policy:$policy, permit:true, schedule:false}')
            fi
            success_message="Applied and verified policy \"$target_label\" for $name."
            ;;
        block)
            target_label='Blocked'
            if jq -e '.deny' <<< "$before" >/dev/null; then
                unchanged "$name is already blocked. No changes made."
                return 0
            fi
            expected=$(jq -nc --argjson policy "$current_policy" '{policy:$policy, deny:true}')
            payload=$(jq -nc --arg mac "$mac" '{mac:$mac, schedule:false, deny:true}')
            success_message="Blocked Internet access for $name and verified it."
            ;;
        unblock)
            target_label=$(client_policy_label "$(jq -c '.deny = false' <<< "$client")")
            if ! jq -e '.deny' <<< "$before" >/dev/null; then
                unchanged "$name is not blocked. No changes made."
                return 0
            fi
            expected=$(jq -nc --argjson policy "$current_policy" '{policy:$policy, deny:false}')
            payload=$(jq -nc --arg mac "$mac" --argjson policy "$current_policy" \
                '{mac:$mac, policy:$policy, permit:true, schedule:false}')
            success_message="Unblocked Internet access for $name and verified it."
            ;;
        *)
            fail "unsupported client action: $action"
            ;;
    esac

    if $DRY_RUN; then
        printf 'Would %s.\n' "$(action_description "$client")"
        return 0
    fi
    http_request POST /rci/ip/hotspot/host "$TMP_DIR/apply-result.json" "$payload"
    [[ $HTTP_STATUS == 200 ]] || response_error "failed to $action client" "$TMP_DIR/apply-result.json"
    verify_client_state "$mac" "$expected" "$target_label"
    $record && record_history "$client" "$before" "$expected" "$action"
    success "$success_message"
}

wake_client() {
    local client=$1 name mac payload detail
    name=$(jq -r '.name' <<< "$client")
    mac=$(jq -r '.mac' <<< "$client")
    if $DRY_RUN; then
        printf 'Would wake %s (%s).\n' "$name" "$mac"
        return 0
    fi
    payload=$(jq -nc --arg mac "$mac" '{mac:$mac}')
    http_request POST /rci/ip/hotspot/wake "$TMP_DIR/wake-result.json" "$payload"
    [[ $HTTP_STATUS == 200 ]] || response_error 'failed to send Wake-on-LAN' "$TMP_DIR/wake-result.json"
    detail=$(jq -r 'if type == "string" then . elif type == "object" then (.message // .result // tostring) else tostring end' \
        "$TMP_DIR/wake-result.json" 2>/dev/null || cat "$TMP_DIR/wake-result.json")
    success "Wake-on-LAN request for $name: $detail"
}

preflight_clients() {
    local index existing mac duplicate
    SELECTED_CLIENTS=()
    for ((index = 0; index < ${#CLIENT_SELECTORS[@]}; index++)); do
        resolve_client "${CLIENT_SELECTORS[index]}" "${CLIENT_VALUES[index]}" false
        mac=$(jq -r '.mac' <<< "$SELECTED_CLIENT")
        duplicate=false
        for existing in "${SELECTED_CLIENTS[@]}"; do
            [[ $(jq -r '.mac' <<< "$existing") == "$mac" ]] && duplicate=true
        done
        $duplicate || SELECTED_CLIENTS+=("$SELECTED_CLIENT")
    done
}

run_selected_actions() {
    local client index total=${#SELECTED_CLIENTS[@]}
    if ((total > 1)) || $DRY_RUN; then
        printf 'Plan (%d client%s):\n' "$total" "$([[ $total == 1 ]] || printf s)"
        for client in "${SELECTED_CLIENTS[@]}"; do
            printf '  - %s\n' "$(action_description "$client")"
        done
    fi
    for ((index = 0; index < total; index++)); do
        client=${SELECTED_CLIENTS[index]}
        if ((total > 1)); then
            OPERATION_CONTEXT="batch item $((index + 1))/$total ($(jq -r '.name' <<< "$client"); $index already completed)"
        fi
        if [[ $ACTION == wake ]]; then
            wake_client "$client"
        else
            apply_client_action "$client" "$ACTION"
        fi
        OPERATION_CONTEXT=
    done
}

remove_history_entry() {
    local index=$1 directory temporary
    directory=${HISTORY_FILE%/*}
    [[ $directory == "$HISTORY_FILE" ]] && directory=.
    temporary=$(mktemp "$directory/.history.XXXXXX")
    jq --argjson index "$index" 'del(.[$index])' "$HISTORY_FILE" > "$temporary"
    chmod 600 "$temporary"
    mv -f -- "$temporary" "$HISTORY_FILE"
}

undo_last_action() {
    local index entry mac name before client current payload target_label
    [[ -r $HISTORY_FILE ]] || fail 'no rollback history is available'
    jq -e 'type == "array"' "$HISTORY_FILE" >/dev/null \
        || fail "rollback history is not a JSON array: $HISTORY_FILE"
    if $INTERACTIVE; then
        jq -e --arg router "$ROUTER_URL" 'any(.[]; .router == $router)' "$HISTORY_FILE" >/dev/null \
            || fail "no rollback entry exists for $ROUTER_URL"
        MENU_CANCEL_MESSAGE='No change selected.'
        pick_from_list 'Recorded changes, newest first (restore the state before the change):' 'Change' false 3< <(
            jq -r --arg router "$ROUTER_URL" --slurpfile policies "$TMP_DIR/policies.json" \
                "def policy_label: $policy_label_filter;"'
                [to_entries[] | select(.value.router == $router)] | reverse[]
                | [(.key | tostring), (.value.timestamp + "  " + .value.name + "  " + .value.action + ": "
                    + (.value.after | policy_label) + " → restore " + (.value.before | policy_label))] | @tsv' "$HISTORY_FILE"
        ) || return 0
        index=$SELECTED_VALUE
    else
        index=$(jq -r --arg router "$ROUTER_URL" \
            '[to_entries[] | select(.value.router == $router)] | last | .key // empty' "$HISTORY_FILE")
        [[ -n $index ]] || fail "no rollback entry exists for $ROUTER_URL"
    fi
    entry=$(jq -c --argjson index "$index" '.[$index]' "$HISTORY_FILE")
    mac=$(jq -r '.mac' <<< "$entry")
    name=$(jq -r '.name' <<< "$entry")
    before=$(jq -c '.before' <<< "$entry")
    client=$(jq -c --arg mac "$mac" 'first(.[] | select(.mac == $mac)) // empty' "$TMP_DIR/all-clients.json")
    if [[ -z $client ]]; then
        client=$(jq -nc --arg name "$name" --arg mac "$mac" --argjson state "$(jq -c '.after' <<< "$entry")" \
            '{name:$name, ip:"N/A", mac:$mac, online:false, policy:$state.policy, deny:$state.deny}')
    fi
    current=$(history_state "$client")
    target_label=$(client_policy_label "$before")
    if $DRY_RUN; then
        printf 'Would restore %s (%s) to "%s" from the %s change recorded at %s.\n' \
            "$name" "$mac" "$target_label" "$(jq -r '.action' <<< "$entry")" "$(jq -r '.timestamp' <<< "$entry")"
        return 0
    fi
    if [[ $current == "$before" ]]; then
        unchanged "$name already has the recorded previous state."
    else
        if jq -e '.deny' <<< "$before" >/dev/null; then
            payload=$(jq -nc --arg mac "$mac" --argjson state "$before" \
                '{mac:$mac, policy:$state.policy, schedule:false, deny:true}')
        else
            payload=$(jq -nc --arg mac "$mac" --argjson state "$before" \
                '{mac:$mac, policy:$state.policy, permit:true, schedule:false}')
        fi
        http_request POST /rci/ip/hotspot/host "$TMP_DIR/undo-result.json" "$payload"
        [[ $HTTP_STATUS == 200 ]] || response_error 'failed to restore rollback state' "$TMP_DIR/undo-result.json"
        verify_client_state "$mac" "$before" "$target_label"
        success "Restored and verified \"$target_label\" for $name."
    fi
    remove_history_entry "$index"
    success 'Removed the restored change from rollback history.'
}


prepare_session() {
    require_command curl
    require_command jq
    command -v md5sum >/dev/null 2>&1 || command -v md5 >/dev/null 2>&1 \
        || fail 'required MD5 tool not found: install md5sum or md5'
    command -v sha256sum >/dev/null 2>&1 || command -v shasum >/dev/null 2>&1 \
        || fail 'required SHA-256 tool not found: install sha256sum or shasum'
    create_temp_dir
}

setup_main() {
    if $DISCOVER; then
        discover_router
    else
        prepare_session
        init_config
    fi
}

start_router_session() {
    if ! $SESSION_READY; then
        prepare_session
        load_config
        SESSION_READY=true
    fi
    authenticate
}

read_optional_json() {
    local endpoint=$1 file=$2 kind=$3 label=$4
    http_request GET "$endpoint" "$file"
    if [[ $HTTP_STATUS == 401 || $HTTP_STATUS == 403 ]]; then response_error "failed to retrieve $label" "$file"; fi
    if [[ $HTTP_STATUS != 200 ]] || ! jq -e --arg kind "$kind" \
        'type == $kind and (any(.. | objects; .status? == "error") | not)' "$file" >/dev/null 2>&1; then
        warn "$label unavailable (HTTP $HTTP_STATUS)."
        printf 'null\n' > "$file"
    fi
}

report_format_filter() {
    cat <<'JQ'
        def text: if . == null then "unknown" elif type == "boolean" then (if . then "yes" else "no" end) else tostring end | clean;
        def number: if type == "number" or type == "string" then (try tonumber catch null) else null end;
        def nonnegative: number | if . != null and . >= 0 then . else null end;
        ($columns | tonumber | if . < 20 then 20 else . end) as $screen
        | def label_case: (.[0:1] | ascii_upcase) + (.[1:] | ascii_downcase);
          # Key/value block. Fields whose value is not reported are folded into one dim line
          # so real data stands out; JSON output keeps every field.
          def fields($title; $rows):
            ($title | clean | wordwrap($screen)[]),
            (($rows | map([(.[0] | clean), (.[1] | text)])) as $all
             | ($all | map(select(.[1] | unreported | not))) as $known
             | ($all | map(select(.[1] | unreported)) | map(.[0])) as $missing
             | ($known | map(.[0] | width) | max // 0) as $natural
             | ([$natural, 22] | min) as $label_width
             | ($known[] | .[0] as $field_label | .[1] as $value
                | if $screen < 40 then $dim + $field_label + $reset, ($value | wordwrap($screen - 2)[] | "  " + . | paint($value))
                  else ($value | wordwrap($screen - $label_width - 2) | to_entries[])
                    | $dim + ((if .key == 0 then $field_label else "" end) | fit($label_width; false)) + $reset + "  " + (.value | paint($value)) end),
               (if $missing | length == 0 then empty
                else ("Not reported: " + ($missing | join(", "))) | wordwrap($screen)[] | $dim + . + $reset end));
          def grid($title; $headers; $data; $hint):
            ($title | clean | wordwrap($screen)[]),
            (if $data | length == 0 then ($dim + (if $hint == "" then "None" else $hint end) + $reset)
             else ($data | map(map(text))) as $rows
               | ($headers | length) as $n
               | if $screen < 72 then
                   $rows[] | . as $row
                   | ($row[0] | wordwrap($screen)[]),
                     (range(1; $n) as $i | $row[$i] as $value
                      | (($headers[$i] | label_case) + ": " + $value) | wordwrap($screen - 2)[] | "  " + . | paint($value))
                 else
                   [range(0; $n) as $i | ([$headers[$i] | width] + [$rows[] | .[$i] | width] | max)
                      | [., 40] | min] as $natural
                   | ([($natural | add) - ($screen - 2 * ($n - 1)), 0] | max) as $excess
                   | (reduce range(0; $excess) as $step ($natural;
                        max as $largest | index($largest) as $i | .[$i] -= 1)) as $widths
                   | def line($row): [range(0; $n) as $i | $row[$i] | fit($widths[$i]; false) | paint($row[$i])] | join("  ") | rtrim;
                   $dim + ([range(0; $n) as $i | $headers[$i] | fit($widths[$i]; false)] | join("  ") | rtrim) + $reset, ($rows[] | line(.))
                 end
             end);
          def grid($title; $headers; $data): grid($title; $headers; $data; "");
JQ
}

render_report() {
    local file=$1
    shift
    if $JSON_OUTPUT; then cat "$file"; return; fi
    # Extra jq arguments may precede the filter, which is always the last argument.
    jq -r --arg columns "$(terminal_columns)" "${COLOR_ARGS[@]}" "${@:1:$#-1}" \
        "$(table_format_filter) $(report_format_filter) ${*: -1}" "$file"
}

system_reboot() {
    local answer
    if $DRY_RUN; then
        printf 'Would request an immediate reboot of %s.\n' "$ROUTER_URL"
        return
    fi
    # Ask in a terminal unless --yes or --quiet; scripts without a terminal proceed as before.
    if ! $ASSUME_YES && ! $QUIET && [[ -t 0 && -t 2 ]]; then
        printf 'Reboot %s now? Network access will be interrupted. [y/N]: ' "$ROUTER_URL" >&2
        IFS= read -r answer || fail 'confirmation input ended unexpectedly'
        [[ ${answer,,} == y || ${answer,,} == yes ]] || { unchanged 'No changes made.'; return 0; }
    fi
    # One request only: a lost response can mean the router is already rebooting.
    OPERATION_CONTEXT="reboot request to $ROUTER_URL; if the response is lost, the router may already be rebooting"
    http_request POST /rci/ "$TMP_DIR/reboot-result.json" '{"system":{"reboot":{}}}'
    [[ $HTTP_STATUS == 200 ]] || response_error 'failed to request router reboot' "$TMP_DIR/reboot-result.json"
    if ! jq -e 'type == "object" and (any(.. | objects; .status? == "error") | not)' \
        "$TMP_DIR/reboot-result.json" >/dev/null 2>&1; then
        fail 'router rejected the reboot command or returned an invalid response'
    fi
    OPERATION_CONTEXT=
    success "Reboot request accepted by $ROUTER_URL."
}

system_main() {
    start_router_session
    case $SUBCOMMAND in reboot) system_reboot; return ;; changes) system_changes; return ;; save) system_save; return ;; esac
    api_get /rci/show/system "$TMP_DIR/system-raw.json" 'system health' object
    read_optional_json /rci/show/version "$TMP_DIR/version.json" object 'Firmware metadata'
    if ! jq --arg router "$ROUTER_URL" --slurpfile version "$TMP_DIR/version.json" '
        def num: if type == "number" or type == "string" then (try tonumber catch null) else null end;
        def kb: num | if . != null and . >= 0 then . * 1024 else null end;
        def text: if type == "string" then . else null end;
        if (has("uptime") or has("cpuload") or has("memory") | not)
            or any(.. | objects; .status? == "error") then error("invalid system data") else . end
        | ((.memory | text // "") | split("/")) as $memory
        | {router:$router, hostname:(.hostname | text), model:($version[0].model | text),
           firmware:($version[0].title | text), uptime_seconds:(.uptime | num), cpu_percent:(.cpuload | num),
           memory:{used_bytes:($memory[0] | kb), total_bytes:((.memtotal // $memory[1]) | kb),
                   free_bytes:(.memfree | kb), cached_bytes:(.memcache | kb)},
           swap:{total_bytes:(.swaptotal | kb), free_bytes:(.swapfree | kb)},
           connections:{capacity:(.conntotal | num), used:(if (.conntotal | num) != null and (.connfree | num) != null
                then (.conntotal | num) - (.connfree | num) else null end)}}
    ' "$TMP_DIR/system-raw.json" > "$TMP_DIR/system.json"; then fail 'the router returned invalid system health data'; fi
    render_report "$TMP_DIR/system.json" '
        fields("Router health"; [["Model",.model],["Firmware",.firmware],["Hostname",.hostname],
            ["Uptime",(.uptime_seconds | duration)],["CPU",((.cpu_percent | text) + "%")],
            ["RAM used / total",((.memory.used_bytes | bytes) + " / " + (.memory.total_bytes | bytes))],
            ["RAM free",(.memory.free_bytes | bytes)],["RAM cached",(.memory.cached_bytes | bytes)],
            ["Swap free / total",((.swap.free_bytes | bytes) + " / " + (.swap.total_bytes | bytes))],
            ["Connections",((.connections.used | text) + " / " + (.connections.capacity | text))]])'
}

vpn_main() {
    start_router_session
    api_get /rci/show/interface "$TMP_DIR/vpn-raw.json" 'VPN interfaces' object
    if ! jq --arg router "$ROUTER_URL" '
        def num: if type == "number" or type == "string" then (try tonumber catch null) else null end;
        def text: if type == "string" then . else null end;
        if any(.[]; type != "object") or any(.. | objects; .status? == "error") then error("invalid interface") else . end
        | {router:$router, peers:[to_entries[] | .key as $id | .value
            | select((.type // "") | test("wireguard";"i")) | . as $interface
            | (.wireguard.peer // []) | if type != "array" then error("invalid WireGuard peers") else . end
            | to_entries[] | .key as $index | .value
            | if type != "object" then error("invalid peer") else . end
            | {interface:($interface.id // $id), interface_description:($interface.description | text),
               peer:((.description | text | select(length > 0)) // ("Peer " + (($index + 1) | tostring))),
               public_key:(."public-key" | text), endpoint_address:(."remote-endpoint-address" | text),
               endpoint_port:(."remote-port" | num), via:(.via | text),
               handshake_age_seconds:(."last-handshake" | num), rx_bytes:(.rxbytes | num), tx_bytes:(.txbytes | num),
               status:(if .enabled == false or $interface.state == "down" then "disabled"
                       elif .online == true then "online" elif .online == false then "offline" else "unknown" end)}]}
    ' "$TMP_DIR/vpn-raw.json" > "$TMP_DIR/vpn.json"; then fail 'the router returned invalid WireGuard peer data'; fi
    render_report "$TMP_DIR/vpn.json" '
        grid("WireGuard peers"; ["INTERFACE","PEER","ENDPOINT","HANDSHAKE","RX","TX","STATUS"];
            [.peers[] | [.interface,.peer,
                (if .endpoint_address == null then null else
                    (if .endpoint_address | contains(":") then "[" + .endpoint_address + "]" else .endpoint_address end)
                    + (if .endpoint_port == null then "" else ":" + (.endpoint_port | tostring) end) end),
                (if .handshake_age_seconds == null then null else (.handshake_age_seconds | tostring) + "s ago" end),
                (.rx_bytes | bytes),(.tx_bytes | bytes),.status]];
            "No WireGuard peers are configured. Other VPN types appear in keenetic interfaces --all.")'
}

wifi_monitor_main() {
    local id encoded
    api_get /rci/show/interface "$TMP_DIR/monitor-interfaces.json" 'Wi-Fi radios' object
    if ! jq --arg view "$VIEW_MODE" '
        if any(.[]; type != "object") then error("invalid interface") else . end
        | [to_entries[] | .key as $key | .value | select(.type == "WifiMaster")
            | select($view == "all" or .state != "down")
            | {id:(.id // $key),channel:(.channel // null),width_mhz:(.bandwidth // null),state:(.state // "unknown")}]
    ' "$TMP_DIR/monitor-interfaces.json" > "$TMP_DIR/radios.json"; then fail 'invalid Wi-Fi radio data'; fi
    printf '[]\n' > "$TMP_DIR/radio-loads.json"
    while IFS= read -r id; do
        encoded=$(jq -rn --arg id "$id" '$id | @uri')
        read_optional_json "/rci/show/interface/channel-utilization/rrd?name=$encoded&attribute=load&detail=0" \
            "$TMP_DIR/radio-load.json" object "Channel utilization for $id"
        jq --arg id "$id" --slurpfile sample "$TMP_DIR/radio-load.json" '
            def num: if type == "number" or type == "string" then (try tonumber catch null) else null end;
            (if ($sample[0].data | type) == "array" then [$sample[0].data[] | select(type == "object")
                | {t:(.t | num),v:(.v | num)} | select(.t != null and .v != null and .v >= 0 and .v <= 100)] else [] end) as $data
            | ($data | map(.t) | max) as $latest
            | [$data[] | select(.t > $latest - 180)] as $window
            | . + [{id:$id, samples:($window | length), current_percent:($window | max_by(.t) | .v),
                average_percent:(if $window | length > 0 then (($window | map(.v) | add) / ($window | length) * 10 | round) / 10 else null end),
                peak_percent:($window | map(.v) | max)}]
        ' "$TMP_DIR/radio-loads.json" > "$TMP_DIR/radio-loads-next.json"
        mv "$TMP_DIR/radio-loads-next.json" "$TMP_DIR/radio-loads.json"
    done < <(jq -r '.[].id' "$TMP_DIR/radios.json")
    jq --arg router "$ROUTER_URL" --slurpfile loads "$TMP_DIR/radio-loads.json" '
        ($loads[0] | map({key:.id,value:.}) | from_entries) as $by_id
        | {router:$router,window_seconds:180,radios:map(. + $by_id[.id])}
    ' "$TMP_DIR/radios.json" > "$TMP_DIR/wifi-monitor.json"
    # shellcheck disable=SC2016 # Variables in the filter belong to jq.
    render_report "$TMP_DIR/wifi-monitor.json" --arg view "$VIEW_MODE" '
        grid("Wi-Fi channel utilization · last 3 minutes"; ["RADIO","CH","WIDTH MHz","NOW %","AVG %","PEAK %","STATE"];
            [.radios[] | [.id,.channel,.width_mhz,.current_percent,.average_percent,.peak_percent,.state]];
            (if $view == "all" then "No Wi-Fi radios were reported." else "No enabled Wi-Fi radios. Use --all to include disabled radios." end))'
}

clients_main() {
    start_router_session
    if [[ $SUBCOMMAND == rename ]]; then clients_rename; return; fi
    if $INTERACTIVE; then
        # Pick from the listing view (connected by default; --all/--offline widen it), then inspect.
        fetch_router_state; detect_current_client
        MENU_CANCEL_MESSAGE='No client selected.'
        select_any_client || return 0
        printf '\n'
        inspect_client
        return
    fi
    if [[ $SUBCOMMAND != inspect ]]; then
        fetch_router_state; detect_current_client
        if $JSON_OUTPUT; then list_clients_json; else list_clients_table; fi
        return
    fi
    VIEW_MODE=all
    fetch_router_state
    local matches count
    matches=$(jq --arg query "$INSPECT_QUERY" '[.[] | select(.ip == $query or .mac == ($query | ascii_downcase)
        or (.name | ascii_downcase) == ($query | ascii_downcase))] | unique_by(.mac)' "$TMP_DIR/all-clients.json")
    count=$(jq 'length' <<< "$matches")
    ((count > 0)) || fail "$EXIT_CLIENT" "no client matches $INSPECT_QUERY. Names are matched exactly; try 'keenetic clients --all' to list known clients."
    ((count == 1)) || ambiguous_lookup "$matches" 'clients inspect SELECTOR'
    SELECTED_CLIENT=$(jq -c '.[0]' <<< "$matches")
    inspect_client
}

# Render the detail view for SELECTED_CLIENT; fetch_router_state must already have run.
inspect_client() {
    local mac
    mac=$(jq -r '.mac' <<< "$SELECTED_CLIENT")
    read_optional_json '/rci/show/ip/hotspot/summary?detail=0&attribute=sumbytes' "$TMP_DIR/inspect-traffic.json" object 'Recent client traffic'
    read_optional_json /rci/show/interface "$TMP_DIR/inspect-interfaces.json" object 'Client radio details'
    jq --arg router "$ROUTER_URL" --arg mac "$mac" --argjson client "$SELECTED_CLIENT" \
        --slurpfile traffic "$TMP_DIR/inspect-traffic.json" --slurpfile interfaces "$TMP_DIR/inspect-interfaces.json" \
        --slurpfile policies "$TMP_DIR/policies.json" "def policy_label: $policy_label_filter;"'
        def text: if type == "string" then . else null end;
        def num: if type == "number" or type == "string" then (try tonumber catch null) else null end;
        (first(.[] | select((.mac | ascii_downcase) == $mac)) // {}) as $host
        | (($host.ap // $host.mws.ap) | text) as $ap
        | ($ap // "" | split("/")[0]) as $radio_id
        | ((if $traffic[0].t == 0 and ($traffic[0].host | type) == "array" then
              first($traffic[0].host[] | select((.mac // "" | ascii_downcase) == $mac)) else null end) // null) as $usage
        | {router:$router, client:($client | {name,ip,mac,online,blocked:.deny,policy:policy_label,
            policy_id:(if .policy == false then null else .policy end)}
            + {hostname:($host.hostname | text), connection:(if $ap != null or ($host.ssid | type) == "string" then "wireless" else "wired" end),
               interface:($host.interface.id | text), ap:$ap, ssid:($host.ssid // $host.mws.ssid | text),
               signal_dbm:($host.rssi // $host.mws.rssi | num), tx_rate_mbps:($host.txrate | num), rx_rate_mbps:($host.rxrate | num),
               uptime_seconds:($host.uptime | num), channel:($interfaces[0][$radio_id].channel // null),
               band:($interfaces[0][$radio_id] as $radio
                   | if $radio.band != null then ($radio.band | tostring)
                     elif (($radio.frequency | num) // 0) >= 5925 then "6 GHz"
                     elif (($radio.frequency | num) // 0) >= 4900 then "5 GHz"
                     elif $radio_id == "WifiMaster0" then "2.4 GHz"
                     elif $radio_id == "WifiMaster1" then "5 GHz" else null end),
               recent_traffic:(if $usage == null then null else {window_seconds:180,rx_bytes:($usage.rxbytes | num),
                   tx_bytes:($usage.txbytes | num),total_bytes:($usage.sumbytes | num)} end)})}
    ' "$TMP_DIR/clients.json" > "$TMP_DIR/client-inspect.json"
    render_report "$TMP_DIR/client-inspect.json" '
        .client | fields("Client details"; [["Name",.name],["IP",.ip],["MAC",.mac],["Hostname",.hostname],
            ["Status",(if .online then "online" else "offline" end)],["Connection",.connection],["Policy",.policy],["Blocked",.blocked],
            ["Interface",.interface],["Access point",.ap],["SSID",.ssid],["Band",.band],["Channel",.channel],
            ["Signal dBm",.signal_dbm],["TX Mbps",.tx_rate_mbps],["RX Mbps",.rx_rate_mbps],["Connected for",(.uptime_seconds | duration)],
            ["Traffic · 3 minutes",((.recent_traffic.rx_bytes | bytes) + " RX / " + (.recent_traffic.tx_bytes | bytes) + " TX")]])'
}

list_policies() {
    jq --arg router "$ROUTER_URL" --slurpfile clients "$TMP_DIR/all-clients.json" '
        . as $policies
        | {router:$router, policies:(
            [{id:null, name:"Default", interfaces:null,
              clients:([$clients[0][] | select((.policy == null or .policy == false) and .deny != true)] | length)}]
            + [to_entries[] | select(.value | type == "object") | .key as $id
               | {id:$id, name:(.value.description // $id), interfaces:((.value.permit // []) | length),
                  clients:([$clients[0][] | select(.policy == $id and .deny != true)] | length)}]
            + [{id:null, name:"Blocked", interfaces:0, clients:([$clients[0][] | select(.deny == true)] | length)}])}
    ' "$TMP_DIR/policies.json" > "$TMP_DIR/policy-list.json"
    # shellcheck disable=SC2016 # Variables in the filter belong to jq.
    render_report "$TMP_DIR/policy-list.json" '
        grid("Connection policies"; ["NAME","ID","INTERFACES","CLIENTS"];
            [.policies[] | [.name, (.id // "-"), (if .interfaces == null then "all global" else .interfaces end), .clients]]),
        "", ($dim + "Use keenetic policy show NAME for interfaces and clients, or keenetic client assign CLIENT POLICY." + $reset)'
}

inspect_policy() {
    local index
    if [[ -z $INSPECT_QUERY ]]; then
        load_policy_options
        MENU_CANCEL_MESSAGE='No policy selected.'
        pick_from_list 'Connection policies:' 'Policy' false 3< <(
            for ((index = 0; index < ${#POLICY_IDS[@]}; index++)); do
                [[ ${POLICY_IDS[index]} == __block__ ]] || printf '%s\t%s\n' "${POLICY_IDS[index]}" "${POLICY_LABELS[index]}"
            done
        ) || return 0
        SELECTED_POLICY_ID=$SELECTED_VALUE
        for ((index = 0; index < ${#POLICY_IDS[@]}; index++)); do
            [[ ${POLICY_IDS[index]} != "$SELECTED_POLICY_ID" ]] || SELECTED_POLICY_LABEL=${POLICY_LABELS[index]}
        done
        printf '\n'
    else
        resolve_policy "$INSPECT_QUERY"
    fi
    api_get /rci/show/interface "$TMP_DIR/policy-interfaces.json" 'policy interface status' object
    jq --arg router "$ROUTER_URL" --arg id "$SELECTED_POLICY_ID" --arg name "$SELECTED_POLICY_LABEL" \
        --slurpfile interfaces "$TMP_DIR/policy-interfaces.json" --slurpfile clients "$TMP_DIR/all-clients.json" '
        ($interfaces[0] | to_entries | map({key:(.value.id // .key),value:.value}) | from_entries) as $by_id
        | (if $id == "__default__" then [$by_id | to_entries[] | select(.value.global == true)
                | {interface:.key,enabled:true,priority:(.value.priority // null)}] | sort_by(-(.priority // 0))
           else .[$id].permit // [] end) as $permits
        | {router:$router,id:(if $id == "__default__" then null else $id end),name:$name,
           interfaces:[$permits | to_entries[] | .key as $order | .value
               | {id:.interface,order:($order+1),enabled:(.enabled != false and .no != true),
                  priority:(.priority // $by_id[.interface].priority // null),
                  priority_source:(if .priority != null and $id != "__default__" then "policy" else "interface" end),
                  status:($by_id[.interface] | if .state == "down" then "disabled" elif .connected == "yes" or .connected == true
                    then "connected" elif .link == "up" then "link up" elif .link == "down" then "link down" else "unknown" end)}],
           clients:[$clients[0][] | select(if $id == "__default__" then .policy == null or .policy == false else .policy == $id end)
               | {name,ip,mac,online,blocked:.deny}]}
    ' "$TMP_DIR/policies.json" > "$TMP_DIR/policy-inspect.json"
    render_report "$TMP_DIR/policy-inspect.json" '
        fields("Policy details"; [["Name",.name],["ID",(.id // "Default")]]),"",
        grid("Interfaces"; ["ORDER","INTERFACE","ENABLED","PRIORITY","STATUS"];
            [.interfaces[] | [.order,.id,.enabled,.priority,.status]];
            "This policy permits no interfaces; clients assigned to it have no route."),"",
        grid("Assigned clients"; ["NAME","IP","STATUS","BLOCKED"];
            [.clients[] | [.name,.ip,(if .online then "online" else "offline" end),.blocked]];
            "No clients use this policy. Assign one with keenetic policy set CLIENT POLICY.")'
}

fetch_logs() {
    local payload
    payload=$(jq -nc --argjson limit "$LOG_LIMIT" '{"max-lines":$limit,once:true}')
    http_request POST /rci/show/log "$TMP_DIR/log-raw.json" "$payload"
    [[ $HTTP_STATUS == 200 ]] || response_error 'failed to retrieve router logs' "$TMP_DIR/log-raw.json"
    if ! jq --arg router "$ROUTER_URL" --arg filter "$LOG_FILTER" '
        if (.log | type) != "object" or any(.. | objects; .status? == "error") then error("invalid log data") else . end
        | {router:$router,entries:[.log | to_entries[] | .value
            | {id:.id,timestamp:.timestamp,level:.message.level,source:.ident,message:.message.message}
            | select((.message | type) == "string")
            | select($filter == "" or ((.message + " " + (.source // "")) | ascii_downcase | contains($filter | ascii_downcase)))]
            | sort_by(.id)}
    ' "$TMP_DIR/log-raw.json" > "$TMP_DIR/logs.json"; then fail 'the router returned invalid log data'; fi
}

logs_main() {
    start_router_session
    fetch_logs
    if $INTERACTIVE && jq -e '.entries | length > 0' "$TMP_DIR/logs.json" >/dev/null; then
        MENU_CANCEL_MESSAGE='No source selected.'
        pick_from_list 'Log sources in the retrieved entries:' 'Source' false 3< <(
            printf '__all__\tAll sources\n'
            jq -r '[.entries[] | .source // "unknown"] | unique[] | [., .] | @tsv' "$TMP_DIR/logs.json"
        ) || return 0
        if [[ $SELECTED_VALUE != __all__ ]]; then
            LOG_FILTER=$SELECTED_VALUE
            jq --arg source "$LOG_FILTER" '.entries |= map(select((.source // "unknown") == $source))' \
                "$TMP_DIR/logs.json" > "$TMP_DIR/logs-filtered.json"
            mv "$TMP_DIR/logs-filtered.json" "$TMP_DIR/logs.json"
        fi
        printf '\n'
    fi
    # shellcheck disable=SC2016 # Variables in the filter belong to jq.
    render_report "$TMP_DIR/logs.json" --arg filter "$LOG_FILTER" '
        grid("Router logs"; ["TIME","LEVEL","SOURCE","MESSAGE"];
            [.entries[] | [.timestamp,.level,.source,.message]];
            (if $filter == "" then "The router returned no log entries." else "No recent log entries match --filter " + ($filter | tojson) + ". Raise --limit to search further back." end))'
}

run_diagnostic_test() {
    local kind=$1 payload=$2 endpoint="/rci/tools/$1" started=$SECONDS remaining
    printf '[]\n' > "$TMP_DIR/diagnostic-lines.json"
    http_request POST "$endpoint" "$TMP_DIR/diagnostic-chunk.json" "$payload"
    [[ $HTTP_STATUS == 200 ]] || response_error "failed to start $kind" "$TMP_DIR/diagnostic-chunk.json"
    DIAG_ACTIVE_ENDPOINT=$endpoint
    while true; do
        if ! jq -e 'type == "object" and (any(.. | objects; .status? == "error") | not)
            and ((.message // []) | type == "array" and all(.[]; type == "string"))' \
            "$TMP_DIR/diagnostic-chunk.json" >/dev/null 2>&1; then
            fail "router returned an invalid $kind response"
        fi
        jq --slurpfile chunk "$TMP_DIR/diagnostic-chunk.json" '. + ($chunk[0].message // [])' \
            "$TMP_DIR/diagnostic-lines.json" > "$TMP_DIR/diagnostic-lines-next.json"
        mv "$TMP_DIR/diagnostic-lines-next.json" "$TMP_DIR/diagnostic-lines.json"
        if ! jq -e 'has("continued") and .continued != false and .continued != null' "$TMP_DIR/diagnostic-chunk.json" >/dev/null; then
            DIAG_ACTIVE_ENDPOINT=
            break
        fi
        DIAG_ACTIVE_ENDPOINT=$endpoint
        ((SECONDS - started < 60)) || fail "$kind exceeded its 60-second time limit"
        sleep 0.5 &
        WATCH_SLEEP_PID=$!
        wait "$WATCH_SLEEP_PID"
        WATCH_SLEEP_PID=
        remaining=$((60 - (SECONDS - started)))
        ((remaining > 0)) || fail "$kind exceeded its 60-second time limit"
        HTTP_TIMEOUT=$remaining http_request GET "$endpoint" "$TMP_DIR/diagnostic-chunk.json"
        [[ $HTTP_STATUS == 200 ]] || response_error "failed to poll $kind" "$TMP_DIR/diagnostic-chunk.json"
    done
    jq --arg kind "$kind" --slurpfile lines "$TMP_DIR/diagnostic-lines.json" \
        '. + [{test:$kind,completed:true,lines:$lines[0]}]' "$TMP_DIR/diagnostics-tests.json" > "$TMP_DIR/diagnostics-tests-next.json"
    mv "$TMP_DIR/diagnostics-tests-next.json" "$TMP_DIR/diagnostics-tests.json"
}

diagnose_main() {
    local payload ping=ping
    start_router_session
    if $INTERACTIVE && [[ -z $DIAG_INTERFACE ]]; then
        VIEW_MODE=all
        fetch_interface_status
        MENU_CANCEL_MESSAGE='No interface selected.'
        pick_from_list "Source interface for router-side tests to $DIAG_HOST:" 'Interface' false 3< <(interface_menu_rows) || return 0
        [[ $SELECTED_VALUE == __default__ ]] || DIAG_INTERFACE=$SELECTED_VALUE
    fi
    if [[ -n $DIAG_INTERFACE ]]; then
        VIEW_MODE=all
        fetch_interface_status
        jq -e --arg id "$DIAG_INTERFACE" 'any(.interfaces[]; .id == $id)' "$TMP_DIR/status.json" >/dev/null \
            || fail "$EXIT_USAGE" "unknown diagnostic source interface: $DIAG_INTERFACE"
    fi
    [[ $DIAG_HOST != *:* ]] || ping=ping6
    printf '[]\n' > "$TMP_DIR/diagnostics-tests.json"
    payload=$(jq -nc --arg host "$DIAG_HOST" --arg source "$DIAG_INTERFACE" \
        '{host:$host,count:4} + (if $source == "" then {} else {source:$source} end)')
    $QUIET || printf 'Running %s from the router to %s...\n' "$ping" "$DIAG_HOST" >&2
    run_diagnostic_test "$ping" "$payload"
    payload=$(jq -nc --arg host "$DIAG_HOST" --arg source "$DIAG_INTERFACE" \
        '{host:$host,"max-ttl":12,count:1,"wait-time":1} + (if $source == "" then {} else {"source-interface":$source} end)')
    $QUIET || printf 'Running traceroute from the router...\n' >&2
    run_diagnostic_test traceroute "$payload"
    # Logs are supplementary; a missing log API must not discard diagnostic output.
    payload=$(jq -nc --argjson limit "$LOG_LIMIT" '{"max-lines":$limit,once:true}')
    http_request POST /rci/show/log "$TMP_DIR/diagnostic-logs.json" "$payload"
    if [[ $HTTP_STATUS != 200 ]] || ! jq -e '(.log | type) == "object"' "$TMP_DIR/diagnostic-logs.json" >/dev/null 2>&1; then
        warn "Diagnostic logs unavailable (HTTP $HTTP_STATUS)."
        printf 'null\n' > "$TMP_DIR/diagnostic-logs.json"
    fi
    jq --arg router "$ROUTER_URL" --arg host "$DIAG_HOST" --arg source "$DIAG_INTERFACE" \
        --slurpfile logs "$TMP_DIR/diagnostic-logs.json" '
        {router:$router,host:$host,source_interface:(if $source == "" then null else $source end),tests:.,
         logs:(if $logs[0] == null then null else [$logs[0].log[]
            | select(.message.level == "Error" or (.message.message | contains($host))
                or ($source != "" and (.message.message | contains($source))))
            | {timestamp,level:.message.level,source:.ident,message:.message.message}] end)}
    ' "$TMP_DIR/diagnostics-tests.json" > "$TMP_DIR/diagnose.json"
    # shellcheck disable=SC2016 # $screen is a jq variable.
    render_report "$TMP_DIR/diagnose.json" '
        fields("Connection diagnostics"; [["Target",.host],["Source",(.source_interface // "router default")]]),
        (.tests[] | "",.test, (.lines[] | clean | wordwrap($screen)[])),"",
        (if .logs == null then "Recent logs unavailable" else
            grid("Relevant recent logs"; ["TIME","LEVEL","SOURCE","MESSAGE"];
                [.logs[] | [.timestamp,.level,.source,.message]]) end)'
}

# Normalize only public status fields; raw RCI replies can contain credentials.
data_filter() {
    cat <<'JQ'
        def txt: if type == "string" then . else null end;
        def num: if type == "number" or type == "string" then (try tonumber catch null) else null end
            | if isinfinite or isnan then null else . end;
        def flag: if . == true or . == "yes" or . == "up" then true
                  elif . == false or . == "no" or . == "down" then false else null end;
        def entries($key):
            if type == "array" then . elif type == "object" and (.[$key] | type) == "array" then .[$key]
            elif . == {} then [] else error("unexpected list response") end
            | if all(.[]; type == "object") then . else error("invalid list entry") end;
        if any(.. | objects; .status? == "error") then error("router command error") else . end
JQ
}

normalize_data() {
    local input=$1 output=$2 filter=$3
    shift 3
    if ! jq --arg router "$ROUTER_URL" "$@" "$(data_filter) | $filter" "$input" > "$output"; then
        fail 'the router returned invalid data for this view'
    fi
}

get_view() {
    http_request GET "$1" "$2"
    [[ $HTTP_STATUS == 200 ]] || response_error "failed to retrieve $3" "$2"
}

wait_interval() {
    sleep "$1" &
    WATCH_SLEEP_PID=$!
    wait "$WATCH_SLEEP_PID"
    WATCH_SLEEP_PID=
}

fetch_routes() {
    get_view /rci/show/ip/route "$TMP_DIR/routes4.json" 'IPv4 routes'
    read_optional_json /rci/show/ipv6/route "$TMP_DIR/routes6.json" object 'IPv6 routes'
    # shellcheck disable=SC2016 # Variables in the filter belong to jq.
    normalize_data "$TMP_DIR/routes4.json" "$TMP_DIR/routes.json" '
        def route($family): {family:$family,destination:(.destination | txt),gateway:(.gateway | txt),
            interface:(.interface | txt),metric:(.metric | num),flags:(.flags | txt),protocol:(.proto | txt),
            rejecting:(.rejecting | flag),floating:(.floating | flag),static:(.static | flag)};
        if type != "array" then error("invalid IPv4 routes") else . end
        | {router:$router,ipv6_available:($v6[0] != null),routes:
            ([entries("")[] | route(4)] +
             (if $v6[0] == null then [] else [$v6[0] | entries("route6")[] | route(6)] end))}
    ' --slurpfile v6 "$TMP_DIR/routes6.json"
}

routes_main() {
    start_router_session
    fetch_routes
    render_report "$TMP_DIR/routes.json" '
        grid("Routing table"; ["DESTINATION","GATEWAY","INTERFACE","METRIC","FLAGS","PROTO"];
            [.routes[] | [.destination,.gateway,.interface,.metric,.flags,.protocol]])'
}

wan_main() {
    start_router_session
    get_view /rci/show/internet/status "$TMP_DIR/wan-health.json" 'Internet status'
    VIEW_MODE=all
    fetch_interface_status
    read_optional_json /rci/show/ip/name-server "$TMP_DIR/wan-dns.json" object 'DNS servers'
    read_optional_json /rci/show/dns-proxy "$TMP_DIR/wan-dns-proxy.json" object 'Encrypted DNS servers'
    read_optional_json /rci/show/ping-check "$TMP_DIR/wan-checks.json" object 'Connection checks'
    # shellcheck disable=SC2016 # Variables in the filter belong to jq.
    normalize_data "$TMP_DIR/wan-health.json" "$TMP_DIR/wan.json" '
        if type != "object" or (has("internet") | not) then error("invalid Internet status") else . end
        | . as $health
        | {router:$router,internet:(.internet | flag),reliable:(.reliable | flag),checked:(.checked | txt),
            gateway:(.gateway.address | txt),active_interface:(.gateway.interface | txt),
            gateway_accessible:(."gateway-accessible" | flag),dns_accessible:(."dns-accessible" | flag),
            captive_accessible:(."captive-accessible" | flag),
            connections:[$raw[0] | to_entries[] | .key as $key | .value | select(.global == true)
                | (.id // $key) as $id | {id:$id,description:(.description | txt),address:(.address | txt),
                    priority:(.priority | num),default_gateway:(.defaultgw | flag),
                    role:(if $id == $health.gateway.interface or .defaultgw == true then "active" else "alternate" end),
                    status:(first($status[0].interfaces[] | select(.id == $id) | .status) // "unknown")}],
            dns_servers:(([$dns[0].server[]? | {address:(.address | txt),transport:"plain",interface:(.interface | txt)}] +
                [$proxy[0]["proxy-status"][]? | (."proxy-tls"."server-tls"[]? |
                    {address:(.sni // .address | txt),transport:"TLS",interface:(.interface | txt)}),
                    (."proxy-https"."server-https"[]? | {address:((.uri | txt // "")
                        | try capture("^https://(?:[^/@]+@)?(?<host>\\[[^]]+\\]|[^/:?#]+)").host catch null),
                        transport:"HTTPS",interface:(.interface | txt)})]) | map(select(.address != null)) | unique),
            dns_available:($dns[0] != null or $proxy[0] != null),
            checks:(if $checks[0] == null then null else [$checks[0].pingcheck[]? | . as $check
                | .interface | to_entries[] | {profile:$check.profile,interface:.key,status:(.value.status | txt),
                    successes:(.value.successcount | num),failures:(.value.failcount | num)}] end)}
    ' --slurpfile raw "$TMP_DIR/interfaces.json" --slurpfile status "$TMP_DIR/status.json" \
        --slurpfile dns "$TMP_DIR/wan-dns.json" --slurpfile proxy "$TMP_DIR/wan-dns-proxy.json" --slurpfile checks "$TMP_DIR/wan-checks.json"
    render_report "$TMP_DIR/wan.json" '
        fields("Internet health"; [["Internet",.internet],["Reliable",.reliable],["Active interface",.active_interface],
            ["Gateway",.gateway],["Gateway reachable",.gateway_accessible],["DNS reachable",.dns_accessible],["Checked",.checked]]),"",
        grid("Internet connections"; ["INTERFACE","NAME","ROLE","STATUS","ADDRESS","PRIORITY"];
            [.connections[] | [.id,.description,.role,.status,.address,.priority]];
            "No interfaces are marked as global Internet connections."),"",
        grid("DNS servers"; ["SERVER","TRANSPORT","INTERFACE"]; [.dns_servers[] | [.address,.transport,.interface]];
            "No DNS servers were reported."),"",
        (if .checks == null then "Connection checks unavailable" else
