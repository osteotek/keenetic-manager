# Run ./keenetic-policy.sh --init to create this file interactively, or copy
# this example to ~/.config/keenetic-policy/config and chmod it 600.
# Values are literal: do not add shell quotes.
ROUTER_URL=http://192.168.1.1
ROUTER_USERNAME=admin
ROUTER_PASSWORD=replace-with-router-password
# Instead of ROUTER_PASSWORD, a command can print the password:
# ROUTER_PASSWORD_COMMAND=secret-tool lookup service keenetic-policy
# For a private HTTPS CA:
# ROUTER_CA_FILE=/home/user/.local/share/keenetic/router-ca.pem
ROUTER_INSECURE=false
